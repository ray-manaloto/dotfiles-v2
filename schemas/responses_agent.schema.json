{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles-v2.local/schemas/responses_agent.schema.json",
  "$defs": {
    "CodingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "prompt_file", "files", "dry_run", "credit_confirmed"],
      "properties": {
        "worktree": { "type": "string", "minLength": 1 },
        "prompt_file": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 240 },
          "minItems": 1,
          "maxItems": 12
        },
        "dry_run": { "type": "boolean" },
        "credit_confirmed": { "type": "boolean" }
      }
    },
    "CodingFileArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "CodingEditArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "old", "new"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "old": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "new": { "type": "string", "maxLength": 8192 }
      }
    },
    "CodingUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "input_tokens", "output_tokens"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "CodingError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "common/envelope.schema.json#/$defs/CommonErrorCode" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "CodingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "timestamp_unix_ns",
        "model",
        "endpoint",
        "dry_run",
        "max_turns",
        "max_output_tokens_per_request",
        "timeout_seconds",
        "elapsed_ms",
        "usage",
        "errors",
        "returns"
      ],
      "properties": {
        "timestamp": { "$ref": "common/envelope.schema.json#/$defs/NanosecondTimestamp" },
        "timestamp_unix_ns": { "$ref": "common/envelope.schema.json#/$defs/UnixTimestampNs" },
        "model": { "type": "string", "const": "gpt-6.2-sol" },
        "endpoint": { "type": "string", "const": "https://api.openai.com/v1/responses" },
        "dry_run": { "type": "boolean" },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_output_tokens_per_request": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "usage": {
          "anyOf": [{ "$ref": "#/$defs/CodingUsage" }, { "type": "null" }]
        },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/CodingError" } },
        "returns": {
          "type": "array",
          "items": { "$ref": "common/envelope.schema.json#/$defs/ReturnEntry" }
        }
      }
    }
  }
}
