amends "https://raw.githubusercontent.com/ray-manaloto/hk-config/v1.2.0/presets.pkl"

import "https://raw.githubusercontent.com/ray-manaloto/hk-config/v1.2.0/helpers.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

recheck_after_fix = true

// Exclude lockfiles only from formatting/content/secret/hygiene steps so integrity & gate steps still run.
local const lockfileExcludes =
  List(
    ".mise/locks/**",
    "unix/home/.config/mise/locks/**",
    "unix/home/.config/mise/mise.lock",
    "mise.lock",
    "uv.lock",
  )

// Clear git's repository-local hook variables before running scratch git fixtures/tests.
local const cleanGitEnv = #"unset $(git rev-parse --local-env-vars);"#

// Mise owns formatting for every mise config; tombi lint still validates schemas.
local const miseConfigGlobs =
  List(
    "mise.toml",
    "mise.*.toml",
    "mise/**/mise.toml",
    "mise/**/mise.*.toml",
    "unix/home/.config/mise/config.toml",
    "unix/home/.config/mise/config.*.toml",
    "unix/home/.config/mise/conf.d/**/*.toml",
  )

local const picked =
  helpers.pick(new Listing {
    "agnix"
    "betterleaks"
    "hadolint"
    "hk"
    "hygiene"
    "mise"
    "oxfmt"
    "rumdl"
    "shell"
    "tombi"
    "typos"
  })

local const betterleaksStep = picked["betterleaks"] as Step
local const hygieneGroup = picked["hygiene"] as Group
local const miseGroup = picked["mise"] as Group
local const oxfmtStep = picked["oxfmt"] as Step
local const tombiGroup = picked["tombi"] as Group
local const typosStep = picked["typos"] as Step

local const fastSteps: Mapping<String, Step | Group> = (picked) {
  ["betterleaks"] = (betterleaksStep) {
    exclude = (betterleaksStep.exclude ?? List()) + lockfileExcludes
  }
  ["hygiene"] = (hygieneGroup) {
    steps {
      for (name, step in hygieneGroup.steps) {
        [name] = (step as Step) {
          exclude = ((step as Step).exclude ?? List()) + lockfileExcludes
        }
      }
    }
  }
  ["oxfmt"] = (oxfmtStep) {
    exclude = (oxfmtStep.exclude ?? List()) + List("**/*.yml", "**/*.yaml") + lockfileExcludes
  }
  ["typos"] = (typosStep) {
    exclude = (typosStep.exclude ?? List()) + lockfileExcludes
  }
  ["mise"] = (miseGroup) {
    steps {
      ["mise-fmt"] = miseGroup.steps["mise-fmt"]
      ["mise-config-dir"] = (Builtins.mise_config_dir) {
        glob =
          List(
            "unix/home/.config/mise/config.toml",
            "unix/home/.config/mise/config.*.toml",
            "unix/home/.config/mise/conf.d/**/*.toml",
            "mise/**/mise.toml",
            "mise/**/mise.*.toml",
          )
        exclude = List()
      }
      ["mise-tasks"] = (miseGroup.steps["mise-tasks"]) {
        glob =
          List("mise.toml", "mise.*.toml", "mise/**", "tasks/**", "unix/home/.config/mise/tasks/**")
      }
    }
  }
  ["tombi"] = (tombiGroup) {
    steps {
      ["tombi"] = tombiGroup.steps["tombi"]
      ["tombi-format"] = (tombiGroup.steps["tombi-format"]) {
        exclude = ((tombiGroup.steps["tombi-format"] as Step).exclude ?? List()) + miseConfigGlobs
      }
    }
  }
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = (Builtins.ruff_format) {
    // Hook files invoked by `/usr/bin/python3` keep pre-PEP-758 `except (...)` syntax for macOS system Python.
    exclude =
      List(
        "unix/home/.gemini/config/hooks/agy-code-review-guard.py",
        "unix/home/.gemini/config/hooks/agy-hc-send-guard.py",
        "unix/home/.gemini/config/hooks/agy-interactive-questions.py",
        "unix/home/.gemini/config/hooks/agy-pwf-guard.py",
        "unix/home/.gemini/config/hooks/agy-skill-cutoff.py",
        "unix/home/.gemini/config/hooks/post-task-learn.py",
      )
  }
  ["ryl"] = (Builtins.ryl) {
    exclude = (Builtins.ryl.exclude ?? List()) + lockfileExcludes
  }
  ["ryl-format"] = (Builtins.ryl_format) {
    exclude = (Builtins.ryl_format.exclude ?? List()) + lockfileExcludes
  }
  ["uv-lock-check"] = new Step {
    glob = List("pyproject.toml", "uv.lock")
    check = "uv lock --check --offline"
  }
  ["py-deps"] = new Step {
    glob = List("pyproject.toml", "uv.lock")
    check = "mise deps uv --explain"
    fix = "mise deps uv"
  }
  ["ty"] = (Builtins.ty) {
    depends = List("py-deps")
    check = "uv run --offline --locked ty check {{ files }}"
  }
  ["codegen-check"] = new Step {
    depends = List("py-deps")
    exclusive = true
    glob =
      List(
        "schemas/**",
        "unix/home/.config/mise/lib/dotfiles_py/generated/**",
        "**/generated/**",
        "pyproject.toml",
      )
    check = "uv run --offline --locked datamodel-codegen --check"
    fix = "uv run --offline --locked datamodel-codegen"
  }
  ["schema-first-ast"] = new Step {
    glob = List("**/*.py")
    check = "python3 -I -B tasks/py/schema_first_ast.py {{ files }}"
  }
  ["schema-contract-check"] = new Step {
    glob = List("schemas/**/*.schema.json")
    check = "python3 -I -B tasks/py/schema_contract_check.py {{ files }}"
  }
  ["no-project-tools"] = new Step {
    glob =
      List(
        "mise.toml",
        "mise.*.toml",
        ".mise.toml",
        ".mise.*.toml",
        "mise/**/mise*.toml",
        ".tool-versions",
        "package.json",
        "mise.lock",
        "pyproject.toml",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py no-project-tools"
  }
  ["mise-lock-integrity"] = new Step {
    glob =
      List(
        "unix/home/.config/mise/config*.toml",
        "unix/home/.config/mise/mise.lock",
        "unix/home/.config/mise/locks/**",
      )
    check =
      #"python3 -I -B tasks/py/doctor_checks.py mise-lock-integrity && MISE_OFFLINE=1 MISE_CONFIG_DIR="$PWD/unix/home/.config/mise" mise -C unix/home/.config/mise lock --check --global"#
  }
  ["usage-lint"] = new Step {
    glob = List("tasks/**", "unix/home/.config/mise/tasks/**")
    check =
      #"rc=0; for f in {{ files }}; do if [ -f "$f" ] && grep -q '^#USAGE ' "$f"; then usage lint -W -q "$f" || rc=1; fi; done; exit $rc"#
  }
  ["jouet-rules"] = new Step {
    glob =
      List(
        "unix/home/.config/jouet/rules/**/*.toml",
        "unix/home/.config/jouet/rules/**/*.luau",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py jouet-rules"
  }
  ["pitchfork-config"] = new Step {
    glob = List("pitchfork.toml", "unix/home/.config/pitchfork/config.toml")
    check = "python3 -I -B tasks/py/doctor_checks.py pitchfork-config"
  }
  ["dockerignore-secret-guard"] = new Step {
    glob = List(".dockerignore", "docker/**")
    check = "python3 -I -B tasks/py/doctor_checks.py dockerignore-secret-guard"
  }
  ["mise-version-parity"] = new Step {
    glob =
      List(
        "mise.toml",
        "unix/home/.config/mise/config.toml",
        "docker/ubuntu/Dockerfile",
        "tasks/vm/up",
        "tasks/env/doctor",
        "AGENTS.md",
        "unix/home/.agents/skills/mise-bootstrap-ops/SKILL.md",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py mise-version-parity"
  }
  ["config-hygiene"] = new Step {
    glob =
      List(
        "unix/home/.config/mise/config*.toml",
        "unix/home/.config/herdr-app/programs.json",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py config-hygiene"
  }
  ["private-paths"] = new Step {
    check = "mise run privacy:scan -- {{ files }}"
  }
  ["no-core-worktree"] = new Step {
    check =
      #"test -z "$(git config --file "$(git rev-parse --git-common-dir)/config" --get-all core.worktree)" || { echo 'core.worktree is set in shared .git/config' >&2; exit 1; }"#
  }
}

local const pytestStep: Step = new Step {
  depends = List("py-deps")
  glob = List("**/*.py", "pyproject.toml", "uv.lock", "schemas/**")
  check = "\(cleanGitEnv) uv run --offline --locked pytest -n auto"
}

local const checkSteps: Mapping<String, Step | Group> = (fastSteps) {
  ["pytest"] = pytestStep
}

steps = fastSteps

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fastSteps
  }
  ["commit-msg"] {
    steps {
      ["typos-msg"] {
        check = "typos {{ commit_msg_file }}"
      }
    }
  }
  ["post-commit"] {
    steps {
      ["host-sync-advisory"] {
        check = "python3 -I -B tasks/py/doctor_checks.py post-commit-advisory"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["private-paths-outgoing"] {
        exclusive = true
        check = "mise run privacy:scan --outgoing"
      }
      ["betterleaks-commits"] = (Builtins.betterleaks) {
        scan = "commits"
      }
      ["no-core-worktree"] = (fastSteps["no-core-worktree"] as Step) {
        exclusive = true
      }
      ["uv-lock-check"] = fastSteps["uv-lock-check"]
      ["py-deps"] = fastSteps["py-deps"]
      ["codegen-check"] = fastSteps["codegen-check"]
      ["schema-first-ast"] = fastSteps["schema-first-ast"]
      ["schema-contract-check"] = fastSteps["schema-contract-check"]
      ["pytest"] = pytestStep
    }
  }
  ["post-merge"] {
    steps {
      ["host-option-a"] {
        check = "python3 -I -B tasks/py/doctor_checks.py host-option-a --strict-host"
      }
    }
  }
  ["check"] {
    steps = checkSteps
  }
  ["fix"] {
    fix = true
    steps = fastSteps
  }
}
