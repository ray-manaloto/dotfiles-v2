// hk-config v1.2.0 — pinned to the immutable commit SHA (tags are movable); bump SHA + version together.
amends
  "https://raw.githubusercontent.com/ray-manaloto/hk-config/be984a17e01d35b1984f07238c1b299a03032e4a/presets.pkl"

import
  "https://raw.githubusercontent.com/ray-manaloto/hk-config/be984a17e01d35b1984f07238c1b299a03032e4a/helpers.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

recheck_after_fix = true

// Read-only git commands in steps (e.g. the destroyed-symlinks builtin's `git status`) take an
// optional index.lock to refresh the index. With fail_fast, hk kills in-flight steps when one
// fails, and a killed `git status` leaves a 0-byte index.lock that blocks every later commit.
// GIT_OPTIONAL_LOCKS=0 makes those commands skip the optional lock; required writes still lock.
env { ["GIT_OPTIONAL_LOCKS"] = "0" }

// Exclude lockfiles only from formatting/content/secret/hygiene steps so integrity & gate steps still run.
local const lockfileExcludes =
  List(
    ".mise/locks/**",
    "unix/home/.config/mise/locks/**",
    "unix/home/.config/mise/mise.lock",
    "unix/home/.config/mise/mise.*.lock",
    "mise.lock",
    "uv.lock",
  )

// Clear git's repository-local hook variables before running scratch git fixtures/tests.
local const cleanGitEnv = #"unset $(git rev-parse --local-env-vars);"#

// Mise owns formatting for every mise config; tombi lint still validates schemas.
local const miseConfigGlobs =
  List(
    "mise.toml",
    "mise.*.toml",
    "mise/**/mise.toml",
    "mise/**/mise.*.toml",
    "unix/home/.config/mise/config.toml",
    "unix/home/.config/mise/config.*.toml",
    "unix/home/.config/mise/conf.d/**/*.toml",
  )

local const picked =
  helpers.pick(new Listing {
    "agnix"
    "betterleaks"
    "jactionlint"
    "hadolint"
    "hk"
    "hygiene"
    "mise"
    "oxfmt"
    "rumdl"
    "shell"
    "tombi"
    "typos"
  })

local const betterleaksStep = picked["betterleaks"] as Step
local const githubActionsGroup = helpers.lintSteps()["github-actions"] as Group
local const hygieneGroup = picked["hygiene"] as Group
local const miseGroup = picked["mise"] as Group
local const oxfmtStep = picked["oxfmt"] as Step
local const tombiGroup = picked["tombi"] as Group
local const typosStep = picked["typos"] as Step

local const fastSteps: Mapping<String, Step | Group> = (picked) {
  ["betterleaks"] = (betterleaksStep) {
    exclude = (betterleaksStep.exclude ?? List()) + lockfileExcludes
    env {
      ["BETTERLEAKS_CONFIG"] = ".betterleaks.toml"
    }
  }
  ["zizmor"] = (githubActionsGroup.steps["zizmor"] as Step) {
    depends = List()
  }
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    exclude = lockfileExcludes
  }
  ["lychee"] = (Builtins.lychee) {
    glob = List("**/*.md", "**/*.markdown")
    exclude = lockfileExcludes
    check = "lychee --no-progress --offline {{ files }}"
  }
  ["hygiene"] = (hygieneGroup) {
    steps {
      for (name, step in hygieneGroup.steps) {
        [name] = (step as Step) {
          // apple-bin/* link to macOS-only /usr/bin tools; they are dangling on Linux CI by design.
          exclude =
            ((step as Step).exclude ?? List())
              + lockfileExcludes
              + (
                if (name == "check-symlinks")
                  List("unix/home/.config/mise/apple-bin/**")
                else
                  List()
              )
        }
      }
    }
  }
  ["oxfmt"] = (oxfmtStep) {
    exclude = (oxfmtStep.exclude ?? List()) + List("**/*.yml", "**/*.yaml") + lockfileExcludes
  }
  ["typos"] = (typosStep) {
    exclude = (typosStep.exclude ?? List()) + lockfileExcludes
  }
  ["mise"] = (miseGroup) {
    steps {
      ["mise-fmt"] = miseGroup.steps["mise-fmt"]
      ["mise-config-dir"] = (Builtins.mise_config_dir) {
        glob =
          List(
            "unix/home/.config/mise/config.toml",
            "unix/home/.config/mise/config.*.toml",
            "unix/home/.config/mise/conf.d/**/*.toml",
            "mise/**/mise.toml",
            "mise/**/mise.*.toml",
          )
        exclude = List()
      }
      ["mise-tasks"] = (miseGroup.steps["mise-tasks"]) {
        glob =
          List("mise.toml", "mise.*.toml", "mise/**", "tasks/**", "unix/home/.config/mise/tasks/**")
      }
    }
  }
  ["tombi"] = (tombiGroup) {
    steps {
      ["tombi"] = tombiGroup.steps["tombi"]
      ["tombi-format"] = (tombiGroup.steps["tombi-format"]) {
        exclude = ((tombiGroup.steps["tombi-format"] as Step).exclude ?? List()) + miseConfigGlobs
      }
    }
  }
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = Builtins.ruff_format
  ["ryl"] = (Builtins.ryl) {
    exclude = (Builtins.ryl.exclude ?? List()) + lockfileExcludes
  }
  ["ryl-format"] = (Builtins.ryl_format) {
    exclude = (Builtins.ryl_format.exclude ?? List()) + lockfileExcludes
  }
  ["uv-lock-check"] = new Step {
    glob = List("pyproject.toml", "uv.lock")
    check = "uv lock --check --offline"
  }
  ["py-deps"] = new Step {
    glob = List("pyproject.toml", "uv.lock")
    check = "mise deps uv --explain"
    fix = "mise deps uv"
  }
  ["ty"] = (Builtins.ty) {
    depends = List("py-deps")
    check = "uv run --offline --locked ty check {{ files }}"
  }
  ["codegen-check"] = new Step {
    depends = List("py-deps")
    exclusive = true
    glob =
      List(
        "schemas/**",
        "unix/home/.config/mise/lib/dotfiles_py/generated/**",
        "**/generated/**",
        "pyproject.toml",
      )
    check = "uv run --offline --locked datamodel-codegen --check"
    fix = "uv run --offline --locked datamodel-codegen"
  }
  // The PR-review workflows' offline tests sit outside pytest testpaths; run them here so PR CI covers them.
  ["openai-review-tests"] = new Step {
    glob = List(".github/openai-review/**")
    check = "python3 -I -B -m unittest discover -s .github/openai-review -p 'test_*.py'"
  }
  ["schema-first-ast"] = new Step {
    glob = List("**/*.py")
    check = "python3 -I -B tasks/py/schema_first_ast.py {{ files }}"
  }
  ["schema-contract-check"] = new Step {
    glob = List("schemas/**/*.schema.json")
    check = "python3 -I -B tasks/py/schema_contract_check.py {{ files }}"
  }
  ["no-project-tools"] = new Step {
    glob =
      List(
        "mise.toml",
        "mise.*.toml",
        ".mise.toml",
        ".mise.*.toml",
        "mise/**/mise*.toml",
        ".tool-versions",
        "package.json",
        "mise.lock",
        "pyproject.toml",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py no-project-tools"
  }
  ["mise-lock-integrity"] = new Step {
    glob =
      List(
        "unix/home/.config/mise/config*.toml",
        "unix/home/.config/mise/mise.lock",
        "unix/home/.config/mise/mise.*.lock",
        "unix/home/.config/mise/locks/**",
      )
    check =
      #"python3 -I -B tasks/py/doctor_checks.py mise-lock-integrity && { out="$(MISE_OFFLINE=1 MISE_CONFIG_DIR="$PWD/unix/home/.config/mise" mise -C unix/home/.config/mise lock --check --global 2>&1)" && printf '%s\n' "$out" | head -1 || { printf '%s\n' "$out"; exit 1; }; }"#
  }
  ["usage-lint"] = new Step {
    glob = List("tasks/**", "unix/home/.config/mise/tasks/**")
    check =
      #"rc=0; for f in {{ files }}; do if [ -f "$f" ] && grep -q '^#USAGE ' "$f"; then usage lint -W -q "$f" || rc=1; fi; done; exit $rc"#
  }
  ["jouet-rules"] = new Step {
    glob =
      List(
        "unix/home/.config/jouet/rules/**/*.toml",
        "unix/home/.config/jouet/rules/**/*.luau",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py jouet-rules"
  }
  ["pitchfork-config"] = new Step {
    glob = List("pitchfork.toml", "unix/home/.config/pitchfork/config.toml")
    check = "python3 -I -B tasks/py/doctor_checks.py pitchfork-config"
  }
  ["dockerignore-secret-guard"] = new Step {
    glob = List(".dockerignore", "docker/**")
    check = "python3 -I -B tasks/py/doctor_checks.py dockerignore-secret-guard"
  }
  ["mise-version-parity"] = new Step {
    glob =
      List(
        "mise.toml",
        "unix/home/.config/mise/config.toml",
        "docker/ubuntu/Dockerfile",
        "tasks/vm/up",
        "tasks/env/doctor",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py mise-version-parity"
  }
  ["config-hygiene"] = new Step {
    glob =
      List(
        "unix/home/.config/mise/config*.toml",
        "unix/home/.config/herdr-app/programs.json",
        "unix/home/.config/fnox/*.toml",
        "unix/home/.gemini/config/hooks.json",
      )
    check = "python3 -I -B tasks/py/doctor_checks.py config-hygiene"
  }
  ["dcg-packs"] = new Step {
    glob = List("unix/home/.config/dcg/config.toml", "unix/home/.config/dcg/packs/*.yaml")
    check =
      #"rc=0; tombi lint --error-on-warnings unix/home/.config/dcg/config.toml || rc=1; if command -v dcg >/dev/null 2>&1; then for f in unix/home/.config/dcg/packs/*.yaml; do [ -f "$f" ] && { dcg pack validate "$f" || rc=1; }; done; elif [ -n "${CI:-}" ]; then echo 'dcg binary missing in CI' >&2; rc=1; fi; exit $rc"#
  }
  ["no-installs-clobber"] = new Step {
    glob = List("tasks/**", "unix/home/.config/mise/tasks/**", "docker/**")
    exclude =
      List(
        "unix/home/.config/mise/tasks/host/harden-bins",
        "unix/home/.config/mise/tasks/host/prune",
      )
    check =
      #"if rg -n --pcre2 '(?:^|[;&|(\s])(?:(?:ln|cp|mv|install|tee|rm|chmod|chown|tar|unzip|rsync|curl[^\n]*\s-[^\n]*o)\b|>>?)[^\n]*(?:\.local/share/mise/installs|/opt/mise/installs)' {{ files }}; then echo 'Direct writes/clobbering under mise installs/ are forbidden' >&2; exit 1; fi"#
  }
  ["reviewer-plugins-declared"] = new Step {
    glob =
      List(
        "unix/home/.config/mise/assets/reviewer-plugins.json",
        "unix/home/.config/mise/lib/reviewer_plugins.py",
        "unix/home/.config/mise/tasks/bootstrap/reviewer-plugins",
        "unix/home/.config/mise/tasks/repowise/*",
        "unix/home/.config/mise/tasks/host/prune-codex-otel",
        "unix/home/.config/opencode/opencode.json",
        "tasks/py/doctor_checks.py",
      )
    check = "DOTFILES_DOCTOR_SCOPE=repo python3 -I -B tasks/py/doctor_checks.py reviewer-plugins"
  }
  ["mcp-policy"] = new Step {
    glob =
      List(
        "schemas/mcp-policy.schema.json",
        "tasks/py/doctor_checks.py",
        "unix/home/.claude.json",
        "unix/home/.claude/**/*.json",
        "unix/home/.config/mise/assets/claude/**",
        "unix/home/.config/mise/assets/codex/mcp-fnox-policy.toml",
        "unix/home/.config/mise/assets/codex/team-defaults.toml",
        "unix/home/.config/mise/assets/mcp-policy.json",
        "unix/home/.config/mise/assets/reviewer-plugins.json",
        "unix/home/.config/opencode/opencode.json",
        "unix/home/.gemini/config/mcp_config.json",
      )
    check = "DOTFILES_DOCTOR_SCOPE=repo python3 -I -B tasks/py/doctor_checks.py mcp-policy"
  }
  ["private-paths"] = new Step {
    check = "mise run privacy:scan -- {{ files }}"
  }
  ["no-core-worktree"] = new Step {
    check =
      #"test -z "$(git config --file "$(git rev-parse --git-common-dir)/config" --get-all core.worktree)" || { echo 'core.worktree is set in shared .git/config' >&2; exit 1; }"#
  }
}

local const pytestStep: Step = new Step {
  depends = List("py-deps")
  glob = List("**/*.py", "pyproject.toml", "uv.lock", "schemas/**")
  check = "\(cleanGitEnv) uv run --offline --locked pytest -n auto"
}

local const checkSteps: Mapping<String, Step | Group> = (fastSteps) {
  ["pytest"] = pytestStep
}

steps = fastSteps

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fastSteps
  }
  ["commit-msg"] {
    steps {
      ["typos-msg"] {
        check = "typos {{ commit_msg_file }}"
      }
    }
  }
  ["post-commit"] {
    steps {
      ["host-sync-advisory"] {
        check = "python3 -I -B tasks/py/doctor_checks.py post-commit-advisory"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["private-paths-outgoing"] {
        exclusive = true
        check = "mise run privacy:scan --outgoing"
      }
      ["betterleaks-commits"] = (Builtins.betterleaks) {
        scan = "commits"
        // hk passes a step one from_ref/to_ref per push, so `git push origin a b` (or a delete plus
        // an update) scanned only one ref. push_leak_scan.py reads every line git gives the hook
        // and scans all pushed commits the target remote lacks. A structured Command passes the
        // hook input as single arguments (no shell); `effect = "read"` keeps it under `hk --safe`.
        check = new CommandSpec {
          command = new Command {
            argv =
              List(
                "python3",
                "-I",
                "-B",
                "tasks/py/push_leak_scan.py",
                "{{hook_stdin}}",
                "{{hook_args}}",
              )
          }
          effect = "read"
        }
        env {
          ["BETTERLEAKS_CONFIG"] = ".betterleaks.toml"
        }
      }
      ["no-core-worktree"] = (fastSteps["no-core-worktree"] as Step) {
        exclusive = true
      }
      ["uv-lock-check"] = fastSteps["uv-lock-check"]
      ["py-deps"] = fastSteps["py-deps"]
      ["ruff"] = fastSteps["ruff"]
      ["ty"] = fastSteps["ty"]
      ["agnix"] = fastSteps["agnix"]
      ["mise-lock-integrity"] = fastSteps["mise-lock-integrity"]
      ["config-hygiene"] = fastSteps["config-hygiene"]
      ["dcg-packs"] = fastSteps["dcg-packs"]
      ["no-installs-clobber"] = fastSteps["no-installs-clobber"]
      ["reviewer-plugins-declared"] = fastSteps["reviewer-plugins-declared"]
      ["mcp-policy"] = fastSteps["mcp-policy"]
      ["codegen-check"] = fastSteps["codegen-check"]
      ["schema-first-ast"] = fastSteps["schema-first-ast"]
      ["schema-contract-check"] = fastSteps["schema-contract-check"]
      ["pytest"] = pytestStep
    }
  }
  ["post-merge"] {
    steps {
      ["host-option-a"] {
        check = "python3 -I -B tasks/py/doctor_checks.py host-option-a --strict-host"
      }
      // Live: reviewer plugins installed across harnesses, Claude plugin MCPs Connected, Repowise rewrite guarded.
      ["reviewer-plugins"] {
        check = "python3 -I -B tasks/py/doctor_checks.py reviewer-plugins"
      }
      // Live: Codex marketplaces stay allowlisted (no Claude imports) and managed hooks (dcg) stay trusted.
      ["codex-marketplaces"] {
        check = "python3 -I -B tasks/py/doctor_checks.py codex-marketplaces"
      }
      ["codex-hook-trust"] {
        check = "python3 -I -B tasks/py/doctor_checks.py codex-hook-trust"
      }
    }
  }
  ["check"] {
    steps = checkSteps
  }
  ["fix"] {
    fix = true
    steps = fastSteps
  }
}
