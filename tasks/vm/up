#!/usr/bin/env bash
#MISE description="Provision, bootstrap, and verify dotfiles-v2-macos Tart VM via packslip, mise bootstrap, and non-root LaunchAgent Tailscale SSH"
#MISE secrets=["TAILSCALE_API_KEY"]
#USAGE flag "--ref <ref>" help="Git branch or ref to check out in VM (default: current branch)"
set -euo pipefail

VM_NAME="dotfiles-v2-macos"
TS_HOSTNAME="dotfiles-v2-vm"
BASE_IMAGE="ghcr.io/cirruslabs/macos-golden-gate-xcode@sha256:d7641b1d985fd53fbac071c663bf249007b9b387e16b7d576144588acb1d93f9"
MISE_VER="2026.11.14"
PACKSLIP_VER="v1.11.5"
PACKSLIP_SHA256_MACOS_ARM64="9654417414246dba0a7c394b0cf98dae95979df43f169c27bbce5976e8604aa5"
PACKSLIP_MISE_PIN="ps1_nlhmwtfeufglxv5myvwvronk7a"
REPO_URL="https://github.com/ray-manaloto/dotfiles-v2.git"
SLUG_REPO="ray-manaloto/dotfiles-v2"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

mint_tailscale_authkey() {
	local desc="$1" payload resp key
	if [[ -z ${TAILSCALE_API_KEY:-} ]]; then
		echo "TAILSCALE_API_KEY is unset; run via 'mise run vm:up' so [secrets.fnox] profile=infra injects it" >&2
		return 1
	fi
	payload="$(jq -cn --arg desc "${desc}" '{
		capabilities: {
			devices: {
				create: {
					reusable: false,
					ephemeral: true,
					preauthorized: true,
					tags: ["tag:dev-env"]
				}
			}
		},
		expirySeconds: 300,
		description: $desc
	}')"
	resp="$(printf '%s' "${payload}" | curl -fsS -m 15 -X POST \
		-K <(printf 'header = "Authorization: Bearer %s"\n' "${TAILSCALE_API_KEY}") \
		-H "Content-Type: application/json" \
		-d @- \
		https://api.tailscale.com/api/v2/tailnet/-/keys)"
	key="$(printf '%s' "${resp}" | jq -er '.key')"
	if [[ -z ${key} ]]; then
		echo "failed to mint Tailscale auth key for ${desc}" >&2
		return 1
	fi
	printf '%s' "${key}"
}

if [[ "$(uname -s)" != "Darwin" ]] || ! command -v tart >/dev/null 2>&1; then
	echo "tasks/vm/up requires macOS with tart on PATH" >&2
	exit 1
fi

secrets_running="$(env -u DOCKER_HOST docker --context desktop-linux container inspect --format '{{.State.Running}}' agent-secrets 2>/dev/null || echo false)"
if [[ ${secrets_running} != "true" ]]; then
	echo "agent-secrets container is not running on desktop-linux; start it before vm:up" >&2
	exit 1
fi
keys="$(env -u DOCKER_HOST docker --context desktop-linux exec agent-secrets agent-secrets register "${VM_NAME}" "${SLUG_REPO}")"
if [[ ! -s "${keys}/claude-oauth-token" ]]; then
	echo "missing non-empty claude-oauth-token at ${keys}" >&2
	exit 1
fi

ref="$(resolve_ref)"

if ! tart list --quiet | grep -Fxq "${VM_NAME}"; then
	echo "Cloning ${BASE_IMAGE} -> ${VM_NAME}"
	tart clone "${BASE_IMAGE}" "${VM_NAME}"
	tart set "${VM_NAME}" --cpu 4 --memory 8192
fi

if tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	if ! tart exec "${VM_NAME}" test -s "/Volumes/My Shared Files/agent-secrets/claude-oauth-token" >/dev/null 2>&1; then
		echo "Restarting ${VM_NAME} headless with read-only agent-secrets VirtioFS share"
		tart stop "${VM_NAME}"
		stopped=0
		for _ in $(seq 1 15); do
			if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
				stopped=1
				break
			fi
			sleep 2
		done
		if [[ ${stopped} -ne 1 ]]; then
			echo "timed out waiting 30s for ${VM_NAME} to stop" >&2
			exit 1
		fi
	fi
fi

if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	echo "Starting ${VM_NAME} headless"
	nohup tart run --no-graphics --dir="agent-secrets:${keys}:ro" "${VM_NAME}" >/tmp/dotfiles-v2-tart.log 2>&1 </dev/null &
	ready=0
	for _ in $(seq 1 40); do
		if tart exec "${VM_NAME}" true >/dev/null 2>&1; then
			ready=1
			break
		fi
		sleep 3
	done
	if [[ ${ready} -ne 1 ]]; then
		echo "timed out waiting 120s for tart exec ${VM_NAME}; see /tmp/dotfiles-v2-tart.log" >&2
		exit 1
	fi
fi

# Remove any pre-installed Homebrew mise and install pinned mise v2026.11.14 via packslip v1.11.5.
tart exec -i "${VM_NAME}" env \
	MISE_VER="${MISE_VER}" \
	PACKSLIP_VER="${PACKSLIP_VER}" \
	PACKSLIP_SHA="${PACKSLIP_SHA256_MACOS_ARM64}" \
	PACKSLIP_PIN="${PACKSLIP_MISE_PIN}" \
	/bin/bash -euo pipefail <<'GUEST'
if [[ -x /opt/homebrew/bin/brew ]] && /opt/homebrew/bin/brew list --versions mise >/dev/null 2>&1; then
  /opt/homebrew/bin/brew uninstall --force mise
fi
if [[ -e /opt/homebrew/bin/mise ]]; then
  echo "unexpected /opt/homebrew/bin/mise still present after brew uninstall" >&2
  exit 1
fi
have=""
if [[ -x /usr/local/bin/mise ]]; then
  have="$(/usr/local/bin/mise --version | awk '{print $1}')"
fi
if [[ "${have}" != "${MISE_VER}" ]]; then
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' EXIT
  curl -fsSLo "${tmp_dir}/packslip" "https://github.com/jdx/packslip/releases/download/${PACKSLIP_VER}/packslip-${PACKSLIP_VER}-darwin-arm64"
  printf '%s  %s/packslip\n' "${PACKSLIP_SHA}" "${tmp_dir}" | shasum -a 256 -c -
  chmod 0755 "${tmp_dir}/packslip"
  sudo install -d -o root -g wheel -m 0755 /usr/local/bin
  sudo chown root:wheel /usr/local /usr/local/bin
  sudo chmod 0755 /usr/local /usr/local/bin
  sudo "${tmp_dir}/packslip" install github.com/jdx/mise \
    --version "${MISE_VER}" \
    --pin "${PACKSLIP_PIN}" \
    --system \
    --bin-dir /usr/local/bin \
    --force
fi
GUEST

tart exec -i "${VM_NAME}" env REPO_URL="${REPO_URL}" REF="${ref}" /bin/bash -euo pipefail <<'GUEST'
mkdir -p "${HOME}/dev"
if [[ -d "${HOME}/dev/dotfiles-v2/.git" ]]; then
  git -C "${HOME}/dev/dotfiles-v2" fetch -q origin "${REF}"
  git -C "${HOME}/dev/dotfiles-v2" checkout -q -B "${REF}" "origin/${REF}"
else
  git clone -q -b "${REF}" "${REPO_URL}" "${HOME}/dev/dotfiles-v2"
fi
GUEST

# Retire legacy root tailscale LaunchDaemon + legacy RC blocks, then run one declarative Option A mise bootstrap.
tart exec -i "${VM_NAME}" env REPO_URL="${REPO_URL}" /bin/bash -euo pipefail <<'GUEST'
if [[ -e /Library/LaunchDaemons/sh.brew.tailscale.plist ]]; then
  sudo /opt/homebrew/bin/brew services stop tailscale >/dev/null 2>&1 || true
  sudo launchctl bootout system/sh.brew.tailscale >/dev/null 2>&1 || true
  sudo rm -f /Library/LaunchDaemons/sh.brew.tailscale.plist
fi
for rc in "${HOME}/.zprofile" "${HOME}/.zshrc" "${HOME}/.bash_profile" "${HOME}/.bashrc"; do
  if [[ -f "${rc}" ]]; then
    awk '/^# >>> dotfiles-v2 >>>$/{skip=1;next} /^# <<< dotfiles-v2 <<<$/{skip=0;next} !skip' "${rc}" >"${rc}.tmp"
    mv "${rc}.tmp" "${rc}"
  fi
done
for rc in "${HOME}/.zprofile" "${HOME}/.bash_profile"; do
  if [[ -f "${rc}" ]]; then
    grep -Fxv '[ -r "${HOME}/.config/dotfiles-v2/vm-env.sh" ] && . "${HOME}/.config/dotfiles-v2/vm-env.sh"' "${rc}" >"${rc}.tmp" || true
    mv "${rc}.tmp" "${rc}"
  fi
done
if [[ -e "${HOME}/.config/mise" && ! -L "${HOME}/.config/mise" ]]; then
  rm -rf "${HOME}/.config/mise"
fi
touch "${HOME}/.zshenv" "${HOME}/.zprofile" "${HOME}/.zshrc" "${HOME}/.bash_profile" "${HOME}/.bashrc"
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.opencode/bin:${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
export MISE_TRUSTED_CONFIG_PATHS="${HOME}/dev/dotfiles-v2:${HOME}/.config/mise"
export MISE_LOCKED=1
export MISE_YES=1
/usr/local/bin/mise -E macos,vm bootstrap \
  --from "${REPO_URL}" \
  --from-dir "${HOME}/dev/dotfiles-v2" \
  --config-dir unix/home/.config/mise \
  --force-dotfiles --yes
/usr/local/bin/mise -E macos,vm -C "${HOME}" run host:prune --apply
/usr/local/bin/mise -E macos,vm -C "${HOME}" run host:prune-mcps --apply
if [[ -x /opt/homebrew/bin/brew ]] && /opt/homebrew/bin/brew list --cask codex >/dev/null 2>&1; then
  codex_raw="$(codex --version </dev/null 2>/dev/null || true)"
  if python3 -c 'import re, sys; m = re.search(r"(\d+)\.(\d+)\.(\d+)", sys.argv[1]); sys.exit(0 if m and tuple(map(int, m.groups())) < (0, 171, 0) else 1)' "${codex_raw}"; then
    /opt/homebrew/bin/brew upgrade --cask codex </dev/null
  fi
fi
/usr/local/bin/mise -C "${HOME}/dev/dotfiles-v2" deps uv
GUEST

# Wait for non-root launchd tailscaled socket (no sudo, no --operator needed).
tart exec -i "${VM_NAME}" /bin/bash -euo pipefail <<'GUEST'
sock="${HOME}/.local/state/tailscale/tailscaled.sock"
ready=0
for _ in $(seq 1 20); do
  if /opt/homebrew/bin/tailscale --socket="${sock}" status --json >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
if [[ ${ready} -ne 1 ]]; then
  echo "non-root tailscaled did not become ready in VM; check ~/Library/Logs/tailscaled*.log" >&2
  exit 1
fi
GUEST

ts_exec() {
	# shellcheck disable=SC2016
	tart exec "${VM_NAME}" /bin/bash -euo pipefail -c '
		sock="${HOME}/.local/state/tailscale/tailscaled.sock"
		/opt/homebrew/bin/tailscale --socket="${sock}" "$@"
	' bash "$@"
}

status_json="$(ts_exec status --json 2>/dev/null || true)"
ts_state="$(printf '%s' "${status_json}" | jq -r '.BackendState // empty' 2>/dev/null || true)"
if [[ ${ts_state} == "Running" ]]; then
	cur_hostname="$(printf '%s' "${status_json}" | jq -r '.Self.HostName // empty')"
	run_ssh="$(ts_exec debug prefs 2>/dev/null | jq -r '.RunSSH // false' 2>/dev/null || echo false)"
	if [[ ${cur_hostname} != "${TS_HOSTNAME}" || ${run_ssh} != "true" ]]; then
		ts_exec set --ssh --hostname="${TS_HOSTNAME}" --accept-dns=false
	fi
else
	key="$(mint_tailscale_authkey "${TS_HOSTNAME}")"
	# shellcheck disable=SC2016
	printf '%s' "${key}" | tart exec -i "${VM_NAME}" env TS_HOSTNAME="${TS_HOSTNAME}" /bin/bash -euo pipefail -c '
		sock="${HOME}/.local/state/tailscale/tailscaled.sock"
		keyfile="$(mktemp)"
		trap "rm -f \"\${keyfile}\"" EXIT
		chmod 0600 "${keyfile}"
		cat >"${keyfile}"
		/opt/homebrew/bin/tailscale --socket="${sock}" up --auth-key="file:${keyfile}" --ssh --hostname="${TS_HOSTNAME}" --accept-dns=false --timeout=30s
	'
	unset key
fi

status_json="$(ts_exec status --json)"
ts_state="$(printf '%s' "${status_json}" | jq -r '.BackendState // empty')"
cur_hostname="$(printf '%s' "${status_json}" | jq -r '.Self.HostName // empty')"
if [[ ${ts_state} != "Running" || ${cur_hostname} != "${TS_HOSTNAME}" ]]; then
	echo "unexpected Tailscale state in ${VM_NAME}: BackendState=${ts_state} HostName=${cur_hostname}" >&2
	exit 1
fi
if ! printf '%s' "${status_json}" | jq -e '(.Self.Tags // []) | index("tag:dev-env") != null' >/dev/null; then
	echo "Tailscale node ${cur_hostname} missing tag:dev-env" >&2
	exit 1
fi

echo "VM ready: ${VM_NAME} (tailscale=${TS_HOSTNAME})"
