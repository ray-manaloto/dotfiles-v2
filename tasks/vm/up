#!/usr/bin/env bash
#MISE description="Provision, start, and prepare the dotfiles-v2-macos Tart VM with pinned mise, Claude Code, OpenCode, agent-secrets, and Tailscale SSH"
#USAGE flag "--ref <ref>" help="Git branch or ref to check out in VM (default: current branch)"
set -euo pipefail

VM_NAME="dotfiles-v2-macos"
TS_HOSTNAME="dotfiles-v2-vm"
BASE_IMAGE="ghcr.io/cirruslabs/macos-golden-gate-xcode@sha256:d7641b1d985fd53fbac071c663bf249007b9b387e16b7d576144588acb1d93f9"
MISE_VER="2026.11.12"
MISE_SHA256_MACOS_ARM64="f7bd19aa4e6b7a58d7296f98e2c6af68b2e2643dfd608b0bc46c2b5fdbc8749b"
REPO_URL="https://github.com/ray-manaloto/dotfiles-v2.git"
SLUG_REPO="ray-manaloto/dotfiles-v2"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

mint_tailscale_authkey() {
	local desc="$1" payload curl_cmd resp key
	payload="$(jq -cn --arg desc "${desc}" '{
		capabilities: {
			devices: {
				create: {
					reusable: false,
					ephemeral: true,
					preauthorized: true,
					tags: ["tag:dev-env"]
				}
			}
		},
		expirySeconds: 300,
		description: $desc
	}')"
	# shellcheck disable=SC2016
	curl_cmd='curl -fsS -m 15 -X POST -H "Authorization: Bearer ${TAILSCALE_API_KEY}" -H "Content-Type: application/json" -d @- https://api.tailscale.com/api/v2/tailnet/-/keys'
	if [[ -n ${TAILSCALE_API_KEY:-} && -n ${HTTPS_PROXY:-} ]]; then
		resp="$(printf '%s' "${payload}" | /bin/bash -c "${curl_cmd}")"
	else
		resp="$(printf '%s' "${payload}" | fnox --non-interactive --config "${HOME}/.config/fnox/config.toml" proxy run -- /bin/bash -c "${curl_cmd}")"
	fi
	key="$(printf '%s' "${resp}" | jq -er '.key')"
	if [[ -z ${key} ]]; then
		echo "failed to mint Tailscale auth key for ${desc}" >&2
		return 1
	fi
	printf '%s' "${key}"
}

if [[ "$(uname -s)" != "Darwin" ]] || ! command -v tart >/dev/null 2>&1; then
	echo "tasks/vm/up requires macOS with tart on PATH" >&2
	exit 1
fi

secrets_running="$(env -u DOCKER_HOST docker --context desktop-linux container inspect --format '{{.State.Running}}' agent-secrets 2>/dev/null || echo false)"
if [[ ${secrets_running} != "true" ]]; then
	echo "agent-secrets container is not running on desktop-linux; start it before vm:up" >&2
	exit 1
fi
keys="$(env -u DOCKER_HOST docker --context desktop-linux exec agent-secrets agent-secrets register "${VM_NAME}" "${SLUG_REPO}")"
if [[ ! -s "${keys}/claude-oauth-token" ]]; then
	echo "missing non-empty claude-oauth-token at ${keys}" >&2
	exit 1
fi

ref="$(resolve_ref)"

if ! tart list --quiet | grep -Fxq "${VM_NAME}"; then
	echo "Cloning ${BASE_IMAGE} -> ${VM_NAME}"
	tart clone "${BASE_IMAGE}" "${VM_NAME}"
	tart set "${VM_NAME}" --cpu 4 --memory 8192
fi

if tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	if ! tart exec "${VM_NAME}" test -s "/Volumes/My Shared Files/agent-secrets/claude-oauth-token" >/dev/null 2>&1; then
		echo "Restarting ${VM_NAME} headless with read-only agent-secrets VirtioFS share"
		tart stop "${VM_NAME}"
		stopped=0
		for _ in $(seq 1 15); do
			if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
				stopped=1
				break
			fi
			sleep 2
		done
		if [[ ${stopped} -ne 1 ]]; then
			echo "timed out waiting 30s for ${VM_NAME} to stop" >&2
			exit 1
		fi
	fi
fi

if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	echo "Starting ${VM_NAME} headless"
	nohup tart run --no-graphics --dir="agent-secrets:${keys}:ro" "${VM_NAME}" >/tmp/dotfiles-v2-tart.log 2>&1 </dev/null &
	ready=0
	for _ in $(seq 1 40); do
		if tart exec "${VM_NAME}" true >/dev/null 2>&1; then
			ready=1
			break
		fi
		sleep 3
	done
	if [[ ${ready} -ne 1 ]]; then
		echo "timed out waiting 120s for tart exec ${VM_NAME}; see /tmp/dotfiles-v2-tart.log" >&2
		exit 1
	fi
fi

# Remove any pre-installed Homebrew mise and install pinned mise v2026.11.12 with SHA-256 verification.
tart exec -i "${VM_NAME}" env MISE_VER="${MISE_VER}" MISE_SHA="${MISE_SHA256_MACOS_ARM64}" /bin/bash -euo pipefail <<'GUEST'
if [[ -x /opt/homebrew/bin/brew ]] && /opt/homebrew/bin/brew list --versions mise >/dev/null 2>&1; then
  /opt/homebrew/bin/brew uninstall --force mise
fi
if [[ -e /opt/homebrew/bin/mise ]]; then
  echo "unexpected /opt/homebrew/bin/mise still present after brew uninstall" >&2
  exit 1
fi
have=""
if [[ -x /usr/local/bin/mise ]]; then
  have="$(/usr/local/bin/mise --version | awk '{print $1}')"
fi
if [[ "${have}" != "${MISE_VER}" ]]; then
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "${tmp_dir}"' EXIT
  curl -fsSLo "${tmp_dir}/mise.tar.gz" "https://github.com/jdx/mise/releases/download/v${MISE_VER}/mise-v${MISE_VER}-macos-arm64.tar.gz"
  printf '%s  %s/mise.tar.gz\n' "${MISE_SHA}" "${tmp_dir}" | shasum -a 256 -c -
  tar -C "${tmp_dir}" -xzf "${tmp_dir}/mise.tar.gz"
  sudo install -d -m 0755 /usr/local/bin
  sudo install -m 0755 "${tmp_dir}/mise/bin/mise" /usr/local/bin/mise
fi
GUEST

tart exec -i "${VM_NAME}" env REPO_URL="${REPO_URL}" REF="${ref}" /bin/bash -euo pipefail <<'GUEST'
mkdir -p "${HOME}/dev"
if [[ -d "${HOME}/dev/dotfiles-v2/.git" ]]; then
  git -C "${HOME}/dev/dotfiles-v2" fetch -q origin "${REF}"
  git -C "${HOME}/dev/dotfiles-v2" checkout -q -B "${REF}" "origin/${REF}"
else
  git clone -q -b "${REF}" "${REPO_URL}" "${HOME}/dev/dotfiles-v2"
fi
GUEST

# Install native Claude Code & OpenCode v2 when missing and wire shell profiles for PATH + agent-secrets.
tart exec -i "${VM_NAME}" /bin/bash -euo pipefail <<'GUEST'
mkdir -p "${HOME}/.local/bin" "${HOME}/.opencode/bin"
if [[ ! -x "${HOME}/.local/bin/claude" ]]; then
  PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin" curl -fsSL https://claude.ai/install.sh | bash
fi
if [[ ! -x "${HOME}/.opencode/bin/opencode" ]] || [[ "$("${HOME}/.opencode/bin/opencode" --version </dev/null | awk '{print $NF}')" == 1.* ]]; then
  PATH="${HOME}/.opencode/bin:${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin" curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path
fi
old_path_line='export PATH="${HOME}/.local/bin:${HOME}/.opencode/bin:${HOME}/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:${PATH}"'
path_line='export PATH="${HOME}/.local/bin:${HOME}/.opencode/bin:${HOME}/.local/share/mise/shims:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"'
env_line='[ -r "${HOME}/.config/agent-secrets/env.sh" ] && . "${HOME}/.config/agent-secrets/env.sh"'
for rc in "${HOME}/.zprofile" "${HOME}/.zshrc" "${HOME}/.bash_profile" "${HOME}/.bashrc"; do
  touch "${rc}"
  if grep -Fqx "${old_path_line}" "${rc}"; then
    grep -Fvx "${old_path_line}" "${rc}" >"${rc}.tmp" || true
    mv "${rc}.tmp" "${rc}"
  fi
  if ! grep -Fqx "${path_line}" "${rc}"; then
    printf '%s\n' "${path_line}" >>"${rc}"
  fi
  if ! grep -Fqx "${env_line}" "${rc}"; then
    printf '%s\n' "${env_line}" >>"${rc}"
  fi
done
GUEST

# Install and start open-source Homebrew tailscale (provides tailscaled + Tailscale SSH on macOS).
tart exec -i "${VM_NAME}" /bin/bash -euo pipefail <<'GUEST'
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
if ! /opt/homebrew/bin/brew list --versions tailscale >/dev/null 2>&1; then
  /opt/homebrew/bin/brew install tailscale
fi
sudo /opt/homebrew/bin/brew services start tailscale >/dev/null
ready=0
for _ in $(seq 1 20); do
  if /opt/homebrew/bin/tailscale status --json >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done
if [[ ${ready} -ne 1 ]]; then
  echo "tailscaled did not become ready in VM; check /opt/homebrew/var/log/tailscaled.log" >&2
  exit 1
fi
GUEST

status_json="$(tart exec "${VM_NAME}" /opt/homebrew/bin/tailscale status --json 2>/dev/null || true)"
ts_state="$(printf '%s' "${status_json}" | jq -r '.BackendState // empty' 2>/dev/null || true)"
if [[ ${ts_state} == "Running" ]]; then
	cur_hostname="$(printf '%s' "${status_json}" | jq -r '.Self.HostName // empty')"
	run_ssh="$(tart exec "${VM_NAME}" sudo /opt/homebrew/bin/tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false' 2>/dev/null || echo false)"
	if [[ ${cur_hostname} != "${TS_HOSTNAME}" || ${run_ssh} != "true" ]]; then
		tart exec "${VM_NAME}" sudo /opt/homebrew/bin/tailscale set --ssh --hostname="${TS_HOSTNAME}" --accept-dns=false --operator=admin
	fi
else
	key="$(mint_tailscale_authkey "${TS_HOSTNAME}")"
	# shellcheck disable=SC2016
	printf '%s' "${key}" | tart exec -i "${VM_NAME}" env TS_HOSTNAME="${TS_HOSTNAME}" /bin/bash -euo pipefail -c '
		keyfile="$(mktemp)"
		trap "rm -f \"\${keyfile}\"" EXIT
		chmod 0600 "${keyfile}"
		cat >"${keyfile}"
		sudo /opt/homebrew/bin/tailscale up --auth-key="file:${keyfile}" --ssh --hostname="${TS_HOSTNAME}" --accept-dns=false --operator=admin --timeout=30s
	'
	unset key
fi

status_json="$(tart exec "${VM_NAME}" /opt/homebrew/bin/tailscale status --json)"
ts_state="$(printf '%s' "${status_json}" | jq -r '.BackendState // empty')"
cur_hostname="$(printf '%s' "${status_json}" | jq -r '.Self.HostName // empty')"
if [[ ${ts_state} != "Running" || ${cur_hostname} != "${TS_HOSTNAME}" ]]; then
	echo "unexpected Tailscale state in ${VM_NAME}: BackendState=${ts_state} HostName=${cur_hostname}" >&2
	exit 1
fi
if ! printf '%s' "${status_json}" | jq -e '(.Self.Tags // []) | index("tag:dev-env") != null' >/dev/null; then
	echo "Tailscale node ${cur_hostname} missing tag:dev-env" >&2
	exit 1
fi

echo "VM ready: ${VM_NAME} (tailscale=${TS_HOSTNAME})"
