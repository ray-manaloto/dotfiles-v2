#!/usr/bin/env bash
#MISE description="Sync dotfiles-v2 inside dotfiles-v2-macos VM and apply mise dotfiles and tools"
#USAGE flag "--ref <ref>" help="Git branch or ref to sync (default: current branch)"
set -euo pipefail

VM_NAME="dotfiles-v2-macos"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

if [[ "$(uname -s)" != "Darwin" ]] || ! command -v tart >/dev/null 2>&1; then
	echo "tasks/vm/sync requires macOS with tart on PATH" >&2
	exit 1
fi

if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	echo "VM ${VM_NAME} is not running; run 'mise run vm:up' first" >&2
	exit 1
fi

ref="$(resolve_ref)"

tart exec -i "${VM_NAME}" env REF="${ref}" /bin/bash -euo pipefail <<'GUEST'
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:/usr/local/bin:${PATH}"
git -C "${HOME}/dev/dotfiles-v2" fetch -q origin "${REF}"
git -C "${HOME}/dev/dotfiles-v2" checkout -q -B "${REF}" "origin/${REF}"
mise -C "${HOME}/dev/dotfiles-v2" trust --all
MISE_TRUSTED_CONFIG_PATHS="${HOME}/dev/dotfiles-v2:${HOME}/.config/mise" \
MISE_YES=1 \
mise -C "${HOME}/dev/dotfiles-v2" bootstrap --only files,dotfiles,tools --force-dotfiles --yes
GUEST
