#!/usr/bin/env bash
#MISE description="Sync dotfiles-v2 inside dotfiles-v2-macos VM and apply Option A mise bootstrap"
#USAGE flag "--ref <ref>" help="Git branch or ref to sync (default: current branch)"
set -euo pipefail

VM_NAME="dotfiles-v2-macos"
REPO_URL="https://github.com/ray-manaloto/dotfiles-v2.git"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

if [[ "$(uname -s)" != "Darwin" ]] || ! command -v tart >/dev/null 2>&1; then
	echo "tasks/vm/sync requires macOS with tart on PATH" >&2
	exit 1
fi

if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	echo "VM ${VM_NAME} is not running; run 'mise run vm:up' first" >&2
	exit 1
fi

ref="$(resolve_ref)"

tart exec -i "${VM_NAME}" env REF="${ref}" REPO_URL="${REPO_URL}" /bin/bash -euo pipefail <<'GUEST'
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.opencode/bin:${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
git -C "${HOME}/dev/dotfiles-v2" fetch -q origin "${REF}"
git -C "${HOME}/dev/dotfiles-v2" checkout -q -B "${REF}" "origin/${REF}"
if [[ -e "${HOME}/.config/mise" && ! -L "${HOME}/.config/mise" ]]; then
  rm -rf "${HOME}/.config/mise"
fi
for rc in "${HOME}/.zprofile" "${HOME}/.bash_profile"; do
  if [[ -f "${rc}" ]]; then
    grep -Fxv '[ -r "${HOME}/.config/dotfiles-v2/vm-env.sh" ] && . "${HOME}/.config/dotfiles-v2/vm-env.sh"' "${rc}" >"${rc}.tmp" || true
    mv "${rc}.tmp" "${rc}"
  fi
done
export MISE_TRUSTED_CONFIG_PATHS="${HOME}/dev/dotfiles-v2:${HOME}/.config/mise"
export MISE_LOCKED=1
export MISE_YES=1
/usr/local/bin/mise -E macos,vm bootstrap \
  --from "${REPO_URL}" \
  --from-dir "${HOME}/dev/dotfiles-v2" \
  --config-dir unix/home/.config/mise \
  --force-dotfiles --yes
/usr/local/bin/mise -E macos,vm -C "${HOME}" run host:prune --apply
/usr/local/bin/mise -E macos,vm -C "${HOME}" run host:prune-mcps --apply
if [[ -x /opt/homebrew/bin/brew ]] && /opt/homebrew/bin/brew list --cask codex >/dev/null 2>&1; then
  codex_raw="$(codex --version </dev/null 2>/dev/null || true)"
  if python3 -c 'import re, sys; m = re.search(r"(\d+)\.(\d+)\.(\d+)", sys.argv[1]); sys.exit(0 if m and tuple(map(int, m.groups())) < (0, 171, 0) else 1)' "${codex_raw}"; then
    /opt/homebrew/bin/brew upgrade --cask codex </dev/null
  fi
fi
/usr/local/bin/mise -C "${HOME}/dev/dotfiles-v2" deps uv
GUEST
