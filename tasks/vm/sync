#!/usr/bin/env bash
#MISE description="Sync dotfiles-v2 inside dotfiles-v2-macos VM and apply Option A mise bootstrap"
#USAGE flag "--ref <ref>" help="Git branch or ref to sync (default: current branch)"
set -euo pipefail

VM_NAME="dotfiles-v2-macos"
REPO_URL="https://github.com/ray-manaloto/dotfiles-v2.git"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

if [[ "$(uname -s)" != "Darwin" ]] || ! command -v tart >/dev/null 2>&1; then
	echo "tasks/vm/sync requires macOS with tart on PATH" >&2
	exit 1
fi

if ! tart exec "${VM_NAME}" true >/dev/null 2>&1; then
	echo "VM ${VM_NAME} is not running; run 'mise run vm:up' first" >&2
	exit 1
fi

ref="$(resolve_ref)"

tart exec -i "${VM_NAME}" env REF="${ref}" REPO_URL="${REPO_URL}" /bin/bash -euo pipefail <<'GUEST'
export PATH="/opt/homebrew/sbin:/opt/homebrew/bin:/usr/local/bin:${HOME}/.local/share/mise/shims:${HOME}/.opencode/bin:${HOME}/.local/bin:${PATH}"
git -C "${HOME}/dev/dotfiles-v2" fetch -q origin "${REF}"
git -C "${HOME}/dev/dotfiles-v2" checkout -q -B "${REF}" "origin/${REF}"
if [[ -e "${HOME}/.config/mise" && ! -L "${HOME}/.config/mise" ]]; then
  rm -rf "${HOME}/.config/mise"
fi
export MISE_TRUSTED_CONFIG_PATHS="${HOME}/dev/dotfiles-v2:${HOME}/.config/mise"
export MISE_YES=1
/usr/local/bin/mise -E vm,macos bootstrap \
  --from "${REPO_URL}" \
  --from-dir "${HOME}/dev/dotfiles-v2" \
  --config-dir unix/home/.config/mise \
  --force-dotfiles --yes
GUEST
