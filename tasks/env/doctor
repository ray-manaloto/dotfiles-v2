#!/usr/bin/env bash
#MISE description="Verify live state, isolation, symlinks, tools, Claude Code, OpenCode, ZCode, Tailscale SSH, and project doctor across pc, mac, and vm"
#USAGE flag "--target <target>" default="all" help="Environment to check: pc, mac, vm, or all"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux Docker SSH host alias (for target=pc)"
#USAGE flag "--smoke" help="Run live Claude Code, OpenCode, and ZCode prompt tests across requested targets"
set -euo pipefail

target="${usage_target:-all}"
host="${usage_host:-pc}"
smoke="${usage_smoke:-false}"
name="dotfiles-v2"
vm_name="dotfiles-v2-macos"
fail_count=0

pass_row() {
	printf 'PASS  %-6s  %s\n' "$1" "$2"
}

fail_row() {
	printf 'FAIL  %-6s  %s\n' "$1" "$2"
	fail_count=$((fail_count + 1))
}

version_ge() {
	local have="$1" want="$2"
	[[ "$(printf '%s\n%s\n' "${want}" "${have}" | sort -V | head -n 1)" == "${want}" ]]
}

resolve_ts_dest() {
	local want="$1" status_json dest
	if command -v tailscale >/dev/null 2>&1; then
		if status_json="$(tailscale status --json 2>/dev/null)"; then
			dest="$(printf '%s' "${status_json}" | jq -r --arg h "${want}" '
				[.Peer[]? | select(.HostName == $h and .Online == true)
				| ((.DNSName // "" | sub("\\.$"; "")) | if length > 0 then . else empty end) // (.TailscaleIPs[0] // "")]
				| map(select(length > 0)) | first // empty
			')"
			if [[ -n ${dest} ]]; then
				printf '%s' "${dest}"
				return 0
			fi
		fi
	fi
	printf '%s' "${want}"
}

check_container() {
	local label="$1" want_arch="$2"
	shift 2
	local -a dcmd=("$@")

	local running privileged init_enabled secrets_rw env_c arch mise_ver link_target ts_bin tsd_bin missing_cnt hk_ver claude_out
	local want_ts_host="${name}-${label}" ts_json ts_state ts_host ts_ssh ts_dest ssh_out
	running="$("${dcmd[@]}" container inspect --format '{{.State.Running}}' "${name}" 2>/dev/null || echo false)"
	if [[ ${running} != "true" ]]; then
		fail_row "${label}" "container ${name} is not running"
		return
	fi

	privileged="$("${dcmd[@]}" container inspect --format '{{.HostConfig.Privileged}}' "${name}")"
	if [[ ${privileged} != "false" ]]; then
		fail_row "${label}" "Privileged=${privileged} (expected false)"
		return
	fi

	init_enabled="$("${dcmd[@]}" container inspect --format '{{.HostConfig.Init}}' "${name}")"
	if [[ ${init_enabled} != "true" ]]; then
		fail_row "${label}" "Init=${init_enabled} (expected true)"
		return
	fi

	secrets_rw="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/run/agent-secrets"}}{{.RW}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	if [[ ${secrets_rw} != "false" ]]; then
		fail_row "${label}" "/run/agent-secrets mount RW='${secrets_rw}' (expected false)"
		return
	fi

	env_c="$("${dcmd[@]}" exec "${name}" printenv container 2>/dev/null || true)"
	if [[ ${env_c} != "docker" ]]; then
		fail_row "${label}" "container env='${env_c}' (expected docker)"
		return
	fi

	arch="$("${dcmd[@]}" exec "${name}" uname -m)"
	if [[ ${arch} != "${want_arch}" ]]; then
		fail_row "${label}" "arch=${arch} (expected ${want_arch})"
		return
	fi

	ts_bin="$("${dcmd[@]}" exec "${name}" which tailscale 2>/dev/null || true)"
	tsd_bin="$("${dcmd[@]}" exec "${name}" which tailscaled 2>/dev/null || true)"
	if [[ ${ts_bin} != "/opt/mise/shims/tailscale" || ${tsd_bin} != "/opt/mise/shims/tailscaled" ]]; then
		fail_row "${label}" "expected mise tailscale shims, got tailscale='${ts_bin}' tailscaled='${tsd_bin}'"
		return
	fi

	ts_json="$("${dcmd[@]}" exec "${name}" tailscale status --json 2>/dev/null || true)"
	ts_state="$(printf '%s' "${ts_json}" | jq -r '.BackendState // empty' 2>/dev/null || true)"
	ts_host="$(printf '%s' "${ts_json}" | jq -r '.Self.HostName // empty' 2>/dev/null || true)"
	ts_ssh="$("${dcmd[@]}" exec "${name}" tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false' 2>/dev/null || echo false)"
	if [[ ${ts_state} != "Running" || ${ts_host} != "${want_ts_host}" || ${ts_ssh} != "true" ]]; then
		fail_row "${label}" "Tailscale state='${ts_state}' host='${ts_host}' RunSSH='${ts_ssh}'"
		return
	fi
	if ! printf '%s' "${ts_json}" | jq -e '(.Self.Tags // []) | index("tag:dev-env") != null' >/dev/null 2>&1; then
		fail_row "${label}" "Tailscale node ${ts_host} missing tag:dev-env"
		return
	fi

	ts_dest="$(resolve_ts_dest "${want_ts_host}")"
	if ! ssh_out="$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "dev@${ts_dest}" 'uname -m && id -un && test "${MISE_DATA_DIR:-}" = /opt/mise && command -v mise >/dev/null && command -v tailscale >/dev/null && command -v hk >/dev/null && command -v python3 >/dev/null && command -v agnix >/dev/null && command -v claude >/dev/null && command -v opencode >/dev/null && command -v zcode >/dev/null && command -v vb >/dev/null && command -v pitchfork >/dev/null && command -v aube >/dev/null && command -v usage >/dev/null && command -v communique >/dev/null && test -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" && test -n "${ZCODE_CREDENTIAL_SECRET_FILE:-}"' 2>/dev/null)"; then
		fail_row "${label}" "Tailscale SSH to dev@${ts_dest} failed"
		return
	fi
	if [[ "$(printf '%s\n' "${ssh_out}" | tr '\n' ' ')" != "${want_arch} dev "* ]]; then
		fail_row "${label}" "Tailscale SSH unexpected identity/arch: ${ssh_out}"
		return
	fi

	mise_ver="$("${dcmd[@]}" exec "${name}" mise --version | awk '{print $1}')"
	if ! version_ge "${mise_ver}" "2026.11.13"; then
		fail_row "${label}" "mise=${mise_ver} (< 2026.11.13)"
		return
	fi

	link_target="$("${dcmd[@]}" exec "${name}" readlink -f /home/dev/.config/mise 2>/dev/null || true)"
	if [[ ${link_target} != "/workspace/unix/home/.config/mise" ]]; then
		fail_row "${label}" ".config/mise link='${link_target}' (expected /workspace/unix/home/.config/mise)"
		return
	fi

	missing_cnt="$("${dcmd[@]}" exec -w /workspace "${name}" mise ls --missing | grep -vc '^Tool[[:space:]]' || true)"
	if [[ ${missing_cnt} -ne 0 ]]; then
		fail_row "${label}" "mise ls --missing reported ${missing_cnt} missing tools"
		return
	fi

	local doctor_out
	if ! doctor_out="$("${dcmd[@]}" exec -w /workspace "${name}" mise doctor project 2>&1)"; then
		printf '%s\n' "${doctor_out}" >&2
		fail_row "${label}" "mise doctor project failed"
		return
	fi

	hk_ver="$("${dcmd[@]}" exec -w /workspace "${name}" hk --version 2>/dev/null || true)"
	if [[ -z ${hk_ver} ]]; then
		fail_row "${label}" "hk --version failed"
		return
	fi

	if ! claude_out="$(
		"${dcmd[@]}" exec -i -w /workspace -e SMOKE="${smoke}" -e ZCODE_SMOKE_MODEL="${ZCODE_SMOKE_MODEL:-}" "${name}" /bin/bash -lc 'bash -euo pipefail -s' <<'CONTAINER'
test -s /run/agent-secrets/claude-oauth-token
test -n "${CLAUDE_CODE_OAUTH_TOKEN:-}"
cpath="$(command -v claude)"
test "${cpath}" = "/home/dev/.local/bin/claude"
cver="$(claude --version </dev/null | awk '{print $1}')"
claude doctor </dev/null 2>&1 | grep -Fq "Running: native"
test -w /home/dev/.local/share/opencode
test "$(readlink -f /home/dev/.config/opencode/opencode.json)" = "/workspace/unix/home/.config/opencode/opencode.json"
test "$(readlink -f /home/dev/.config/opencode/AGENTS.md)" = "/workspace/unix/home/.config/agents/AGENTS.md"
ocpath="$(command -v opencode)"
test "${ocpath}" = "/home/dev/.opencode/bin/opencode"
ocver="$(opencode --version </dev/null | awk '{print $NF}')"
[[ "${ocver}" == v2.* || "${ocver}" == 2.* ]]
test -w /home/dev/.zcode
test "$(readlink -f /home/dev/.zcode/cli/setting.json)" = "/workspace/unix/home/.zcode/cli/setting.json"
test "$(readlink -f /home/dev/.zcode/AGENTS.md)" = "/workspace/unix/home/.config/agents/AGENTS.md"
zpath="$(command -v zcode)"
test "${zpath}" = "/opt/mise/shims/zcode"
test -s "${ZCODE_CREDENTIAL_SECRET_FILE:-}"
test "$(stat -c '%a' "${ZCODE_CREDENTIAL_SECRET_FILE}")" = "600"
test "$(wc -c < "${ZCODE_CREDENTIAL_SECRET_FILE}")" -ge 32
zver="$(zcode --version </dev/null | awk '$1 == "zcode-app-cli" {print $2}')"
test -n "${zver}"
zcode doctor --json </dev/null | python3 -c 'import json, sys; cfg = json.load(sys.stdin).get("configuration", {}); assert cfg.get("ok") is True and cfg.get("user", {}).get("status") == "loaded" and cfg.get("diagnostics") == []'
test -L /home/dev/.gemini/config/skills
test "$(readlink -f /home/dev/.gemini/config/skills)" = "/home/dev/.agents/skills"
python3 - <<'PY'
import json
import os
import subprocess
import tomllib
from pathlib import Path

claude_cfg = Path(os.environ["CLAUDE_CONFIG_DIR"]) / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR") else Path("/home/dev/.claude.json")
c = json.loads(claude_cfg.read_text(encoding="utf-8"))
for srv in ("mise", "hk", "pitchfork", "usage-mise"):
    assert srv in c.get("mcpServers", {}), f"Missing claude mcpServers.{srv} in {claude_cfg}"
cx = tomllib.loads(Path("/home/dev/.codex/config.toml").read_text(encoding="utf-8"))
for srv in ("mise", "hk", "pitchfork", "usage-mise"):
    assert srv in cx.get("mcp_servers", {}), f"Missing codex mcp_servers.{srv}"
dot_data = json.loads(subprocess.check_output(["mise", "-C", os.environ["HOME"], "dot", "status", "--json"], text=True))
healthy = {"applied", "tracked", "absent", "not_on_this_machine", "ok", "synced", "match"}
entries = ((dot_data.get("files") or []) + (dot_data.get("edits") or [])) if isinstance(dot_data, dict) else (dot_data or [])
for entry in entries:
    if isinstance(entry, dict):
        st = str(entry.get("state") or entry.get("status") or "")
        assert not st or st in healthy, f"unhealthy dot status: {entry}"
if isinstance(dot_data, dict):
    assert not (dot_data.get("orphaned") or []), f"orphaned dotfiles: {dot_data.get('orphaned')}"
PY
claude mcp get mise </dev/null >/dev/null
for _sk in agy-session-ops aube communique flint fnox herdr-roll hk-configure hk-debug mise-bootstrap-ops pitchfork post-task-learn pwf-status usage vercel-board; do
	test -f "/home/dev/.agents/skills/${_sk}/SKILL.md"
	test -f "/home/dev/.claude/skills/${_sk}/SKILL.md"
	test -f "/home/dev/.gemini/config/skills/${_sk}/SKILL.md"
done
mise -C ~ doctor --json | python3 -c 'import json, sys; d = json.load(sys.stdin); assert not d.get("errors") and not d.get("warnings"), d'
vb_status="unconfigured"
if [ -r /home/dev/.config/board/env.sh ]; then
	/home/dev/.local/bin/vb whoami </dev/null >/dev/null
	vb_status="ok"
fi
smoke_suffix=""
if [[ "${SMOKE}" == "true" ]]; then
	sout="$(claude -p --model haiku --no-session-persistence --output-format text "Reply with exactly: OK" </dev/null)"
	[[ "${sout}" == *OK* ]]
	oc_out="$(opencode --standalone run --archived "Reply with exactly: OK" </dev/null)"
	[[ "${oc_out}" == *OK* ]]
	python3 - <<'PY'
import json
import os

path = os.environ.get("ZCODE_CLI_CREDENTIALS_FILE", "").strip() or os.path.expanduser("~/.zcode/v2/credentials.json")
assert os.path.isfile(path) and os.path.getsize(path) > 0, f"missing ZCode credentials: {path}"
with open(path, "r", encoding="utf-8") as fh:
    data = json.load(fh)
assert isinstance(data, dict) and data.get("oauth:active_provider") and data.get("zcodejwttoken"), "missing ZCode OAuth session keys"
PY
	z_args=(--prompt="Reply with exactly: OK")
	if [[ -n "${ZCODE_SMOKE_MODEL:-}" ]]; then
		z_args+=(--model "${ZCODE_SMOKE_MODEL}")
	fi
	z_rc=0
	z_out="$(zcode "${z_args[@]}" </dev/null 2>&1)" || z_rc=$?
	if [[ ${z_rc} -eq 0 && "${z_out}" == *OK* ]]; then
		z_smoke="OK"
	elif [[ "${z_out}" == *"PROVIDER_BUSINESS_ERROR"* ]] && [[ "${z_out}" == *"providerCode: '1113'"* || "${z_out}" == *"[1113]"* ]]; then
		z_smoke="AUTH_OK_NO_QUOTA(1113)"
	elif [[ "${z_out}" == *"PROVIDER_BUSINESS_ERROR"* ]] && [[ "${z_out}" == *"providerCode: 1005"* || "${z_out}" == *"exceed quota limit"* ]]; then
		z_smoke="AUTH_OK_NO_QUOTA(1005)"
	else
		printf '%s\n' "${z_out}" >&2
		exit 1
	fi
	smoke_suffix=", smoke=OK, zcode-smoke=${z_smoke}"
fi
printf 'claude=%s, opencode=%s, zcode=%s, vb=%s%s' "${cver}" "${ocver}" "${zver}" "${vb_status}" "${smoke_suffix}"
CONTAINER
	)" || [[ -z ${claude_out} ]]; then
		fail_row "${label}" "Claude Code / OpenCode / ZCode / agent-secrets verification failed"
		return
	fi

	pass_row "${label}" "${arch}, Privileged=false, container=docker, mise=${mise_ver}, ${hk_ver}, ${claude_out}, tailscale-ssh=OK, 0 missing tools"
}

check_vm() {
	if [[ "$(uname -s)" != "Darwin" ]] || ! command -v tart >/dev/null 2>&1; then
		fail_row "vm" "requires macOS host with tart"
		return
	fi

	if ! tart exec "${vm_name}" true >/dev/null 2>&1; then
		fail_row "vm" "Tart VM ${vm_name} is not running"
		return
	fi

	local want_ts_host="dotfiles-v2-vm" ts_json ts_state ts_host ts_ssh ts_dest ssh_out out
	# shellcheck disable=SC2016
	if ! tart exec "${vm_name}" /bin/bash -euo pipefail -c '
		launchctl print "gui/$(id -u)/dev.mise.tailscaled" >/dev/null
		test ! -e /Library/LaunchDaemons/sh.brew.tailscale.plist
	'; then
		fail_row "vm" "dev.mise.tailscaled LaunchAgent missing or legacy LaunchDaemon still present"
		return
	fi

	# shellcheck disable=SC2016
	ts_json="$(tart exec "${vm_name}" /bin/bash -lc '/opt/homebrew/bin/tailscale --socket="${HOME}/.local/state/tailscale/tailscaled.sock" status --json' 2>/dev/null || true)"
	ts_state="$(printf '%s' "${ts_json}" | jq -r '.BackendState // empty' 2>/dev/null || true)"
	ts_host="$(printf '%s' "${ts_json}" | jq -r '.Self.HostName // empty' 2>/dev/null || true)"
	# shellcheck disable=SC2016
	ts_ssh="$(tart exec "${vm_name}" /bin/bash -lc '/opt/homebrew/bin/tailscale --socket="${HOME}/.local/state/tailscale/tailscaled.sock" debug prefs' 2>/dev/null | jq -r '.RunSSH // false' 2>/dev/null || echo false)"
	if [[ ${ts_state} != "Running" || ${ts_host} != "${want_ts_host}" || ${ts_ssh} != "true" ]]; then
		fail_row "vm" "Tailscale state='${ts_state}' host='${ts_host}' RunSSH='${ts_ssh}'"
		return
	fi
	if ! printf '%s' "${ts_json}" | jq -e '(.Self.Tags // []) | index("tag:dev-env") != null' >/dev/null 2>&1; then
		fail_row "vm" "Tailscale node ${ts_host} missing tag:dev-env"
		return
	fi

	ts_dest="$(resolve_ts_dest "${want_ts_host}")"
	if ! ssh_out="$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "admin@${ts_dest}" 'uname -m && id -un && command -v mise && command -v tailscale >/dev/null && command -v hk >/dev/null && command -v python3 >/dev/null && command -v agnix >/dev/null && command -v claude >/dev/null && command -v opencode >/dev/null && command -v zcode >/dev/null && command -v vb >/dev/null && command -v pitchfork >/dev/null && command -v aube >/dev/null && command -v usage >/dev/null && command -v communique >/dev/null && test -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" && test -n "${ZCODE_CREDENTIAL_SECRET_FILE:-}"' 2>/dev/null)"; then
		fail_row "vm" "Tailscale SSH to admin@${ts_dest} failed"
		return
	fi
	if [[ "$(printf '%s\n' "${ssh_out}" | tr '\n' ' ')" != "arm64 admin /usr/local/bin/mise"* ]]; then
		fail_row "vm" "Tailscale SSH unexpected identity/arch/mise: ${ssh_out}"
		return
	fi

	if ! out="$(
		tart exec -i "${vm_name}" env SMOKE="${smoke}" ZCODE_SMOKE_MODEL="${ZCODE_SMOKE_MODEL:-}" /bin/bash -euo pipefail <<'GUEST'
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.opencode/bin:${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
export MISE_ENV=vm
export MISE_TRUSTED_CONFIG_PATHS="${HOME}/dev/dotfiles-v2:${HOME}/.config/mise"
sm="$(uname -sm)"
test "${sm}" = "Darwin arm64"
test ! -e /opt/homebrew/bin/mise
