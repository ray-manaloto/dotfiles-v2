#!/usr/bin/env bash
#MISE description="Emit schema-first environment metrics, active agy sessions, and Herdr stats sync status"
#USAGE flag "--cache-home <path>" help="Override XDG_CACHE_HOME directory"
#USAGE flag "--herdr-home <path>" help="Override HERDR_APP_HOME directory"
#USAGE flag "--json" help="Emit EnvStatsSnapshotResponse JSON (default)"
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
repo_root="$(cd "${script_dir}/../.." && pwd -P)"
lib_dir="${repo_root}/unix/home/.config/mise/lib"
venv_py="${repo_root}/.venv/bin/python"
if [[ ! -x ${venv_py} ]] && command -v git >/dev/null 2>&1; then
	common_dir="$(git -C "${repo_root}" rev-parse --git-common-dir 2>/dev/null || true)"
	if [[ -n ${common_dir} ]]; then
		if [[ ${common_dir} == /* ]]; then
			common_root="$(cd "${common_dir}/.." 2>/dev/null && pwd -P || true)"
		else
			common_root="$(cd "${repo_root}/${common_dir}/.." 2>/dev/null && pwd -P || true)"
		fi
		if [[ -n ${common_root} && -x "${common_root}/.venv/bin/python" ]]; then
			venv_py="${common_root}/.venv/bin/python"
		fi
	fi
fi

if [[ ! -x ${venv_py} ]]; then
	echo "env:stats: missing .venv/bin/python; run 'mise deps uv'" >&2
	exit 1
fi
if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
	exec "${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from env_stats.cli import main; raise SystemExit(main(sys.argv[2:]))' "${lib_dir}" --help
fi

args=()
[[ -n ${usage_cache_home:-} ]] && args+=(--cache-home "${usage_cache_home}")
[[ -n ${usage_herdr_home:-} ]] && args+=(--herdr-home "${usage_herdr_home}")
if [[ ${usage_json:-true} == "true" ]]; then
	args+=(--json)
fi

exec "${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from env_stats.cli import main; raise SystemExit(main(sys.argv[2:]))' "${lib_dir}" ${args[@]+"${args[@]}"}
