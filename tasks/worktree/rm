#!/usr/bin/env bash
#MISE description="Remove a sibling git worktree and its wt/<slug> branch"
#USAGE arg "<slug>" help="Worktree slug to remove"
#USAGE flag "--force" help="Force remove even with uncommitted changes or unmerged branch"
set -euo pipefail

slug="${usage_slug:-}"
force="${usage_force:-false}"

if [[ ! ${slug} =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
	echo "invalid slug '${slug}'" >&2
	exit 1
fi

root="$(git rev-parse --show-toplevel)"
common_dir="$(git -C "${root}" rev-parse --git-common-dir)"
if [[ ${common_dir} != /* ]]; then
	common_dir="${root}/${common_dir}"
fi
main_root="$(cd "$(dirname "${common_dir}")" && pwd -P)"
repo_name="$(basename "${main_root}")"
wt_dir="$(dirname "${main_root}")/${repo_name}-${slug}"
branch="wt/${slug}"

if [[ -d ${wt_dir} ]]; then
	if [[ ${force} == "true" ]]; then
		git -C "${main_root}" worktree remove --force "${wt_dir}"
	else
		git -C "${main_root}" worktree remove "${wt_dir}"
	fi
fi

if git -C "${main_root}" show-ref --verify --quiet "refs/heads/${branch}"; then
	if [[ ${force} == "true" ]]; then
		git -C "${main_root}" branch -D "${branch}"
	else
		git -C "${main_root}" branch -d "${branch}"
	fi
fi
