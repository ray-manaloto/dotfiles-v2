#!/usr/bin/env bash
#MISE description="Run online security, outdated, secret, and CLI configuration audits"
#USAGE flag "--verbose" help="Print raw JSON payloads from underlying checks"
set -euo pipefail

verbose="${usage_verbose:-false}"
script_dir="$(cd "$(dirname "$0")" && pwd -P)"
repo_root="$(cd "${script_dir}/../.." && pwd -P)"
fail_count=0

run_outdated_check() {
	local label="$1"
	shift
	local out_file err_file rc=0
	out_file="$(mktemp)"
	err_file="$(mktemp)"
	mise "$@" >"${out_file}" 2>"${err_file}" || rc=$?
	local err_text out_text
	err_text="$(cat "${err_file}")"
	out_text="$(cat "${out_file}")"
	rm -f "${out_file}" "${err_file}"

	if [[ ${rc} -ne 0 ]]; then
		printf 'FAIL  %s: exited %d\n' "${label}" "${rc}" >&2
		[[ -n ${err_text} ]] && printf '%s\n' "${err_text}" >&2
		fail_count=$((fail_count + 1))
		return
	fi
	if [[ -n ${err_text} ]]; then
		printf 'FAIL  %s: unexpected stderr warnings:\n%s\n' "${label}" "${err_text}" >&2
		fail_count=$((fail_count + 1))
		return
	fi
	if ! python3 -I -B -c 'import json, sys; data = json.loads(sys.argv[1]); assert isinstance(data, dict)' "${out_text}" 2>/dev/null; then
		printf 'FAIL  %s: invalid JSON stdout\n' "${label}" >&2
		fail_count=$((fail_count + 1))
		return
	fi
	if [[ ${verbose} == "true" ]]; then
		printf '%s\n' "${out_text}"
	fi
	printf 'PASS  %s (0 stderr warnings)\n' "${label}"
}

run_outdated_check "mise-outdated-repo" -C "${repo_root}" outdated -b --json
run_outdated_check "mise-outdated-global" -C "${HOME}" outdated -b --json --global

# mise backends switch --dry-run (non-registry backend parity)
switch_out="$(mktemp)"
switch_err="$(mktemp)"
switch_rc=0
mise -C "${repo_root}" backends switch --dry-run --global >"${switch_out}" 2>"${switch_err}" || switch_rc=$?
if [[ ${verbose} == "true" && -s ${switch_out} ]]; then
	cat "${switch_out}"
fi
if [[ ${switch_rc} -ne 0 ]]; then
	printf 'FAIL  mise-backends-switch-dry-run (rc=%d)\n' "${switch_rc}" >&2
	[[ -s ${switch_err} ]] && cat "${switch_err}" >&2
	fail_count=$((fail_count + 1))
elif grep -Eq 'would switch|would replace stale' "${switch_out}"; then
	printf 'FAIL  mise-backends-switch-dry-run: backend drift detected:\n' >&2
	cat "${switch_out}" >&2
	fail_count=$((fail_count + 1))
else
	printf 'PASS  mise-backends-switch-dry-run\n'
fi
rm -f "${switch_out}" "${switch_err}"

# mise -C ~ audit --json: fail ONLY on fixable advisories; log unpatched CVEs as advisory.
audit_file="$(mktemp)"
audit_err="$(mktemp)"
audit_rc=0
mise -C "${HOME}" audit --json >"${audit_file}" 2>"${audit_err}" || audit_rc=$?
if [[ ! -s ${audit_file} ]]; then
	printf 'FAIL  mise-audit: empty output (rc=%d): %s\n' "${audit_rc}" "$(cat "${audit_err}")" >&2
	fail_count=$((fail_count + 1))
else
	if [[ ${verbose} == "true" ]]; then
		cat "${audit_file}"
	fi
	if ! python3 -I -B "${repo_root}/tasks/py/doctor_checks.py" mise-audit-fixable --json-file "${audit_file}" --rc "${audit_rc}" --err-file "${audit_err}"; then
		fail_count=$((fail_count + 1))
	fi
fi
rm -f "${audit_file}" "${audit_err}"

# uv audit: fail on fixable vulnerabilities, adverse statuses, or command failures; ignore unpatched until fixed.
uv_file="$(mktemp)"
uv_err="$(mktemp)"
uv_rc=0
uv --directory "${repo_root}" audit --locked --preview-features audit-command,json-output --output-format json >"${uv_file}" 2>"${uv_err}" || uv_rc=$?
if [[ ${verbose} == "true" && -s ${uv_file} ]]; then
	cat "${uv_file}"
fi
if ! python3 -I -B - "${uv_file}" "${uv_rc}" "${uv_err}" <<'PY'
import json
import sys
from pathlib import Path

payload_path = Path(sys.argv[1])
rc = int(sys.argv[2])
err_path = Path(sys.argv[3])
raw = payload_path.read_text(encoding="utf-8") if payload_path.is_file() else ""
err_text = err_path.read_text(encoding="utf-8").strip() if err_path.is_file() else ""
if not raw.strip():
    sys.stderr.write(f"FAIL  uv-audit: empty JSON output (rc={rc})\n")
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
try:
    data = json.loads(raw)
except json.JSONDecodeError as exc:
    sys.stderr.write(f"FAIL  uv-audit: invalid JSON ({exc})\n")
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
if not isinstance(data, dict):
    sys.stderr.write(f"FAIL  uv-audit: expected JSON object, got {type(data).__name__}\n")
    raise SystemExit(1)

vulns = data.get("vulnerabilities") or []
adverse_statuses = data.get("adverse_statuses") or []
fixable = []
advisory = []
for v in vulns:
    if not isinstance(v, dict):
        continue
    dep = v.get("dependency") if isinstance(v.get("dependency"), dict) else {}
    fix_vers = v.get("fix_versions") or v.get("fixed") or []
    vid = v.get("display_id") or v.get("id") or "unknown"
    pkg = dep.get("name") or v.get("name") or v.get("package") or "unknown"
    ver = dep.get("version") or v.get("version") or ""
    if fix_vers:
        fixable.append(f"{pkg}@{ver} {vid} (fixed in {', '.join(map(str, fix_vers))})")
    else:
        advisory.append(f"{pkg}@{ver} {vid} (no upstream fix yet)")

adverse_msgs = []
for adv in adverse_statuses:
    if isinstance(adv, dict):
        adep = adv.get("dependency") if isinstance(adv.get("dependency"), dict) else {}
        apkg = adep.get("name") or adv.get("name") or adv.get("package") or "unknown"
        aver = adep.get("version") or adv.get("version") or ""
        astatus = adv.get("status") or adv.get("reason") or adv.get("adverse_status") or json.dumps(adv)
        adverse_msgs.append(f"{apkg}@{aver}: {astatus}")
    else:
        adverse_msgs.append(str(adv))

for item in advisory:
    sys.stdout.write(f"ADVISORY  uv-audit: {item}\n")
for item in adverse_msgs:
    sys.stderr.write(f"FAIL  uv-audit: adverse status {item}\n")
if fixable:
    for item in fixable:
        sys.stderr.write(f"FAIL  uv-audit: fixable {item}\n")
if fixable or adverse_msgs:
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
if rc != 0 and not vulns:
    sys.stderr.write(f"FAIL  uv-audit: exited {rc}\n")
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
sys.stdout.write("PASS  uv-audit (0 fixable advisories)\n")
PY
then
	fail_count=$((fail_count + 1))
fi
rm -f "${uv_file}" "${uv_err}"

# fnox doctor + strict per-profile check
if ! mise -C "${repo_root}" run secret:doctor; then
	fail_count=$((fail_count + 1))
fi

# zcode doctor --json
if command -v zcode >/dev/null 2>&1; then
	zcode_err="$(mktemp)"
	zcode_out=""
	zcode_rc=0
	zcode_out="$(ZCODE_CLI_SETTINGS_FILE="${repo_root}/unix/home/.zcode/cli/setting.json" zcode doctor --json </dev/null 2>"${zcode_err}")" || zcode_rc=$?
	if [[ ${verbose} == "true" && -n ${zcode_out} ]]; then
		printf '%s\n' "${zcode_out}"
	fi
	if ! python3 -I -B - "${zcode_out}" "${zcode_rc}" "${zcode_err}" <<'PY'
import json
import sys
from pathlib import Path

raw = sys.argv[1]
rc = int(sys.argv[2])
err_path = Path(sys.argv[3])
err_text = err_path.read_text(encoding="utf-8").strip() if err_path.is_file() else ""
if not raw.strip():
    sys.stderr.write(f"FAIL  zcode-doctor: empty JSON output (rc={rc})\n")
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
try:
    data = json.loads(raw)
except json.JSONDecodeError as exc:
    sys.stderr.write(f"FAIL  zcode-doctor: invalid JSON ({exc}; rc={rc})\n")
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
if not isinstance(data, dict):
    sys.stderr.write(f"FAIL  zcode-doctor: expected JSON object, got {type(data).__name__}\n")
    raise SystemExit(1)
cfg = data.get("configuration")
if not isinstance(cfg, dict):
    sys.stderr.write("FAIL  zcode-doctor: missing configuration object\n")
    raise SystemExit(1)
if (
    rc != 0
    or cfg.get("ok") is not True
    or cfg.get("user", {}).get("status") != "loaded"
    or cfg.get("diagnostics") != []
):
    sys.stderr.write(f"FAIL  zcode-doctor (rc={rc}): {json.dumps(cfg)}\n")
    if err_text:
        sys.stderr.write(f"{err_text}\n")
    raise SystemExit(1)
sys.stdout.write("PASS  zcode-doctor\n")
PY
	then
		fail_count=$((fail_count + 1))
	fi
	rm -f "${zcode_err}"
else
	printf 'SKIP  zcode-doctor (zcode not installed)\n'
fi

if [[ ${fail_count} -ne 0 ]]; then
	printf 'doctor:online: %d check(s) failed\n' "${fail_count}" >&2
	exit 1
fi
printf 'doctor:online: all checks passed\n'
