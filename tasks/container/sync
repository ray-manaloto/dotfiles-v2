#!/usr/bin/env bash
#MISE description="Sync checkout(s) of dotfiles-v2 and apply Option A mise bootstrap inside running container(s)"
#USAGE flag "--target <target>" default="pc" help="Target environment: pc, mac, or all"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux Docker SSH host alias (for target=pc)"
#USAGE flag "--ref <ref>" help="Git branch or ref to sync (default: current branch)"
set -euo pipefail

target="${usage_target:-pc}"
host="${usage_host:-pc}"
name="dotfiles-v2"
repo_url="https://github.com/ray-manaloto/dotfiles-v2.git"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

bootstrap_phase2() {
	local -a dcmd=("$@")
	# shellcheck disable=SC2016
	"${dcmd[@]}" exec -w /workspace "${name}" /bin/bash -euo pipefail -c '
		if [ -e /home/dev/.config/mise ] && [ ! -L /home/dev/.config/mise ]; then
			rm -rf /home/dev/.config/mise
		fi
		MISE_LOCKED=1 mise -E container,linux bootstrap \
			--from "$1" \
			--from-dir /workspace \
			--config-dir unix/home/.config/mise \
			--only dotfiles,tools,task \
			--force-dotfiles --yes
	' bash "${repo_url}"
}

ref="$(resolve_ref)"

sync_pc() {
	local remote_dir
	remote_dir="$(ssh -o BatchMode=yes "${host}" 'printf "%s/dev/containers/dotfiles-v2" "$HOME"')"
	ssh -o BatchMode=yes "${host}" \
		"git -C '${remote_dir}' -c core.hooksPath=/dev/null fetch -q origin '${ref}' && git -C '${remote_dir}' -c core.hooksPath=/dev/null checkout -q -B '${ref}' 'origin/${ref}'"
	bootstrap_phase2 env "DOCKER_HOST=ssh://${host}" docker
}

sync_mac() {
	local local_dir
	if [[ "$(uname -s)" != "Darwin" ]]; then
		echo "mac Docker Desktop target must run on macOS" >&2
		exit 1
	fi

	local_dir="${HOME}/dev/containers/${name}"
	git -C "${local_dir}" -c core.hooksPath=/dev/null fetch -q origin "${ref}"
	git -C "${local_dir}" -c core.hooksPath=/dev/null checkout -q -B "${ref}" "origin/${ref}"
	bootstrap_phase2 env -u DOCKER_HOST docker --context desktop-linux
}

case "${target}" in
pc) sync_pc ;;
mac) sync_mac ;;
all)
	sync_pc
	sync_mac
	;;
*)
	echo "unknown target '${target}' (expected pc, mac, or all)" >&2
	exit 1
	;;
esac
