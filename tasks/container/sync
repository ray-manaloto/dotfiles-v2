#!/usr/bin/env bash
#MISE description="Fast-forward checkout(s) of dotfiles-v2 and apply mise dotfiles and tools inside running container(s)"
#USAGE flag "--target <target>" default="pc" help="Target environment: pc, mac, or all"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux Docker SSH host alias (for target=pc)"
set -euo pipefail

target="${usage_target:-pc}"
host="${usage_host:-pc}"
name="dotfiles-v2"

sync_pc() {
	local remote_dir
	remote_dir="$(ssh -o BatchMode=yes "${host}" 'printf "%s/dev/containers/dotfiles-v2" "$HOME"')"
	ssh -o BatchMode=yes "${host}" "git -C '${remote_dir}' fetch -q origin && git -C '${remote_dir}' merge -q --ff-only origin/main"
	DOCKER_HOST="ssh://${host}" docker exec -w /workspace "${name}" mise bootstrap --only dotfiles,tools --force-dotfiles --yes
}

sync_mac() {
	local local_dir
	if [[ "$(uname -s)" != "Darwin" ]]; then
		echo "mac Docker Desktop target must run on macOS" >&2
		exit 1
	fi

	local_dir="${HOME}/dev/containers/${name}"
	git -C "${local_dir}" fetch -q origin
	git -C "${local_dir}" merge -q --ff-only origin/main
	env -u DOCKER_HOST docker --context desktop-linux exec -w /workspace "${name}" mise bootstrap --only dotfiles,tools --force-dotfiles --yes
}

case "${target}" in
pc) sync_pc ;;
mac) sync_mac ;;
all)
	sync_pc
	sync_mac
	;;
*)
	echo "unknown target '${target}' (expected pc, mac, or all)" >&2
	exit 1
	;;
esac
