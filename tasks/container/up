#!/usr/bin/env bash
#MISE description="Build the Ubuntu 26.10 mise image with userspace Tailscale SSH, sync checkout, and start non-privileged container(s)"
#USAGE flag "--target <target>" default="pc" help="Target environment: pc, mac, or all"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux Docker SSH host alias (for target=pc)"
#USAGE flag "--tag <tag>" default="dotfiles-v2:dev" help="Docker image tag"
#USAGE flag "--ref <ref>" help="Git branch or ref to check out in container workspace (default: current branch)"
set -euo pipefail

target="${usage_target:-pc}"
host="${usage_host:-pc}"
tag="${usage_tag:-dotfiles-v2:dev}"
name="dotfiles-v2"
repo_url="https://github.com/ray-manaloto/dotfiles-v2.git"
slug_repo="ray-manaloto/dotfiles-v2"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

resolve_apt_cache_url() {
	local pc_host
	pc_host="$(ssh -G "${host}" 2>/dev/null | awk '/^hostname / {print $2; exit}')"
	[[ -n ${pc_host} ]] || return 0
	if curl -fsS --noproxy '*' --max-time 2 "http://${pc_host}:3142/healthz" >/dev/null 2>&1; then
		printf 'http://%s:3142' "${pc_host}"
	fi
}

mint_tailscale_authkey() {
	local desc="$1" payload curl_cmd resp key
	payload="$(jq -cn --arg desc "${desc}" '{
		capabilities: {
			devices: {
				create: {
					reusable: false,
					ephemeral: true,
					preauthorized: true,
					tags: ["tag:dev-env"]
				}
			}
		},
		expirySeconds: 300,
		description: $desc
	}')"
	# shellcheck disable=SC2016
	curl_cmd='curl -fsS -m 15 -X POST -H "Authorization: Bearer ${TAILSCALE_API_KEY}" -H "Content-Type: application/json" -d @- https://api.tailscale.com/api/v2/tailnet/-/keys'
	if [[ -n ${TAILSCALE_API_KEY:-} && -n ${HTTPS_PROXY:-} ]]; then
		resp="$(printf '%s' "${payload}" | /bin/bash -c "${curl_cmd}")"
	else
		resp="$(printf '%s' "${payload}" | fnox --non-interactive --config "${HOME}/.config/fnox/config.toml" proxy run -- /bin/bash -c "${curl_cmd}")"
	fi
	key="$(printf '%s' "${resp}" | jq -er '.key')"
	if [[ -z ${key} ]]; then
		echo "failed to mint Tailscale auth key for ${desc}" >&2
		return 1
	fi
	printf '%s' "${key}"
}

ensure_tailscale_container() {
	local ts_hostname="$1"
	shift
	local -a dcmd=("$@")
	local status_json state cur_hostname run_ssh key ready=0

	for _ in $(seq 1 20); do
		status_json="$("${dcmd[@]}" exec "${name}" tailscale status --json 2>/dev/null || true)"
		if [[ -n ${status_json} ]]; then
			state="$(printf '%s' "${status_json}" | jq -r '.BackendState // empty' 2>/dev/null || true)"
			if [[ -n ${state} && ${state} != "NoState" && ${state} != "Starting" ]]; then
				ready=1
				break
			fi
		fi
		sleep 1
	done
	if [[ ${ready} -ne 1 ]]; then
		echo "tailscaled did not become ready in ${name}" >&2
		return 1
	fi

	if [[ ${state} == "Running" ]]; then
		cur_hostname="$(printf '%s' "${status_json}" | jq -r '.Self.HostName // empty')"
		run_ssh="$("${dcmd[@]}" exec "${name}" tailscale debug prefs 2>/dev/null | jq -r '.RunSSH // false' 2>/dev/null || echo false)"
		if [[ ${cur_hostname} != "${ts_hostname}" || ${run_ssh} != "true" ]]; then
			"${dcmd[@]}" exec "${name}" tailscale set --ssh --hostname="${ts_hostname}" --accept-dns=false
		fi
	else
		key="$(mint_tailscale_authkey "${ts_hostname}")"
		# shellcheck disable=SC2016
		printf '%s' "${key}" | "${dcmd[@]}" exec -i "${name}" env TS_HOSTNAME="${ts_hostname}" /bin/bash -euo pipefail -c '
			keyfile="$(mktemp)"
			trap "rm -f \"\${keyfile}\"" EXIT
			chmod 0600 "${keyfile}"
			cat >"${keyfile}"
			tailscale up --auth-key="file:${keyfile}" --ssh --hostname="${TS_HOSTNAME}" --accept-dns=false --timeout=30s
		'
		unset key
	fi

	status_json="$("${dcmd[@]}" exec "${name}" tailscale status --json)"
	state="$(printf '%s' "${status_json}" | jq -r '.BackendState // empty')"
	cur_hostname="$(printf '%s' "${status_json}" | jq -r '.Self.HostName // empty')"
	if [[ ${state} != "Running" || ${cur_hostname} != "${ts_hostname}" ]]; then
		echo "unexpected Tailscale state in ${name}: BackendState=${state} HostName=${cur_hostname}" >&2
		return 1
	fi
	if ! printf '%s' "${status_json}" | jq -e '(.Self.Tags // []) | index("tag:dev-env") != null' >/dev/null; then
		echo "Tailscale node ${cur_hostname} missing tag:dev-env" >&2
		return 1
	fi
}

run_phase2_bootstrap() {
	local -a dcmd=("$@")
	# shellcheck disable=SC2016
	"${dcmd[@]}" exec -w /workspace "${name}" /bin/bash -euo pipefail -c '
		if [ -e /home/dev/.config/mise ] && [ ! -L /home/dev/.config/mise ]; then
			rm -rf /home/dev/.config/mise
		fi
		MISE_LOCKED=1 mise -E container,linux bootstrap \
			--from "$1" \
			--from-dir /workspace \
			--config-dir unix/home/.config/mise \
			--only dotfiles,tools,task \
			--force-dotfiles --yes
		MISE_YES=1 mise -C /workspace deps uv
	' bash "${repo_url}"
}

needs_recreate() {
	local want_image="$1" want_keys="$2" want_hostname="$3"
	shift 3
	local -a dcmd=("$@")
	local have_image have_secrets_src have_board_dst have_claude_dst have_opencode_dst have_zcode_dst have_ts_dst have_init have_hostname have_mise_env
	have_image="$("${dcmd[@]}" container inspect --format '{{.Image}}' "${name}" 2>/dev/null || true)"
	have_secrets_src="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/run/agent-secrets"}}{{.Source}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_board_dst="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/dev/.config/board"}}{{.Destination}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_claude_dst="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/dev/.claude"}}{{.Destination}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_opencode_dst="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/dev/.local/share/opencode"}}{{.Destination}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_zcode_dst="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/dev/.zcode"}}{{.Destination}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_ts_dst="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/dev/.local/state/tailscale"}}{{.Destination}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_init="$("${dcmd[@]}" container inspect --format '{{.HostConfig.Init}}' "${name}" 2>/dev/null || true)"
	have_hostname="$("${dcmd[@]}" container inspect --format '{{.Config.Hostname}}' "${name}" 2>/dev/null || true)"
	have_mise_env="$("${dcmd[@]}" container inspect --format '{{range .Config.Env}}{{if eq . "MISE_ENV=container"}}{{.}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	[[ ${have_image} != "${want_image}" || ${have_secrets_src} != "${want_keys}" || ${have_board_dst} != "/home/dev/.config/board" || ${have_claude_dst} != "/home/dev/.claude" || ${have_opencode_dst} != "/home/dev/.local/share/opencode" || ${have_zcode_dst} != "/home/dev/.zcode" || ${have_ts_dst} != "/home/dev/.local/state/tailscale" || ${have_init} != "true" || ${have_hostname} != "${want_hostname}" || ${have_mise_env} != "MISE_ENV=container" ]]
}

ref="$(resolve_ref)"
apt_cache_url="$(resolve_apt_cache_url || true)"
build_args=(docker build --progress=plain -t "${tag}" -f "${root}/docker/ubuntu/Dockerfile")
if [[ -n ${apt_cache_url} ]]; then
	build_args+=(--build-arg "DOTFILES_APT_CACHE=${apt_cache_url}")
fi
build_args+=("${root}")

up_pc() {
	local remote_home remote_dir keys want_image ts_hostname="${name}-pc"
	remote_home="$(ssh -o BatchMode=yes "${host}" 'printf "%s" "$HOME"')"
	remote_dir="${remote_home}/dev/containers/${name}"

	DOCKER_BUILDKIT=1 DOCKER_HOST="ssh://${host}" "${build_args[@]}"

	ssh -o BatchMode=yes "${host}" \
		"mkdir -p '${remote_home}/dev/containers' && if [ -d '${remote_dir}/.git' ]; then git -C '${remote_dir}' -c core.hooksPath=/dev/null fetch -q origin '${ref}' && git -C '${remote_dir}' -c core.hooksPath=/dev/null checkout -q -B '${ref}' 'origin/${ref}'; else git -c core.hooksPath=/dev/null clone -q -b '${ref}' '${repo_url}' '${remote_dir}'; fi"

	keys="$(ssh -o BatchMode=yes "${host}" "${remote_home}/.local/bin/agent-secrets register '${name}' '${slug_repo}'")"
	if ! ssh -o BatchMode=yes "${host}" "test -s '${keys}/claude-oauth-token'"; then
		echo "missing non-empty claude-oauth-token on ${host} at ${keys}" >&2
		exit 1
	fi

	want_image="$(DOCKER_HOST="ssh://${host}" docker image inspect --format '{{.Id}}' "${tag}")"
	if needs_recreate "${want_image}" "${keys}" "${ts_hostname}" env "DOCKER_HOST=ssh://${host}" docker; then
		DOCKER_HOST="ssh://${host}" docker rm -f "${name}" >/dev/null 2>&1 || true
		DOCKER_HOST="ssh://${host}" docker run -d \
			--init \
			--name "${name}" \
			--hostname "${ts_hostname}" \
			-e container=docker \
			-e MISE_ENV=container \
			--restart unless-stopped \
			-v "${remote_dir}:/workspace" \
			-v "${keys}:/run/agent-secrets:ro" \
			-v "${name}-board:/home/dev/.config/board" \
			-v "${name}-claude:/home/dev/.claude" \
			-v "${name}-opencode:/home/dev/.local/share/opencode" \
			-v "${name}-zcode:/home/dev/.zcode" \
			-v "${name}-tailscale:/home/dev/.local/state/tailscale" \
			"${tag}" >/dev/null
	else
		DOCKER_HOST="ssh://${host}" docker start "${name}" >/dev/null
	fi

	ensure_tailscale_container "${ts_hostname}" env "DOCKER_HOST=ssh://${host}" docker
	run_phase2_bootstrap env "DOCKER_HOST=ssh://${host}" docker
	DOCKER_HOST="ssh://${host}" docker ps --filter "name=^${name}$" --format 'pc: {{.Names}} {{.Status}} {{.Image}}'
}

up_mac() {
	local local_dir secrets_running keys want_image ts_hostname="${name}-mac"
	if [[ "$(uname -s)" != "Darwin" ]]; then
		echo "mac Docker Desktop target must run on macOS" >&2
		exit 1
	fi

	secrets_running="$(env -u DOCKER_HOST docker --context desktop-linux container inspect --format '{{.State.Running}}' agent-secrets 2>/dev/null || echo false)"
	if [[ ${secrets_running} != "true" ]]; then
		echo "agent-secrets container is not running on desktop-linux; start it before container:up --target mac" >&2
		exit 1
	fi
	keys="$(env -u DOCKER_HOST docker --context desktop-linux exec agent-secrets agent-secrets register "${name}" "${slug_repo}")"
	if [[ ! -s "${keys}/claude-oauth-token" ]]; then
		echo "missing non-empty claude-oauth-token at ${keys}" >&2
		exit 1
	fi

	local_dir="${HOME}/dev/containers/${name}"
	mkdir -p "${HOME}/dev/containers"
	if [[ -d "${local_dir}/.git" ]]; then
		git -C "${local_dir}" -c core.hooksPath=/dev/null fetch -q origin "${ref}"
		git -C "${local_dir}" -c core.hooksPath=/dev/null checkout -q -B "${ref}" "origin/${ref}"
	else
		git -c core.hooksPath=/dev/null clone -q -b "${ref}" "${repo_url}" "${local_dir}"
	fi

	DOCKER_BUILDKIT=1 env -u DOCKER_HOST docker --context desktop-linux "${build_args[@]:1}"

	want_image="$(env -u DOCKER_HOST docker --context desktop-linux image inspect --format '{{.Id}}' "${tag}")"
	if needs_recreate "${want_image}" "${keys}" "${ts_hostname}" env -u DOCKER_HOST docker --context desktop-linux; then
		env -u DOCKER_HOST docker --context desktop-linux rm -f "${name}" >/dev/null 2>&1 || true
		env -u DOCKER_HOST docker --context desktop-linux run -d \
			--init \
			--name "${name}" \
			--hostname "${ts_hostname}" \
			-e container=docker \
			-e MISE_ENV=container \
			--restart unless-stopped \
			-v "${local_dir}:/workspace" \
			-v "${keys}:/run/agent-secrets:ro" \
			-v "${name}-board:/home/dev/.config/board" \
			-v "${name}-claude:/home/dev/.claude" \
			-v "${name}-opencode:/home/dev/.local/share/opencode" \
			-v "${name}-zcode:/home/dev/.zcode" \
			-v "${name}-tailscale:/home/dev/.local/state/tailscale" \
			"${tag}" >/dev/null
	else
		env -u DOCKER_HOST docker --context desktop-linux start "${name}" >/dev/null
	fi

	ensure_tailscale_container "${ts_hostname}" env -u DOCKER_HOST docker --context desktop-linux
	run_phase2_bootstrap env -u DOCKER_HOST docker --context desktop-linux
	env -u DOCKER_HOST docker --context desktop-linux ps --filter "name=^${name}$" --format 'mac: {{.Names}} {{.Status}} {{.Image}}'
}

case "${target}" in
pc) up_pc ;;
mac) up_mac ;;
all)
	up_pc
	up_mac
	;;
*)
	echo "unknown target '${target}' (expected pc, mac, or all)" >&2
	exit 1
	;;
esac
