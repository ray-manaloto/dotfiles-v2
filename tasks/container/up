#!/usr/bin/env bash
#MISE description="Build the bare Ubuntu 26.10 mise image, sync checkout, and start non-privileged container(s)"
#USAGE flag "--target <target>" default="pc" help="Target environment: pc, mac, or all"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux Docker SSH host alias (for target=pc)"
#USAGE flag "--tag <tag>" default="dotfiles-v2:dev" help="Docker image tag"
#USAGE flag "--ref <ref>" help="Git branch or ref to check out in container workspace (default: current branch)"
set -euo pipefail

target="${usage_target:-pc}"
host="${usage_host:-pc}"
tag="${usage_tag:-dotfiles-v2:dev}"
name="dotfiles-v2"
repo_url="https://github.com/ray-manaloto/dotfiles-v2.git"
slug_repo="ray-manaloto/dotfiles-v2"
root="$(git rev-parse --show-toplevel)"

resolve_ref() {
	local r="${usage_ref:-}"
	if [[ -z ${r} ]]; then
		r="$(git -C "${root}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
		if [[ ${r} == "HEAD" || -z ${r} ]]; then
			r="main"
		fi
	fi
	if [[ ! ${r} =~ ^[A-Za-z0-9._/-]+$ ]]; then
		echo "invalid git ref '${r}'" >&2
		exit 1
	fi
	printf '%s' "${r}"
}

needs_recreate() {
	local want_image="$1" want_keys="$2"
	shift 2
	local -a dcmd=("$@")
	local have_image have_secrets_src have_claude_dst
	have_image="$("${dcmd[@]}" container inspect --format '{{.Image}}' "${name}" 2>/dev/null || true)"
	have_secrets_src="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/run/agent-secrets"}}{{.Source}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	have_claude_dst="$("${dcmd[@]}" container inspect --format '{{range .Mounts}}{{if eq .Destination "/home/dev/.claude"}}{{.Destination}}{{end}}{{end}}' "${name}" 2>/dev/null || true)"
	[[ ${have_image} != "${want_image}" || ${have_secrets_src} != "${want_keys}" || ${have_claude_dst} != "/home/dev/.claude" ]]
}

ref="$(resolve_ref)"

up_pc() {
	local remote_home remote_dir keys want_image
	remote_home="$(ssh -o BatchMode=yes "${host}" 'printf "%s" "$HOME"')"
	remote_dir="${remote_home}/dev/containers/${name}"

	DOCKER_HOST="ssh://${host}" docker build --progress=plain -t "${tag}" -f "${root}/docker/ubuntu/Dockerfile" "${root}/docker/ubuntu"

	ssh -o BatchMode=yes "${host}" \
		"mkdir -p '${remote_home}/dev/containers' && if [ -d '${remote_dir}/.git' ]; then git -C '${remote_dir}' -c core.hooksPath=/dev/null fetch -q origin '${ref}' && git -C '${remote_dir}' -c core.hooksPath=/dev/null checkout -q -B '${ref}' 'origin/${ref}'; else git -c core.hooksPath=/dev/null clone -q -b '${ref}' '${repo_url}' '${remote_dir}'; fi"

	keys="$(ssh -o BatchMode=yes "${host}" "${remote_home}/.local/bin/agent-secrets register '${name}' '${slug_repo}'")"
	if ! ssh -o BatchMode=yes "${host}" "test -s '${keys}/claude-oauth-token'"; then
		echo "missing non-empty claude-oauth-token on ${host} at ${keys}" >&2
		exit 1
	fi

	want_image="$(DOCKER_HOST="ssh://${host}" docker image inspect --format '{{.Id}}' "${tag}")"
	if needs_recreate "${want_image}" "${keys}" env "DOCKER_HOST=ssh://${host}" docker; then
		DOCKER_HOST="ssh://${host}" docker rm -f "${name}" >/dev/null 2>&1 || true
		DOCKER_HOST="ssh://${host}" docker run -d \
			--name "${name}" \
			--hostname "${name}" \
			-e container=docker \
			--restart unless-stopped \
			-v "${remote_dir}:/workspace" \
			-v "${keys}:/run/agent-secrets:ro" \
			-v "${name}-claude:/home/dev/.claude" \
			"${tag}" >/dev/null
	else
		DOCKER_HOST="ssh://${host}" docker start "${name}" >/dev/null
	fi

	DOCKER_HOST="ssh://${host}" docker ps --filter "name=^${name}$" --format 'pc: {{.Names}} {{.Status}} {{.Image}}'
}

up_mac() {
	local local_dir secrets_running keys want_image
	if [[ "$(uname -s)" != "Darwin" ]]; then
		echo "mac Docker Desktop target must run on macOS" >&2
		exit 1
	fi

	secrets_running="$(env -u DOCKER_HOST docker --context desktop-linux container inspect --format '{{.State.Running}}' agent-secrets 2>/dev/null || echo false)"
	if [[ ${secrets_running} != "true" ]]; then
		echo "agent-secrets container is not running on desktop-linux; start it before container:up --target mac" >&2
		exit 1
	fi
	keys="$(env -u DOCKER_HOST docker --context desktop-linux exec agent-secrets agent-secrets register "${name}" "${slug_repo}")"
	if [[ ! -s "${keys}/claude-oauth-token" ]]; then
		echo "missing non-empty claude-oauth-token at ${keys}" >&2
		exit 1
	fi

	local_dir="${HOME}/dev/containers/${name}"
	mkdir -p "${HOME}/dev/containers"
	if [[ -d "${local_dir}/.git" ]]; then
		git -C "${local_dir}" -c core.hooksPath=/dev/null fetch -q origin "${ref}"
		git -C "${local_dir}" -c core.hooksPath=/dev/null checkout -q -B "${ref}" "origin/${ref}"
	else
		git -c core.hooksPath=/dev/null clone -q -b "${ref}" "${repo_url}" "${local_dir}"
	fi

	env -u DOCKER_HOST docker --context desktop-linux build --progress=plain -t "${tag}" -f "${root}/docker/ubuntu/Dockerfile" "${root}/docker/ubuntu"

	want_image="$(env -u DOCKER_HOST docker --context desktop-linux image inspect --format '{{.Id}}' "${tag}")"
	if needs_recreate "${want_image}" "${keys}" env -u DOCKER_HOST docker --context desktop-linux; then
		env -u DOCKER_HOST docker --context desktop-linux rm -f "${name}" >/dev/null 2>&1 || true
		env -u DOCKER_HOST docker --context desktop-linux run -d \
			--name "${name}" \
			--hostname "${name}" \
			-e container=docker \
			--restart unless-stopped \
			-v "${local_dir}:/workspace" \
			-v "${keys}:/run/agent-secrets:ro" \
			-v "${name}-claude:/home/dev/.claude" \
			"${tag}" >/dev/null
	else
		env -u DOCKER_HOST docker --context desktop-linux start "${name}" >/dev/null
	fi

	env -u DOCKER_HOST docker --context desktop-linux ps --filter "name=^${name}$" --format 'mac: {{.Names}} {{.Status}} {{.Image}}'
}

case "${target}" in
pc) up_pc ;;
mac) up_mac ;;
all)
	up_pc
	up_mac
	;;
*)
	echo "unknown target '${target}' (expected pc, mac, or all)" >&2
	exit 1
	;;
esac
