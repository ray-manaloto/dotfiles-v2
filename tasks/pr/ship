#!/usr/bin/env bash
#MISE description="Ship the current wt/* branch per docs/pr-shipping-protocol.md: local gates, push, PR, event-driven wait for required CI, bot sweep, READY report"
#USAGE flag "--title <title>" help="PR title (only used when the branch has no open PR yet)"
#USAGE flag "--body-file <file>" help="PR body file (only used when the branch has no open PR yet)"
#USAGE flag "--skip-local-gates" help="Skip hk/doctor/py:test (already run on this exact head)"
#USAGE flag "--wait-timeout <dur>" default="10m" help="Timeout for each gh event listen wait"
#USAGE flag "--max-waits <n>" default="12" help="Maximum event waits before giving up"
# Re-runnable: every step reads current state first, so a crashed or repeated run picks up where it left off.
# It never merges. On READY it prints the owner-sanctioned merge command for the lead to run.
# Exit: 0 READY, 1 required check failed, 2 wait timed out, 3 preflight refused, 4 GitHub API unavailable.
set -euo pipefail

repo="ray-manaloto/dotfiles-v2"
author_email="1428022+sortakool@users.noreply.github.com"
wait_timeout="${usage_wait_timeout:-10m}"
max_waits="${usage_max_waits:-12}"

refuse() {
	echo "pr:ship: REFUSED: $*" >&2
	exit 3
}

# gh with retries: a transient API failure must not look like a red check or a moved head.
ghq() {
	local attempt out
	for attempt in 1 2 3; do
		if out="$(gh "$@" 2>/dev/null)"; then
			printf '%s\n' "${out}"
			return 0
		fi
		sleep $((attempt * ${PR_SHIP_RETRY_SLEEP:-5}))
	done
	echo "pr:ship: gh $1 $2 failed 3 times; GitHub API unavailable, re-run pr:ship later" >&2
	exit 4
}

# 1. Preflight: a clean wt/* branch, never main, nothing unpushed-but-uncommitted.
branch="$(git rev-parse --abbrev-ref HEAD)"
[[ ${branch} == wt/* ]] || refuse "branch '${branch}' is not a wt/* branch"
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || refuse "uncommitted tracked changes; commit them first"
auto_merge="$(ghq api "repos/${repo}" --jq .allow_auto_merge)"
[[ ${auto_merge} == "false" ]] || refuse "repo allow_auto_merge is on; it would bypass the gates"

# 2. Local gates on the exact head (Stage 1/2 receipts are enforced by the pre-push hook).
if [[ -z ${usage_skip_local_gates:-} ]]; then
	hk check --all
	DOTFILES_DOCTOR_SCOPE=repo mise doctor project </dev/null
	MISE_YES=1 mise run -q py:test </dev/null
fi
head="$(git rev-parse HEAD)"

# 3. Push (pre-push hook runs the review guard and doctor) and find or open the PR.
git push origin "HEAD:refs/heads/${branch}"
pr="$(ghq pr list -R "${repo}" --head "${branch}" --state open --json number --jq '.[0].number // empty')"
if [[ -z ${pr} ]]; then
	[[ -n ${usage_title:-} && -n ${usage_body_file:-} ]] || refuse "no open PR for ${branch}; pass --title and --body-file to open one"
	gh pr create -R "${repo}" --base main --head "${branch}" --title "${usage_title}" --body-file "${usage_body_file}" >/dev/null
	pr="$(ghq pr list -R "${repo}" --head "${branch}" --state open --json number --jq '.[0].number')"
fi
url="https://github.com/${repo}/pull/${pr}"
pr_auto="$(ghq pr view "${pr}" -R "${repo}" --json autoMergeRequest --jq '.autoMergeRequest != null')"
[[ ${pr_auto} == "false" ]] || refuse "auto-merge is set on #${pr}; disable it (gh pr merge --disable-auto)"
echo "pr:ship: #${pr} head ${head:0:7} ${url}"

# 4. Event-driven wait: read state, then listen; events are not replayed, so always re-read after each wait.
# bash 3.2 (macOS /bin/bash) has no mapfile.
# Assign first: a failure inside a process substitution would not stop the script.
rules="$(ghq api "repos/${repo}/rules/branches/main" --jq '.[]|select(.type=="required_status_checks")|.parameters.required_status_checks[].context')"
required=()
while IFS= read -r ctx; do
	[[ -n ${ctx} ]] && required+=("${ctx}")
done <<<"${rules}"
((${#required[@]} > 0)) || refuse "could not read required checks for main from the ruleset"
state() {
	ghq api "repos/${repo}/commits/${head}/check-runs?per_page=100" --jq '.check_runs[]|"\(.name)\t\(.status)\t\(.conclusion // "")"'
}
verdict=""
# max_waits waits, plus one final read after the last wait so a result that lands then is not reported as a timeout.
for ((i = 0; i <= max_waits; i++)); do
	runs="$(state)"
	done_n=0
	failed=""
	for name in "${required[@]}"; do
		# Exact name match on the first field; the API lists the newest run of a re-run check first.
		line="$(awk -F '\t' -v n="${name}" '$1 == n { print; exit }' <<<"${runs}")"
		[[ ${line} == *$'\tcompleted\t'* ]] || continue
		done_n=$((done_n + 1))
		[[ ${line} == *$'\tcompleted\tsuccess' ]] || failed+="${name}; "
	done
	echo "pr:ship: required ${done_n}/${#required[@]} complete${failed:+, failed: ${failed}}"
	if [[ -n ${failed} ]]; then
		verdict="RED"
		break
	fi
	if ((done_n == ${#required[@]})); then
		verdict="GREEN"
		break
	fi
	((i < max_waits)) || break
	rc=0
	gh event listen --resource "${url}" \
		--event com.github.pull_request.check_suite.status.changed.v1,com.github.pull_request.head.changed.v1,com.github.pull_request.state.changed.v1 \
		--timeout "${wait_timeout}" >/dev/null 2>&1 || rc=$?
	if ((rc != 0 && rc != 8)); then
		echo "pr:ship: gh event listen exited ${rc} (event streams unavailable?); falling back to a 60s re-read" >&2
		sleep 60
	fi
	pr_head="$(ghq pr view "${pr}" -R "${repo}" --json headRefOid --jq .headRefOid)"
	[[ ${pr_head} == "${head}" ]] || refuse "PR head moved off ${head:0:7}; re-run pr:ship"
done

# 5. Bot sweep (advisory: bots review once and may be quota-limited; the lead reads and fixes real findings).
echo "pr:ship: bot line comments on #${pr} (read each; fix real findings):"
if ! gh api --paginate "repos/${repo}/pulls/${pr}/comments?per_page=100" \
	--jq '.[]|select(.user.type=="Bot")|"  \(.user.login) @\(.commit_id[0:7]) \(.path):\(.line // .original_line) \(.html_url)"' 2>/dev/null; then
	echo "pr:ship: WARNING: bot comment sweep failed; read the PR's comments manually" >&2
fi

case "${verdict}" in
GREEN)
	echo "pr:ship: READY #${pr} at ${head:0:7}. Re-run hk on this exact head, then merge with:"
	echo "  gh pr merge ${pr} -R ${repo} --merge --match-head-commit ${head} --author-email ${author_email}"
	;;
RED)
	echo "pr:ship: RED: fix, re-gate, commit, and re-run pr:ship" >&2
	exit 1
	;;
*)
	echo "pr:ship: TIMEOUT after ${max_waits} waits; re-run pr:ship to resume" >&2
	exit 2
	;;
esac
