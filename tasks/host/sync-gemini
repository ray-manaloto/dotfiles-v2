#!/usr/bin/env bash
#MISE description="Sync or verify unix/home/.gemini/config/ hooks/rules/hooks.json and unix/home/.agents/skills/ across ~/.agents and ~/.claude (retiring legacy ~/.gemini/config/skills and ~/.zcode/skills mirrors)"
#USAGE flag "--check" help="Verify local ~/.gemini/config/, ~/.agents/skills/, and ~/.claude/skills/ match repo (and legacy mirrors are retired) without modifying files"
set -euo pipefail

check_mode="${usage_check:-false}"
exec python3 - "${check_mode}" <<'PY'
import errno
import fnmatch
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

check_only = sys.argv[1].strip().lower() in {"1", "true", "yes"}

def git_path(*args: str) -> Path:
    out = subprocess.check_output(["git", *args], text=True).strip()
    return Path(out)

try:
    import tomllib
except ImportError:
    print("host:sync-gemini requires Python >= 3.11 (tomllib)", file=sys.stderr)
    sys.exit(1)

repo_root = git_path("rev-parse", "--show-toplevel").resolve()
common_dir = git_path("rev-parse", "--git-common-dir")
if not common_dir.is_absolute():
    common_dir = (Path.cwd() / common_dir).resolve()
else:
    common_dir = common_dir.resolve()
main_root = common_dir.parent if common_dir.name == ".git" else repo_root

src_cfg = repo_root / "unix" / "home" / ".gemini" / "config"
main_src_cfg = main_root / "unix" / "home" / ".gemini" / "config"
src_skills = repo_root / "unix" / "home" / ".agents" / "skills"
main_src_skills = main_root / "unix" / "home" / ".agents" / "skills"

mise_dir = repo_root / "unix" / "home" / ".config" / "mise"
mise_cfg_path = mise_dir / "config.toml"
parsed = tomllib.loads(mise_cfg_path.read_text(encoding="utf-8"))
dotfiles_tbl = parsed.get("dotfiles", {})
groups_tbl = parsed.get("dotfile_groups", {})

managed_rels: list[str] = []
for sub in ("hooks", "rules"):
    base = src_cfg / sub
    if not base.is_dir():
        continue
    for p in sorted(base.rglob("*")):
        if not p.is_file():
            continue
        if "__pycache__" in p.parts or p.suffix == ".pyc" or p.name in {".DS_Store", "ruff.toml"}:
            continue
        managed_rels.append(p.relative_to(src_cfg).as_posix())

skill_names: list[str] = []
if src_skills.is_dir():
    for entry in sorted(src_skills.iterdir()):
        if entry.is_dir() and (entry / "SKILL.md").is_file():
            skill_names.append(entry.name)

def _group_covers_symlink_each(group_name: str, expected_root: str, expected_target: str, rel_subpath: str) -> bool:
    grp = groups_tbl.get(group_name)
    if not isinstance(grp, dict):
        return False
    if grp.get("root") != expected_root or grp.get("target") != expected_target:
        return False
    if grp.get("mode", "symlink-each") != "symlink-each":
        return False
    excludes = grp.get("exclude") or []
    return not any(
        fnmatch.fnmatch(rel_subpath, pat) or fnmatch.fnmatch(Path(rel_subpath).name, pat)
        for pat in excludes
        if isinstance(pat, str)
    )

def _skill_registered(sk: str) -> bool:
    key = f"~/.agents/skills/{sk}"
    if key in dotfiles_tbl:
        return True
    grp = groups_tbl.get("agents-skills")
    if not isinstance(grp, dict):
        return False
    entries = grp.get("entries")
    if isinstance(entries, dict):
        spec = entries.get(key)
        return (
            isinstance(spec, dict)
            and spec.get("enabled") is not False
            and spec.get("mode") == "symlink"
        )
    return _group_covers_symlink_each("agents-skills", ".agents/skills", "~/.agents/skills", sk)

missing_dotfiles: list[str] = []
for rel in managed_rels:
    key = f"~/.gemini/config/{rel}"
    if key in dotfiles_tbl:
        continue
    sub, _, rest = rel.partition("/")
    if sub == "hooks" and _group_covers_symlink_each("gemini-hooks", ".gemini/config/hooks", "~/.gemini/config/hooks", rest):
        continue
    if sub == "rules" and _group_covers_symlink_each("gemini-rules", ".gemini/config/rules", "~/.gemini/config/rules", rest):
        continue
    missing_dotfiles.append(key)

for key in (
    "~/.gemini/config/hooks.json/dotfiles-v2",
    "~/.gemini/antigravity-cli/settings.json/orchestrator-neon",
    "~/.gemini/config/AGENTS.md",
):
    if key not in dotfiles_tbl:
        missing_dotfiles.append(key)
if "~/.gemini/config/skills" in dotfiles_tbl:
    missing_dotfiles.append("~/.gemini/config/skills (retired: remove from [dotfiles])")

for sk in skill_names:
    if not _skill_registered(sk):
        missing_dotfiles.append(f"~/.agents/skills/{sk}")

if missing_dotfiles:
    print(
        "Unregistered entries in unix/home/.config/mise/config*.toml ([dotfiles]/[dotfile_groups]): "
        + ", ".join(missing_dotfiles),
        file=sys.stderr,
    )
    sys.exit(1)

if os.environ.get("CI") and check_only:
    sys.exit(0)

host_home = Path.home()
host_cfg = host_home / ".gemini" / "config"
host_agents_skills = host_home / ".agents" / "skills"
host_claude_skills = host_home / ".claude" / "skills"
host_zcode_skills = host_home / ".zcode" / "skills"
repo_hooks_path = src_cfg / "hooks.json"
repo_hooks = json.loads(repo_hooks_path.read_text(encoding="utf-8"))
host_hooks_path = host_cfg / "hooks.json"

def _is_legacy_gemini_skill_target(raw_target: str, resolved_target: Path) -> bool:
    markers = ("/.agents/skills/", "../../.agents/skills/", "/mise/installs/")
    norm_raw = raw_target.replace("\\", "/")
    norm_res = str(resolved_target).replace("\\", "/")
    if any(m in norm_raw or m in norm_res for m in markers):
        return True
    agents_root = str(host_agents_skills.resolve(strict=False))
    return norm_res == agents_root or norm_res.startswith(agents_root + "/")


def _is_legacy_gemini_md_target(raw_target: str, resolved_target: Path) -> bool:
    norm = f"{raw_target} {resolved_target}".replace("\\", "/")
    return any(
        tok in norm
        for tok in ("/.agents/AGENTS.md", "/.gemini/config/AGENTS.md", "dotfiles-v2")
    )


if check_only:
    errors: list[str] = []
    for rel in managed_rels:
        dst = host_cfg / rel
        allowed_srcs = {(src_cfg / rel).resolve(), (main_src_cfg / rel).resolve()}
        if not dst.exists():
            errors.append(f"missing {dst}")
            continue
        if dst.resolve() not in allowed_srcs:
            errors.append(f"drifted symlink {dst} -> {dst.resolve()}")

    legacy_gemini_md = host_home / ".gemini" / "GEMINI.md"
    if legacy_gemini_md.is_symlink() and _is_legacy_gemini_md_target(
        os.readlink(legacy_gemini_md), legacy_gemini_md.resolve(strict=False)
    ):
        errors.append(f"legacy symlink {legacy_gemini_md} still present")

    gemini_skills = host_cfg / "skills"
    if gemini_skills.is_symlink():
        if _is_legacy_gemini_skill_target(
            os.readlink(gemini_skills), gemini_skills.resolve(strict=False)
        ):
            errors.append(
                f"legacy {gemini_skills} still present (agy discovers ~/.agents/skills natively)"
            )
    elif gemini_skills.is_dir():
        for child in sorted(gemini_skills.iterdir()):
            if child.name == ".DS_Store":
                continue
            if child.is_symlink() and _is_legacy_gemini_skill_target(
                os.readlink(child), child.resolve(strict=False)
            ):
                errors.append(f"legacy {child} still present (agy discovers ~/.agents/skills natively)")
            elif child.is_dir():
                sub = [c.name for c in child.iterdir() if c.name != ".DS_Store"]
                if (
                    sub == ["SKILL.md"]
                    and (child / "SKILL.md").is_symlink()
                    and _is_legacy_gemini_skill_target(
                        os.readlink(child / "SKILL.md"),
                        (child / "SKILL.md").resolve(strict=False),
                    )
                ):
                    errors.append(
                        f"legacy {child} still present (agy discovers ~/.agents/skills natively)"
                    )
    if host_claude_skills.is_symlink():
        errors.append(f"{host_claude_skills} must be a real directory, not a symlink")
    if host_zcode_skills.is_symlink():
        if host_zcode_skills.resolve(strict=False) == host_agents_skills.resolve(strict=False):
            errors.append(
                f"stale zcode skill root symlink {host_zcode_skills} (zcode reads ~/.agents/skills natively)"
            )
    elif host_zcode_skills.is_dir():
        for stale in sorted(host_zcode_skills.iterdir()):
            if stale.is_symlink() and os.readlink(stale) == f"../../.agents/skills/{stale.name}":
                errors.append(f"stale zcode skill mirror {stale} (zcode reads ~/.agents/skills natively)")

    for sk in skill_names:
        allowed_skill_srcs = {(src_skills / sk).resolve(), (main_src_skills / sk).resolve()}
        for root_dir in (host_agents_skills, host_claude_skills):
            dst = root_dir / sk
            if not dst.is_symlink():
                errors.append(f"missing or non-symlink skill dir {dst}")
                continue
            if dst.resolve(strict=False) not in allowed_skill_srcs:
                errors.append(f"drifted skill symlink {dst} -> {dst.resolve(strict=False)}")

    if not host_hooks_path.is_file():
        errors.append(f"missing {host_hooks_path}")
    else:
        try:
            host_hooks = json.loads(host_hooks_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            errors.append(f"invalid JSON in {host_hooks_path}: {exc}")
        else:
            for key, expected_val in repo_hooks.items():
                if host_hooks.get(key) != expected_val:
                    errors.append(f"hooks.json key mismatch for '{key}' in {host_hooks_path}")

    if errors:
        for err in errors:
            print(f"FAIL  {err}", file=sys.stderr)
        sys.exit(1)
    print(
        f"OK: {len(managed_rels)} ~/.gemini/config file(s), {len(skill_names)} canonical skill dir(s), "
        f"and {len(repo_hooks)} hooks.json key(s) synced"
    )
    sys.exit(0)

linked = 0
for rel in managed_rels:
    src = (src_cfg / rel).resolve()
    dst = host_cfg / rel
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.is_symlink():
        if dst.resolve(strict=False) == src:
            continue
        dst.unlink()
    elif dst.exists():
        dst.unlink()
    os.symlink(src, dst)
    linked += 1

host_agents_skills.mkdir(parents=True, exist_ok=True)
if host_claude_skills.is_symlink():
    if host_claude_skills.resolve(strict=False) == host_agents_skills.resolve(strict=False):
        host_claude_skills.unlink()
    else:
        raise RuntimeError(
            f"Refusing to replace symlink {host_claude_skills} -> {os.readlink(host_claude_skills)}"
        )
host_claude_skills.mkdir(parents=True, exist_ok=True)

# Retire recognized legacy ~/.gemini/GEMINI.md symlinks without touching regular user files.
legacy_gemini_md = host_home / ".gemini" / "GEMINI.md"
if legacy_gemini_md.is_symlink() and _is_legacy_gemini_md_target(
    os.readlink(legacy_gemini_md), legacy_gemini_md.resolve(strict=False)
):
    legacy_gemini_md.unlink()

# Retire only recognized legacy ~/.gemini/config/skills mirrors (agy 1.5.16 reads ~/.agents/skills natively).
gemini_skills = host_cfg / "skills"
if gemini_skills.is_symlink():
    if _is_legacy_gemini_skill_target(
        os.readlink(gemini_skills), gemini_skills.resolve(strict=False)
    ):
        gemini_skills.unlink()
    else:
        raise RuntimeError(
            f"Refusing to remove custom symlink {gemini_skills} -> {os.readlink(gemini_skills)}"
        )
elif gemini_skills.is_dir():
    non_legacy = []
    for child in sorted(gemini_skills.iterdir()):
        if child.name == ".DS_Store":
            child.unlink()
            continue
        if child.is_symlink() and _is_legacy_gemini_skill_target(
            os.readlink(child), child.resolve(strict=False)
        ):
            child.unlink()
            continue
        if child.is_dir() and not child.is_symlink():
            ds = child / ".DS_Store"
            if ds.is_file():
                ds.unlink()
            sub = [c.name for c in child.iterdir()]
            if (
                sub == ["SKILL.md"]
                and (child / "SKILL.md").is_symlink()
                and _is_legacy_gemini_skill_target(
                    os.readlink(child / "SKILL.md"),
                    (child / "SKILL.md").resolve(strict=False),
                )
            ):
                shutil.rmtree(child)
                continue
        non_legacy.append(child.name)
    if non_legacy:
        raise RuntimeError(
            f"Refusing to delete non-legacy entries in {gemini_skills}: {', '.join(sorted(non_legacy))}"
        )
    try:
        gemini_skills.rmdir()
    except OSError as exc:
        if exc.errno not in {errno.ENOTEMPTY, errno.EEXIST}:
            raise
elif gemini_skills.exists():
    raise RuntimeError(f"Refusing to remove non-legacy file {gemini_skills}")

# Retire ~/.zcode/skills mirrors created by earlier bootstrap:skills runs (zcode reads ~/.agents/skills).
zcode_retired = 0
if host_zcode_skills.is_symlink():
    if host_zcode_skills.resolve(strict=False) == host_agents_skills.resolve(strict=False):
        host_zcode_skills.unlink()
        zcode_retired += 1
elif host_zcode_skills.is_dir():
    for stale in sorted(host_zcode_skills.iterdir()):
        if stale.is_symlink() and os.readlink(stale) == f"../../.agents/skills/{stale.name}":
            stale.unlink()
            zcode_retired += 1
    try:
        host_zcode_skills.rmdir()
    except OSError as exc:
        if exc.errno not in {errno.ENOTEMPTY, errno.EEXIST}:
            raise

def link_skill_dir(src: Path, dst: Path, *, raw_target: str | None = None) -> int:
    target = raw_target or str(src)
    if dst.is_symlink():
        if os.readlink(dst) == target and dst.resolve(strict=False) == src:
            return 0
        dst.unlink()
    elif dst.is_dir():
        children = [c.name for c in dst.iterdir() if c.name != ".DS_Store"]
        skill_md = dst / "SKILL.md"
        if children == ["SKILL.md"] and skill_md.is_symlink():
            shutil.rmtree(dst)
        else:
            raise RuntimeError(f"Refusing to overwrite non-legacy directory {dst}")
    elif dst.exists():
        dst.unlink()
    os.symlink(target, dst)
    return 1

skills_linked = 0
for sk in skill_names:
    src = (src_skills / sk).resolve()
    skills_linked += link_skill_dir(src, host_agents_skills / sk)
    skills_linked += link_skill_dir(src, host_claude_skills / sk, raw_target=f"../../.agents/skills/{sk}")

host_cfg.mkdir(parents=True, exist_ok=True)
host_hooks = {}
if host_hooks_path.is_file():
    host_hooks = json.loads(host_hooks_path.read_text(encoding="utf-8"))

hooks_changed = False
for key, val in repo_hooks.items():
    if host_hooks.get(key) != val:
        host_hooks[key] = val
        hooks_changed = True

if hooks_changed or not host_hooks_path.is_file():
    host_hooks_path.write_text(json.dumps(host_hooks, indent=2) + "\n", encoding="utf-8")

print(
    f"Synced {len(managed_rels)} ~/.gemini/config file(s) ({linked} updated), "
    f"{len(skill_names)} canonical skill dir(s) ({skills_linked} link(s) updated, "
    f"{zcode_retired} legacy zcode mirror(s) retired), "
    f"and {len(repo_hooks)} hooks.json key(s) (changed={hooks_changed})"
)
PY
