#!/usr/bin/env -S usage exec bash
# shellcheck shell=bash
#MISE description="Check pc bootstrap drift, runtime guards, and Option A host configuration"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux SSH host alias"
#USAGE flag "--dry-run" help="Describe the checks without connecting"
set -euo pipefail

host="${usage_host:-pc}"
if [[ ${usage_dry_run:-false} == true ]]; then
	echo "pc:doctor dry-run ($host): check bootstrap drift, kernel, container privilege, GPU CDI, pending updates, firewall, mise, stale mise shims, Tailscale, zsh, and fnox"
	exit 0
fi
taskdir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
result=0
ssh -o BatchMode=yes -- "$host" /usr/bin/python3 -I -B - <"$taskdir/../py/pc_stack_doctor.py" || result=1
ssh -o BatchMode=yes -- "$host" /bin/bash -euo pipefail <<'REMOTE' || result=1
export MISE_AUTO_INSTALL=0
config="$HOME/.config/mise"
[[ -L $config && $config -ef "$HOME/dev/dotfiles-v2/unix/home/.config/mise" ]]
login_shell=$(getent passwd "$(id -un)" | cut -d: -f7)
[[ ${login_shell##*/} == zsh ]]
cd "$HOME"
env -u MISE_ENV -u ZDOTDIR -u MISE_SYSTEM_CONFIG_DIR zsh -l -e -s <<'ZSH'
[[ $MISE_ENV == linux,pc && $ZDOTDIR == "$HOME/.config/zsh" && $MISE_SYSTEM_CONFIG_DIR == /nonexistent ]]
[[ $(command -v mise) -ef /usr/local/bin/mise ]]
[[ $(mise --version) == 2026.11.14\ * ]]
[[ $(mise settings get upgrade.auto_prune) == true ]]
[[ $(mise settings get upgrade.prune_after) == 24h ]]
version=$(/usr/bin/tailscale version)
version=${version%%$'\n'*}
result=0
for shim in "${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"/shims/*(N); do
	if [[ -L $shim && $shim -ef /usr/local/bin/mise && ${shim:t} != mise ]] &&
		! mise which "${shim:t}" >/dev/null 2>&1; then
		printf 'FAIL  mise shim: %s does not resolve (run mise reshim)\n' "${shim:t}" >&2
		result=1
	fi
done
if [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && printf '%s\n' 1.104.4 "$version" | sort -VC; then
	printf 'PASS  tailscale: %s\n' "$version"
else
	printf 'FAIL  tailscale: %s (requires at least 1.104.4)\n' "$version" >&2
	result=1
fi
[[ "$HOME/.config/fnox/config.toml" -ef "$HOME/.config/fnox/config.headless.toml" ]]
if [[ -s "$HOME/.config/fnox/age.txt" ]]; then
	unset FNOX_AGE_KEY
	mise exec -- fnox --non-interactive --no-daemon -P infra --no-defaults check --all --strict
else
	echo 'FAIL  fnox-age: missing or empty ~/.config/fnox/age.txt' >&2
	result=1
fi
exit "$result"
ZSH
REMOTE
if ((result)); then
	echo "FAIL  pc:doctor ($host)" >&2
	exit "$result"
fi
echo "PASS  pc:doctor ($host)"
