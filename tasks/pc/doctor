#!/usr/bin/env -S usage exec bash
# shellcheck shell=bash
#MISE description="Check pc bootstrap drift, runtime guards, and Option A host configuration"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux SSH host alias"
#USAGE flag "--dry-run" help="Describe the checks without connecting"
set -euo pipefail

host="${usage_host:-pc}"
if [[ ${usage_dry_run:-false} == true ]]; then
	echo "pc:doctor dry-run ($host): check bootstrap drift, kernel, container privilege, GPU CDI, pending updates, firewall, mise, stale mise shims, Tailscale, zsh, and fnox"
	exit 0
fi
taskdir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
result=0
ssh -o BatchMode=yes -- "$host" /usr/bin/python3 -I -B - <"$taskdir/../py/pc_stack_doctor.py" || result=1
ssh -o BatchMode=yes -- "$host" /bin/bash -euo pipefail <<'REMOTE' || result=1
export MISE_AUTO_INSTALL=0
config="$HOME/.config/mise"
[[ -L $config && $config -ef "$HOME/dev/dotfiles-v2/unix/home/.config/mise" ]]
login_shell=$(getent passwd "$(id -un)" | cut -d: -f7)
[[ ${login_shell##*/} == zsh ]]
cd "$HOME"
env -u MISE_ENV -u ZDOTDIR -u MISE_SYSTEM_CONFIG_DIR zsh -l -e -s <<'ZSH'
[[ $MISE_ENV == linux,pc && $ZDOTDIR == "$HOME/.config/zsh" && $MISE_SYSTEM_CONFIG_DIR == /nonexistent ]]
[[ $(command -v mise) -ef /usr/local/bin/mise ]]
[[ $(mise --version) == 2026.11.14\ * ]]
[[ $(mise settings get upgrade.auto_prune) == true ]]
[[ $(mise settings get upgrade.prune_after) == 24h ]]
version=$(/usr/bin/tailscale version)
version=${version%%$'\n'*}
result=0
# Pinned Omarchy channel; keep in sync with tasks/pc/up.
channel=$(OMARCHY_PATH=/usr/share/omarchy omarchy-channel-current 2>/dev/null || echo unknown)
if [[ $channel == rc ]]; then
	printf 'PASS  omarchy-channel: %s\n' "$channel"
else
	printf 'FAIL  omarchy-channel: %s (pinned rc; run: OMARCHY_PATH=/usr/share/omarchy omarchy-channel-set rc)\n' "$channel" >&2
	result=1
fi
# A shim is dead when no installed tool ships that bin. `mise which` cannot tell: a shim's own
# presence makes mise call the name "a mise bin", so the installs tree is the ground truth.
mise_data="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
typeset -A installed_bins
for bin in "$mise_data"/installs/*/*/{bin/,*/bin/,*/,.mise-bins/,node_modules/.bin/,}*(N-*); do
	installed_bins[${bin:t}]=1
done
for shim in "$mise_data"/shims/*(N@); do
	if [[ ${shim:A:t} == mise && ${shim:t} != mise && -z ${installed_bins[${shim:t}]-} ]]; then
		printf 'FAIL  mise shim: %s has no installed tool (run mise reshim --force)\n' "${shim:t}" >&2
		result=1
	fi
done
if [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && printf '%s\n' 1.104.4 "$version" | sort -VC; then
	printf 'PASS  tailscale: %s\n' "$version"
else
	printf 'FAIL  tailscale: %s (requires at least 1.104.4)\n' "$version" >&2
	result=1
fi
[[ "$HOME/.config/fnox/config.toml" -ef "$HOME/.config/fnox/config.pc.toml" ]]
# fnox reads Doppler config `pc` through the Doppler CLI's stored read-only service token (no age key).
identity=$(cd ~ && env -u DOPPLER_TOKEN mise exec doppler -- doppler me --json 2>/dev/null | jq -r '"\(.type) \(.name)"' 2>/dev/null)
if [[ $identity == "service_token "* ]]; then
	printf 'PASS  doppler-login: %s\n' "$identity"
	unset FNOX_AGE_KEY FNOX_AGE_KEY_FILE
	mise exec -- fnox --non-interactive --no-daemon -P infra --no-defaults check --all --strict
else
	printf 'FAIL  doppler-login: %s (store the pc-fnox read token: doppler configure set token --scope ~)\n' "${identity:-none}" >&2
	result=1
fi
for key in age.txt age.pc.txt; do
	[[ -e "$HOME/.config/fnox/$key" ]] && printf 'WARN  fnox-age: ~/.config/fnox/%s is no longer used; remove it\n' "$key" >&2
done
exit "$result"
ZSH
REMOTE
if ((result)); then
	echo "FAIL  pc:doctor ($host)" >&2
	exit "$result"
fi
echo "PASS  pc:doctor ($host)"
