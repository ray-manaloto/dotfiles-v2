#!/usr/bin/env -S usage exec bash
# shellcheck shell=bash
#MISE description="Provision standalone mise and sync Option A on the remote Linux host"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux SSH host alias"
#USAGE flag "--dry-run" help="Describe provisioning without connecting"
#USAGE flag "--upgrade-omarchy" default="false" help="Authorize an Omarchy system update before provisioning"
set -euo pipefail

host="${usage_host:-pc}"
upgrade="${usage_upgrade_omarchy:-false}"
if [[ ${usage_dry_run:-false} == true ]]; then
	echo "pc:up dry-run ($host): install pinned mise via packslip and run pc:sync"
	if [[ $upgrade == true ]]; then
		echo "Requested Omarchy update: OMARCHY_PATH=/usr/share/omarchy omarchy update -y"
	fi
	exit 0
fi

if [[ $upgrade == true ]]; then
	ssh -n -o BatchMode=yes -- "$host" 'OMARCHY_PATH=/usr/share/omarchy omarchy update -y'
fi
ssh -o BatchMode=yes -- "$host" /bin/bash -euo pipefail <<'REMOTE'
[[ $(uname -sm) == "Linux x86_64" ]]
MISE_VER="2026.11.14"
PACKSLIP_VER="v1.11.5"
PACKSLIP_SHA256_LINUX_X64="926bdf0536385f017321ac06d046edde21d624e1a2f9871545b3b14ecfeb1364"
PACKSLIP_MISE_PIN="ps1_nlhmwtfeufglxv5myvwvronk7a"
if [[ ! -x /usr/local/bin/mise || $(/usr/local/bin/mise --version | awk '{print $1}') != "$MISE_VER" ]]; then
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	curl -fsSLo "$tmp/packslip" "https://github.com/jdx/packslip/releases/download/$PACKSLIP_VER/packslip-$PACKSLIP_VER-linux-x64"
	printf '%s  %s\n' "$PACKSLIP_SHA256_LINUX_X64" "$tmp/packslip" | sha256sum -c -
	chmod 0755 "$tmp/packslip"
	sudo -n "$tmp/packslip" install github.com/jdx/mise --version "$MISE_VER" \
		--pin "$PACKSLIP_MISE_PIN" --system --bin-dir /usr/local/bin --force
fi
REMOTE
exec mise run pc:sync --host "$host"
