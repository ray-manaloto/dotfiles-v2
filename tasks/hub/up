#!/usr/bin/env bash
#MISE description="Idempotently deploy and start pc Hub (Compose Caddy+Beszel+SearXNG+Valkey+socket-proxy, systemd board/agentsview/qmd, CLI-only codebase-memory-mcp, tailscale serve)"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux hub SSH host alias"
#USAGE flag "--caddy-port <port>" default="8880" help="Loopback HTTP port for Caddy front door on pc"
#USAGE flag "--beszel-email <email>" help="Optional initial Beszel user email matching Tailscale-User-Login"
#USAGE flag "--mac-ssh <dest>" help="Optional Mac SSH destination (an ssh alias from hub:mac-pull-key) for pc agentsview [[remote_hosts]] pull sync"
#USAGE flag "--mac-interval <duration>" default="15m" help="How often the hub pulls the Mac when --mac-ssh is set"
#USAGE flag "--skip-systemd" help="Skip systemd --user unit installation/reload on pc"
#USAGE flag "--dry-run" help="Validate configs and print planned remote steps without mutating pc"
set -euo pipefail

host="${usage_host:-pc}"
caddy_port="${usage_caddy_port:-8880}"
beszel_email="${usage_beszel_email:-}"
mac_ssh="${usage_mac_ssh:-}"
mac_interval="${usage_mac_interval:-15m}"
printf '%s' "${mac_interval}" | grep -qxE '[1-9][0-9]*(s|m|h)' || {
	echo "hub:up: --mac-interval must look like 15m" >&2
	exit 1
}
skip_systemd="${usage_skip_systemd:-false}"
dry_run="${usage_dry_run:-false}"

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
repo_root="$(cd "${script_dir}/../.." && pwd -P)"
lib_dir="${repo_root}/unix/home/.config/mise/lib"

venv_py="${repo_root}/.venv/bin/python"
if [[ ! -x ${venv_py} ]] && command -v git >/dev/null 2>&1; then
	common_dir="$(git -C "${repo_root}" rev-parse --git-common-dir 2>/dev/null || true)"
	if [[ -n ${common_dir} ]]; then
		if [[ ${common_dir} != /* ]]; then
			common_dir="${repo_root}/${common_dir}"
		fi
		common_root="$(cd "${common_dir}/.." 2>/dev/null && pwd -P || true)"
		if [[ -n ${common_root} && -x "${common_root}/.venv/bin/python" ]]; then
			venv_py="${common_root}/.venv/bin/python"
		fi
	fi
fi
if [[ ! -x ${venv_py} ]]; then
	echo "hub:up: missing .venv/bin/python; run 'mise deps uv'" >&2
	exit 1
fi

"${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from pc_hub.cli import main; raise SystemExit(main(sys.argv[2:]))' "${lib_dir}" validate --repo "${repo_root}"

if [[ ${dry_run} == "true" ]]; then
	printf 'DRY-RUN hub:up host=%s caddy_port=%s skip_systemd=%s\n' "${host}" "${caddy_port}" "${skip_systemd}"
	printf '  1. Stage docker/pc-hub/{compose.yaml,Caddyfile,searxng/settings.yml} to ~/.local/state/pc-hub/stack on %s\n' "${host}"
	printf '  2. Ensure runtime secrets, @tobilu/qmd@2.9.0, agentsview, and CLI-only codebase-memory-mcp 0.12.1 on %s\n' "${host}"
	printf '  3. Run docker compose up -d --remove-orphans (beszel 0.21.2, caddy 2.11.9-alpine, docker-socket-proxy POST=0, searxng, valkey)\n'
	printf '  4. Install/enable systemd --user units (vercel-board, agentsview-hub, qmd-hub, ollama-hub) and tailscale serve --bg http://127.0.0.1:%s\n' "${caddy_port}"
	exit 0
fi

remote_home="$(ssh -o BatchMode=yes "${host}" 'printf "%s" "$HOME"')"
ts_host="$(ssh -o BatchMode=yes "${host}" 'tailscale status --json | jq -er ".Self.DNSName // empty | sub(\"\\\\.$\"; \"\")"')"
if [[ -z ${ts_host} ]]; then
	echo "hub:up: failed to resolve Tailscale DNSName on ${host}" >&2
	exit 1
fi

state_dir="${remote_home}/.local/state/pc-hub"
stack_dir="${state_dir}/stack"

ssh -o BatchMode=yes "${host}" "mkdir -p '${stack_dir}/searxng' '${state_dir}/beszel_data' '${state_dir}/beszel_agent_data' '${remote_home}/.config/board' '${remote_home}/.config/agentsview' '${remote_home}/.local/bin' '${remote_home}/.agentsview' && chmod 0700 '${state_dir}' '${remote_home}/.config/board' '${remote_home}/.config/agentsview'"
COPYFILE_DISABLE=1 tar -C "${repo_root}/docker/pc-hub" -cf - compose.yaml Caddyfile searxng/settings.yml | ssh -o BatchMode=yes "${host}" "tar -C '${stack_dir}' -xf - && find '${stack_dir}' -maxdepth 2 -name '._*' -type f -delete"

# Mint/preserve runtime tokens and Beszel ed25519 keypair on pc (never leaves pc except explicit client sync).
# ssh joins its arguments into one line for the remote login shell, so quote each value.
printf -v secrets_cmd 'env STATE_DIR=%q REMOTE_HOME=%q /bin/bash -euo pipefail' "${state_dir}" "${remote_home}"
ssh -o BatchMode=yes "${host}" "${secrets_cmd}" <<'REMOTE_SECRETS'
umask 077
secrets_file="${STATE_DIR}/hub-secrets.env"
touch "${secrets_file}"
chmod 0600 "${secrets_file}"

ensure_hex_secret() {
	local key="$1" bytes="$2" val
	val="$(grep -E "^${key}=" "${secrets_file}" | head -n 1 | cut -d= -f2- || true)"
	if [[ -z ${val} ]]; then
		val="$(python3 -c 'import secrets, sys; print(secrets.token_hex(int(sys.argv[1])))' "${bytes}")"
		printf '%s=%s\n' "${key}" "${val}" >>"${secrets_file}"
	fi
}

ensure_hex_secret "BESZEL_TOKEN" 24
ensure_hex_secret "SEARXNG_SECRET" 32

key_priv="${STATE_DIR}/beszel-agent.key"
key_pub="${STATE_DIR}/beszel-agent.pub"
if [[ ! -s ${key_pub} && -s "${key_priv}.pub" ]]; then
	mv -f "${key_priv}.pub" "${key_pub}"
	chmod 0644 "${key_pub}"
fi
if [[ ! -s ${key_priv} || ! -s ${key_pub} ]]; then
	rm -f "${key_priv}" "${key_priv}.pub" "${key_pub}"
	ssh-keygen -t ed25519 -N "" -C "beszel-pc-hub" -f "${key_priv}" >/dev/null
	mv -f "${key_priv}.pub" "${key_pub}"
	chmod 0600 "${key_priv}"
	chmod 0644 "${key_pub}"
fi

if [[ ! -s "${REMOTE_HOME}/.config/board/agent-token" ]]; then
	python3 -c 'import secrets, sys; sys.stdout.write(secrets.token_hex(32))' >"${REMOTE_HOME}/.config/board/agent-token"
	chmod 0600 "${REMOTE_HOME}/.config/board/agent-token"
fi
if [[ ! -s "${REMOTE_HOME}/.config/agentsview/server-token" ]]; then
	python3 -c 'import secrets, sys; sys.stdout.write(secrets.token_urlsafe(32))' >"${REMOTE_HOME}/.config/agentsview/server-token"
	chmod 0600 "${REMOTE_HOME}/.config/agentsview/server-token"
fi
REMOTE_SECRETS

beszel_token="$(ssh -o BatchMode=yes "${host}" "grep -E '^BESZEL_TOKEN=' '${state_dir}/hub-secrets.env' | head -n 1 | cut -d= -f2-")"
searxng_secret="$(ssh -o BatchMode=yes "${host}" "grep -E '^SEARXNG_SECRET=' '${state_dir}/hub-secrets.env' | head -n 1 | cut -d= -f2-")"
beszel_pub="$(ssh -o BatchMode=yes "${host}" "awk '{print \$1\" \"\$2}' '${state_dir}/beszel-agent.pub'")"

"${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from pc_hub.cli import main; raise SystemExit(main(sys.argv[2:]))' \
	"${lib_dir}" render-env \
	--ts-host "${ts_host}" \
	--state-dir "${state_dir}" \
	--beszel-public-key "${beszel_pub}" \
	--beszel-token "${beszel_token}" \
	--searxng-secret "${searxng_secret}" \
	--beszel-user-email "${beszel_email}" \
	--caddy-port "${caddy_port}" |
	ssh -o BatchMode=yes "${host}" "umask 077 && cat >'${state_dir}/.env'"

# Install/verify CLI-only codebase-memory-mcp 0.12.1 (zero HTTP exposure) + @tobilu/qmd 2.9.0 + agentsview on pc.
hub_remote_b64="$(base64 <"${lib_dir}/pc_hub/remote.py" | tr -d '\n')"
printf -v bins_cmd 'env REMOTE_HOME=%q MAC_SSH=%q MAC_INTERVAL=%q HUB_REMOTE_B64=%q /bin/bash -euo pipefail' "${remote_home}" "${mac_ssh}" "${mac_interval}" "${hub_remote_b64}"
ssh -o BatchMode=yes "${host}" "${bins_cmd}" <<'REMOTE_BINS'
cbm_ver="0.12.1"
cbm_sha="8c3d0341064301e78ecc84cf7348d4e2c6562a0f57448243ea560aaa34de36c1"
cbm_bin="${REMOTE_HOME}/.local/bin/codebase-memory-mcp"
cbm_ldd=""
cbm_out=""
if [[ -x ${cbm_bin} ]]; then
	cbm_ldd="$(ldd "${cbm_bin}" 2>&1 || true)"
	cbm_out="$( ("${cbm_bin}" --version) 2>/dev/null || true)"
fi
if [[ ! -x ${cbm_bin} ]] || ! grep -Eq "not a dynamic|statically linked" <<<"${cbm_ldd}" || ! grep -Fq "${cbm_ver}" <<<"${cbm_out}"; then
	tmp_dir="$(mktemp -d)"
	trap 'rm -rf "${tmp_dir}"' EXIT
	curl -fsSLo "${tmp_dir}/cbm.tar.gz" "https://github.com/DeusData/codebase-memory-mcp/releases/download/v${cbm_ver}/codebase-memory-mcp-linux-amd64-portable.tar.gz"
	printf '%s  %s\n' "${cbm_sha}" "${tmp_dir}/cbm.tar.gz" | sha256sum -c - >/dev/null
	tar -C "${tmp_dir}" -xzf "${tmp_dir}/cbm.tar.gz"
	found_bin="$(find "${tmp_dir}" -type f -name codebase-memory-mcp | head -n 1)"
	install -m 0755 "${found_bin}" "${cbm_bin}"
fi

qmd_prefix="${REMOTE_HOME}/.local/share/pc-hub/qmd"
qmd_bin="${qmd_prefix}/node_modules/.bin/qmd"
if [[ ! -x ${qmd_bin} ]] || ! "${qmd_bin}" --version 2>/dev/null | grep -Fq "2.9.0"; then
	mkdir -p "${qmd_prefix}"
	npm install --no-audit --no-fund --prefix "${qmd_prefix}" "@tobilu/qmd@2.9.0" >/dev/null
fi
ln -sfn "${qmd_bin}" "${REMOTE_HOME}/.local/bin/qmd"

if [[ ! -x "${REMOTE_HOME}/.local/bin/agentsview" ]]; then
	MISE_YES=1 mise -C "${REMOTE_HOME}" install "github:kenn-io/agentsview@0.48.0" >/dev/null
	av_dir="$(mise -C "${REMOTE_HOME}" where "github:kenn-io/agentsview@0.48.0")"
	if [[ ! -x "${av_dir}/agentsview" ]]; then
		echo "hub:up: missing agentsview binary in ${av_dir}" >&2
		exit 1
	fi
	ln -sfn "${av_dir}/agentsview" "${REMOTE_HOME}/.local/bin/agentsview"
fi
# Ollama (loopback embeddings server for AgentsView semantic search). The release tarball
# ships lib/ollama/cuda_* beside bin/ollama, so link the binary in place rather than copying it.
ollama_ver="0.40.18"
if [[ $(readlink "${REMOTE_HOME}/.local/bin/ollama" 2>/dev/null) != */ollama/${ollama_ver}/bin/ollama ]]; then
	MISE_YES=1 mise -C "${REMOTE_HOME}" install "ollama@${ollama_ver}" >/dev/null
	ollama_dir="$(mise -C "${REMOTE_HOME}" where "ollama@${ollama_ver}")"
	if [[ ! -x "${ollama_dir}/bin/ollama" || ! -d "${ollama_dir}/lib/ollama" ]]; then
		echo "hub:up: missing ollama binary or lib/ollama in ${ollama_dir}" >&2
		exit 1
	fi
	ln -sfn "${ollama_dir}/bin/ollama" "${REMOTE_HOME}/.local/bin/ollama"
fi
mkdir -p "${REMOTE_HOME}/.local/share/pc-hub/ollama/models"
board_prefix="${REMOTE_HOME}/.local/share/pc-hub/board"
vb_bin="${board_prefix}/node_modules/.bin/vb"
board_pkg="${board_prefix}/node_modules/@vercel/board/package.json"
if [[ ! -x ${vb_bin} ]] || ! grep -Fq '"version": "0.57.0"' "${board_pkg}" 2>/dev/null; then
	mkdir -p "${board_prefix}"
	npm install --no-audit --no-fund --prefix "${board_prefix}" "@vercel/board@0.57.0" >/dev/null
fi
ln -sfn "${vb_bin}" "${REMOTE_HOME}/.local/bin/vb"

# Own auth_token/require_auth/host and the Mac [[remote_hosts]] entry; lib/pc_hub/remote.py hub-config.
hub_remote_src="$(printf '%s' "${HUB_REMOTE_B64}" | base64 -d)"
[[ -n ${hub_remote_src} ]] || { echo "hub: lib/pc_hub/remote.py did not decode on $(hostname)" >&2; exit 1; }
python3 -I -B -c "${hub_remote_src}" hub-config \
	"${REMOTE_HOME}/.agentsview/config.toml" "${REMOTE_HOME}/.config/agentsview/server-token" \
	"${MAC_SSH:-}" "${MAC_INTERVAL:-15m}"
REMOTE_BINS

ssh -o BatchMode=yes "${host}" "docker compose -f '${stack_dir}/compose.yaml' --env-file '${state_dir}/.env' up -d --remove-orphans"

if [[ ${skip_systemd} != "true" ]]; then
	node_bin="$(ssh -o BatchMode=yes "${host}" 'command -v node || command -v /usr/bin/node')"
	av_bin="$(ssh -o BatchMode=yes "${host}" 'if [[ -x "$HOME/.local/bin/agentsview" ]]; then printf "%s/.local/bin/agentsview" "$HOME"; else command -v agentsview || printf "%s/.local/bin/agentsview" "$HOME"; fi')"
	qmd_bin="${remote_home}/.local/bin/qmd"
	board_mjs="${remote_home}/.config/mise/assets/board/server.mjs"
	if ! ssh -o BatchMode=yes "${host}" "test -f '${board_mjs}'"; then
		board_mjs="${state_dir}/board/server.mjs"
		ssh -o BatchMode=yes "${host}" "mkdir -p '${state_dir}/board'"
		COPYFILE_DISABLE=1 tar -C "${repo_root}/unix/home/.config/mise/assets/board" -cf - server.mjs | ssh -o BatchMode=yes "${host}" "tar -C '${state_dir}/board' -xf -"
	fi
	units_dir_tmp="$(mktemp -d)"
	trap 'rm -rf "${units_dir_tmp}"' EXIT
	"${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from pc_hub.cli import main; raise SystemExit(main(sys.argv[2:]))' \
		"${lib_dir}" render-systemd \
		--home-dir "${remote_home}" \
		--ts-host "${ts_host}" \
		--node-bin "${node_bin}" \
		--agentsview-bin "${av_bin}" \
		--qmd-bin "${qmd_bin}" \
		--board-server-mjs "${board_mjs}" \
		--ollama-bin "${remote_home}/.local/bin/ollama" \
		--out-dir "${units_dir_tmp}"
	ssh -o BatchMode=yes "${host}" "mkdir -p '${remote_home}/.config/systemd/user'"
	COPYFILE_DISABLE=1 tar -C "${units_dir_tmp}" -cf - . | ssh -o BatchMode=yes "${host}" "tar -C '${remote_home}/.config/systemd/user' -xf - && find '${remote_home}/.config/systemd/user' -maxdepth 1 -name '._dev.mise.*.service' -type f -delete"
	# Ollama restarts only when its unit file or binary changed (or it is down), so a long embedding
	# build that is streaming requests to it is not interrupted by a routine hub:up.
	ssh -o BatchMode=yes "${host}" /bin/bash -euo pipefail <<'REMOTE_UNITS'
systemctl --user daemon-reload
systemctl --user enable --now dev.mise.vercel-board.service dev.mise.agentsview-hub.service dev.mise.qmd-hub.service dev.mise.ollama-hub.service
systemctl --user restart dev.mise.vercel-board.service dev.mise.agentsview-hub.service dev.mise.qmd-hub.service
unit="${HOME}/.config/systemd/user/dev.mise.ollama-hub.service"
stamp="${HOME}/.local/state/pc-hub/ollama-hub.stamp"
want="$(sha256sum "${unit}" | cut -d' ' -f1) $(readlink -f "${HOME}/.local/bin/ollama")"
if [[ "$(cat "${stamp}" 2>/dev/null)" == "${want}" ]] && systemctl --user is-active --quiet dev.mise.ollama-hub.service; then
	echo "hub:up: ollama-hub unchanged, not restarted"
else
	systemctl --user restart dev.mise.ollama-hub.service
	mkdir -p "$(dirname "${stamp}")"
	printf '%s\n' "${want}" >"${stamp}"
	echo "hub:up: ollama-hub restarted"
fi
REMOTE_UNITS
fi

if ! ssh -o BatchMode=yes "${host}" "tailscale serve --bg 'http://127.0.0.1:${caddy_port}'" >/dev/null 2>&1; then
	echo "hub:up: tailscale serve failed; run once on ${host}: sudo tailscale set --operator=\$(whoami)" >&2
	exit 1
fi

printf 'pc Hub up: https://%s\n' "${ts_host}"
printf '  Board UI/API: https://%s/ (API /api/board)\n' "${ts_host}"
printf '  Beszel Hub:   https://%s/beszel/\n' "${ts_host}"
printf '  AgentsView:   https://%s/agentsview/\n' "${ts_host}"
printf '  SearXNG:      https://%s/searxng/\n' "${ts_host}"
printf '  QMD HTTP:     https://%s/qmd/\n' "${ts_host}"
printf '  CBM CLI-only: ssh %s codebase-memory-mcp cli --help\n' "${host}"
