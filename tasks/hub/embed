#!/usr/bin/env bash
#MISE description="Pause, resume or report the long AgentsView embedding build on the pc hub without losing its progress"
#USAGE arg "<command>" help="status, pause or resume" {
#USAGE   choices "status" "pause" "resume"
#USAGE }
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux hub SSH host alias"
#USAGE flag "--data-dir <dir>" default="~/dev/tmp/agentsview-rebuild" help="AgentsView data dir the build runs against (on the host; ~ is the remote home)"
#USAGE flag "--runtime-max <span>" default="144h" help="RuntimeMaxSec watchdog for the units resume starts"
# Reference: docs/agentsview-hub.md ("Pausing a long build"). Pause before pc:sync, an omarchy update or
# anything else that needs the GPU or a restart; resume afterwards. Ollama is left running.
set -euo pipefail

command="${usage_command:?}"
host="${usage_host:-pc}"
data_dir="${usage_data_dir:-~/dev/tmp/agentsview-rebuild}"
runtime_max="${usage_runtime_max:-144h}"
script_dir="$(cd "$(dirname "$0")" && pwd -P)"
remote_script="${script_dir}/../../unix/home/.config/mise/assets/agentsview/embed-build.sh"
[[ -f ${remote_script} ]] || {
	echo "hub:embed: missing ${remote_script}" >&2
	exit 1
}

# The script travels base64-encoded so nothing needs remote shell quoting; ~ expands on the host.
script_b64="$(base64 <"${remote_script}" | tr -d '\n')"
printf -v remote_cmd 'env EMBED_DATA_DIR_RAW=%q EMBED_RUNTIME_MAX=%q SCRIPT_B64=%q /bin/bash -euo pipefail' \
	"${data_dir}" "${runtime_max}" "${script_b64}"
ssh -o BatchMode=yes "${host}" "${remote_cmd}" -s "${command}" <<'REMOTE'
EMBED_DATA_DIR="${EMBED_DATA_DIR_RAW/#\~/${HOME}}"
export EMBED_DATA_DIR EMBED_RUNTIME_MAX
exec /bin/bash -c "$(printf '%s' "${SCRIPT_B64}" | base64 -d)" embed-build.sh "$1"
REMOTE
