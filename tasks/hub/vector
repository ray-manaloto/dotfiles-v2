#!/usr/bin/env bash
#MISE description="Turn AgentsView semantic search on or off on the pc hub from the tracked semantic-search.toml recipe"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux hub SSH host alias"
#USAGE flag "--enable" help="Pull the recipe's model and write its [vector] tables into the hub config (starts the first full embedding build)"
#USAGE flag "--disable" help="Remove every [vector] table from the hub config"
#USAGE flag "--recipe <file>" help="Recipe TOML to apply (default: unix/home/.config/mise/assets/agentsview/semantic-search.toml)"
#USAGE flag "--dry-run" help="Print what would change without writing anything"
# Reference: docs/agentsview-hub.md (remote-sync and embeddings behaviour, upstream links).
# Only [vector...] tables in ~/.agentsview/config.toml are touched; every other setting is checked
# unchanged before the file is written. The hub service restarts so the new config loads.
set -euo pipefail

host="${usage_host:-pc}"
enable="${usage_enable:-false}"
disable="${usage_disable:-false}"
dry_run="${usage_dry_run:-false}"
script_dir="$(cd "$(dirname "$0")" && pwd -P)"
repo_root="$(cd "${script_dir}/../.." && pwd -P)"
recipe="${usage_recipe:-${repo_root}/unix/home/.config/mise/assets/agentsview/semantic-search.toml}"

if [[ ${enable} == "${disable}" ]]; then
	echo "hub:vector: pass exactly one of --enable or --disable" >&2
	exit 1
fi
[[ -f ${recipe} ]] || {
	echo "hub:vector: recipe not found: ${recipe}" >&2
	exit 1
}
mode=disable
[[ ${enable} == true ]] && mode=enable

# The recipe travels base64-encoded and the script on stdin, so nothing needs remote shell quoting.
recipe_b64="$(base64 <"${recipe}" | tr -d '\n')"
hub_remote_b64="$(base64 <"${script_dir}/../../unix/home/.config/mise/lib/pc_hub/remote.py" | tr -d '\n')"
printf -v remote_cmd 'env MODE=%q DRY_RUN=%q RECIPE_B64=%q HUB_REMOTE_B64=%q /bin/bash -euo pipefail' "${mode}" "${dry_run}" "${recipe_b64}" "${hub_remote_b64}"
ssh -o BatchMode=yes "${host}" "${remote_cmd}" <<'REMOTE'
hub_remote_src="$(printf '%s' "${HUB_REMOTE_B64}" | base64 -d)"
[[ -n ${hub_remote_src} ]] || { echo "hub: lib/pc_hub/remote.py did not decode on $(hostname)" >&2; exit 1; }
python3 -I -B -c "${hub_remote_src}" vector "${HOME}/.agentsview/config.toml" "${MODE}" "${DRY_RUN}"
REMOTE
