#!/usr/bin/env bash
#MISE description="Show live pc Hub Compose, Caddy, systemd, CLI-only CBM, and tailscale serve status"
#USAGE flag "--host <ssh_host>" default="pc" help="Remote Linux hub SSH host alias"
#USAGE flag "--json" help="Emit schema-validated PcHubStatusResponse JSON"
#USAGE flag "--agentsview-dir <dir>" help="AgentsView data dir on the hub whose Mac pull to report (default: ~/.agentsview)"
set -euo pipefail

host="${usage_host:-pc}"
json_out="${usage_json:-false}"
av_dir="${usage_agentsview_dir:-}"
# ssh joins its arguments into one remote command line, so quote the value for the remote shell.
printf -v probe_cmd 'env AV_DIR=%q /bin/bash -euo pipefail' "${av_dir}"

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
repo_root="$(cd "${script_dir}/../.." && pwd -P)"
lib_dir="${repo_root}/unix/home/.config/mise/lib"

venv_py="${repo_root}/.venv/bin/python"
if [[ ! -x ${venv_py} ]] && command -v git >/dev/null 2>&1; then
	common_dir="$(git -C "${repo_root}" rev-parse --git-common-dir 2>/dev/null || true)"
	if [[ -n ${common_dir} ]]; then
		if [[ ${common_dir} != /* ]]; then
			common_dir="${repo_root}/${common_dir}"
		fi
		common_root="$(cd "${common_dir}/.." 2>/dev/null && pwd -P || true)"
		if [[ -n ${common_root} && -x "${common_root}/.venv/bin/python" ]]; then
			venv_py="${common_root}/.venv/bin/python"
		fi
	fi
fi
if [[ ! -x ${venv_py} ]]; then
	echo "hub:status: missing .venv/bin/python; run 'mise deps uv'" >&2
	exit 1
fi

probe_json="$(
	ssh -o BatchMode=yes -o ConnectTimeout=5 "${host}" "${probe_cmd}" <<'REMOTE_PROBE'
python3 - <<'PY'
import json
import os
import re
import shutil
import subprocess
import time
import tomllib
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

def check_http(url: str, *, ok_codes=(200, 302, 401)) -> tuple[str, str]:
    try:
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return ("OK" if resp.status in ok_codes else "WARN"), f"http={resp.status}"
    except urllib.error.HTTPError as exc:
        return ("OK" if exc.code in ok_codes else "WARN"), f"http={exc.code}"
    except Exception as exc:
        return "FAIL", str(exc)

def check_systemd(unit: str) -> tuple[str, str]:
    rc = subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit], check=False).returncode
    return ("OK" if rc == 0 else "FAIL"), ("active" if rc == 0 else f"rc={rc}")

def check_container(name: str) -> tuple[str, str]:
    out = subprocess.run(["docker", "container", "inspect", "--format", "{{.State.Status}}", name], capture_output=True, text=True, check=False)
    st = out.stdout.strip()
    return ("OK" if out.returncode == 0 and st == "running" else "FAIL"), (st or out.stderr.strip() or "missing")

ts_host = ""
try:
    ts_raw = subprocess.check_output(["tailscale", "status", "--json"], text=True, timeout=5)
    ts_host = (json.loads(ts_raw).get("Self", {}).get("DNSName") or "").rstrip(".")
except Exception:
    pass

rows = []
c_st, c_det = check_container("pc-hub-caddy")
h_st, h_det = check_http("http://127.0.0.1:8880/healthz", ok_codes=(200,))
rows.append({"service": "caddy", "state": "OK" if c_st == "OK" and h_st == "OK" else "FAIL", "bind_target": "127.0.0.1:8880", "exposed_http": True, "detail": f"{c_det}; {h_det}"})

b_st, b_det = check_container("pc-hub-beszel")
bh_st, bh_det = check_http("http://127.0.0.1:8090/api/health", ok_codes=(200,))
rows.append({"service": "beszel", "state": "OK" if b_st == "OK" and bh_st == "OK" else "FAIL", "bind_target": "127.0.0.1:8090", "exposed_http": True, "detail": f"{b_det}; {bh_det}"})

sp_st, sp_det = check_container("pc-hub-docker-socket-proxy")
rows.append({"service": "docker-socket-proxy", "state": sp_st, "bind_target": "127.0.0.1:2375", "exposed_http": False, "detail": sp_det})

agent_st, agent_det = check_container("pc-hub-beszel-agent")
rows.append({"service": "beszel-agent", "state": agent_st, "bind_target": "127.0.0.1:45876", "exposed_http": False, "detail": agent_det})

vk_st, vk_det = check_container("pc-hub-valkey")
rows.append({"service": "valkey", "state": vk_st, "bind_target": "searxng-net:6379", "exposed_http": False, "detail": vk_det})

sx_st, sx_det = check_container("pc-hub-searxng")
sxh_st, sxh_det = check_http("http://127.0.0.1:8888/healthz", ok_codes=(200,))
rows.append({"service": "searxng", "state": "OK" if sx_st == "OK" and sxh_st == "OK" else "FAIL", "bind_target": "127.0.0.1:8888", "exposed_http": True, "detail": f"{sx_det}; {sxh_det}"})

vb_st, vb_det = check_systemd("dev.mise.vercel-board.service")
rows.append({"service": "vercel-board", "state": vb_st, "bind_target": "127.0.0.1:4100", "exposed_http": True, "detail": vb_det})

av_st, av_det = check_systemd("dev.mise.agentsview-hub.service")
rows.append({"service": "agentsview-hub", "state": av_st, "bind_target": "127.0.0.1:8082", "exposed_http": True, "detail": av_det})

def parse_duration(text: str) -> int:
    m = re.fullmatch(r"([0-9]+)(s|m|h)", text.strip())
    return int(m.group(1)) * {"s": 1, "m": 60, "h": 3600}[m.group(2)] if m else 0

def ago(ts: float) -> str:
    mins = int((time.time() - ts) // 60)
    return f"{mins}m ago" if mins < 120 else f"{mins // 60}h ago"

def check_mac_pull(av_dir: Path) -> tuple[str, str]:
    """WARN-only freshness of the hub SSH pull of the Mac, read from config.toml and the debug log."""
    try:
        cfg = tomllib.loads((av_dir / "config.toml").read_text(encoding="utf-8"))
    except FileNotFoundError:
        return "SKIPPED", f"no config.toml in {av_dir}"
    except Exception as exc:
        return "WARN", f"config.toml unreadable: {type(exc).__name__}"
    mac = [h for h in cfg.get("remote_hosts", []) if isinstance(h, dict) and h.get("host") == "mac"]
    if not mac:
        return "SKIPPED", "no Mac [[remote_hosts]] entry (run hub:mac-pull-key, then hub:up --mac-ssh)"
    every = f"interval {mac[0].get('interval', '?')}"
    interval = parse_duration(str(mac[0].get("interval", "")))
    # AgentsView v0.48 logs no success line. The import of a pull ends with "remote sync delta import: host=mac";
    # a failed pull then logs "remote sync mac failed: ..." and the next attempt starts with
    # "remote sync: host=mac phase=targets". debug.log rotates to debug.log.1.
    stamp = re.compile(r"^(\d{4}/\d\d/\d\d \d\d:\d\d:\d\d) ")
    last_ok = last_fail = pending = None
    fail_text = ""
    for name in ("debug.log.1", "debug.log"):
        try:
            lines = (av_dir / name).read_text(encoding="utf-8", errors="replace").splitlines()
        except FileNotFoundError:
            continue
        for line in lines:
            m = stamp.match(line)
            if not m:
                continue
            ts = datetime.strptime(m.group(1), "%Y/%m/%d %H:%M:%S").timestamp()
            body = line[m.end():]
            if body.startswith(("remote sync mac failed: ", "scheduled remote sync mac: ")):
                last_fail, pending = ts, None
                fail_text = body.split(": ", 1)[1]
            elif body.startswith("remote sync delta import: host=mac "):
                pending = ts
            elif body.startswith("remote sync: host=mac phase=targets ") and pending is not None:
                last_ok, pending = pending, None
    if pending is not None:
        last_ok = pending
    if last_fail is not None and (last_ok is None or last_fail > last_ok):
        good = f"last good {ago(last_ok)}" if last_ok else "no good pull logged"
        return "WARN", f"last pull failed {ago(last_fail)} ({good}, {every}): {fail_text[:120]}"
    if last_ok is None:
        return "WARN", f"no completed pull logged yet ({every})"
    if interval and time.time() - last_ok > 2 * interval + 900:
        return "WARN", f"stale: last good pull {ago(last_ok)} ({every})"
    return "OK", f"last good pull {ago(last_ok)} ({every})"

mp_st, mp_det = check_mac_pull(Path(os.environ.get("AV_DIR") or "~/.agentsview").expanduser())
rows.append({"service": "agentsview-mac-pull", "state": mp_st, "bind_target": "ssh:mac", "exposed_http": False, "detail": mp_det})

qmd_st, qmd_det = check_systemd("dev.mise.qmd-hub.service")
rows.append({"service": "qmd", "state": qmd_st, "bind_target": "127.0.0.1:8181", "exposed_http": True, "detail": qmd_det})

cbm_path = shutil.which("codebase-memory-mcp") or ""
if not cbm_path:
    cand = subprocess.run(["bash", "-lc", 'test -x "$HOME/.local/bin/codebase-memory-mcp" && printf %s "$HOME/.local/bin/codebase-memory-mcp"'], capture_output=True, text=True, check=False)
    cbm_path = cand.stdout.strip()
rows.append({"service": "codebase-memory-mcp", "state": "OK" if cbm_path else "FAIL", "bind_target": "cli-only", "exposed_http": False, "detail": cbm_path or "missing"})

ts_srv = subprocess.run(["tailscale", "serve", "status", "--json"], capture_output=True, text=True, check=False)
has_8880 = "8880" in ts_srv.stdout
rows.append({"service": "tailscale-serve", "state": "OK" if ts_srv.returncode == 0 and has_8880 else "FAIL", "bind_target": f"https://{ts_host}" if ts_host else "tailscale", "exposed_http": True, "detail": "8880 configured" if has_8880 else "missing 8880"})

print(json.dumps({"ts_host": ts_host, "rows": rows}))
PY
REMOTE_PROBE
)"

ts_host="$(printf '%s' "${probe_json}" | jq -r '.ts_host // empty')"
rows_json="$(printf '%s' "${probe_json}" | jq -c '.rows')"

out_json="$("${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from pc_hub.cli import main; raise SystemExit(main(sys.argv[2:]))' \
	"${lib_dir}" build-status \
	--command "hub:status" \
	--ssh-host "${host}" \
	--tailscale-host "${ts_host}" \
	--repo "${repo_root}" \
	--rows-json "${rows_json}")" || rc=$?
rc="${rc:-0}"

if [[ ${json_out} == "true" ]]; then
	printf '%s\n' "${out_json}"
else
	printf 'pc Hub (%s | https://%s):\n' "${host}" "${ts_host:-unknown}"
	printf '%s\n' "${out_json}" | jq -r '.services[] | "  [\(.state)] \(.service) (\(.bind_target), http=\(.exposed_http)) \(.detail // "")"'
fi
exit "${rc}"
