#!/usr/bin/env bash
# Wrapper for opencode invoked via mise [wrappers.opencode] and herdr-app.
# Injects --standalone only for bare TUI, path targets, and OpenCode v2.4.1 SERVER_FLAGS subcommands
# when neither --standalone nor --server is already provided.
set -euo pipefail

resolve_real_opencode() {
	local candidate="${HOME}/.opencode/bin/opencode"
	if [[ -x ${candidate} ]]; then
		printf '%s\n' "${candidate}"
		return 0
	fi

	local self_dir
	self_dir="$(cd "$(dirname "$0")" && pwd -P)"
	local -a path_dirs=()
	local dir
	IFS=':' read -ra path_dirs <<<"${PATH:-}"
	for dir in ${path_dirs[@]+"${path_dirs[@]}"}; do
		dir="${dir%/}"
		[[ -n ${dir} ]] || continue
		case "${dir}" in
		*/command-wrappers/bin | */mise/shims | "${self_dir}") continue ;;
		esac
		if [[ -x "${dir}/opencode" ]]; then
			printf '%s\n' "${dir}/opencode"
			return 0
		fi
	done

	echo "opencode-wrapper: real opencode binary not found (expected ${candidate})" >&2
	return 127
}

real_opencode="$(resolve_real_opencode)"

has_passthrough_flag=0
first_pos=""
end_of_opts=0
args=("$@")
i=0
while ((i < ${#args[@]})); do
	arg="${args[i]}"
	if ((end_of_opts == 0)); then
		case "${arg}" in
		--)
			end_of_opts=1
			;;
		--standalone | --server | --server=*)
			exec "${real_opencode}" "$@"
			;;
		-h | --help | -v | --version | --wizard | --completions=*)
			has_passthrough_flag=1
			;;
		--completions)
			has_passthrough_flag=1
			i=$((i + 1))
			;;
		--session | -s | --prompt | --log-level | --model | -m | --file | -f | --agent | --format | --title)
			i=$((i + 1))
			;;
		-*) ;;
		*)
			if [[ -z ${first_pos} ]]; then
				first_pos="${arg}"
			fi
			;;
		esac
	elif [[ -z ${first_pos} ]]; then
		first_pos="${arg}"
	fi
	i=$((i + 1))
done

if ((has_passthrough_flag == 1)); then
	exec "${real_opencode}" "$@"
fi

inject_standalone=0
if [[ -z ${first_pos} ]]; then
	inject_standalone=1
else
	case "${first_pos}" in
	update | upgrade | uninstall | mcp | plugin | serve | service | pair | acp | debug)
		inject_standalone=0
		;;
	run | session | models | api | auth | stats | mini | reload | machine | login)
		inject_standalone=1
		;;
	. | .. | ./* | ../* | /* | ~*)
		inject_standalone=1
		;;
	*)
		if [[ -e ${first_pos} || -d ${first_pos} ]]; then
			inject_standalone=1
		fi
		;;
	esac
fi

if ((inject_standalone == 1)); then
	exec "${real_opencode}" --standalone "$@"
fi
exec "${real_opencode}" "$@"
