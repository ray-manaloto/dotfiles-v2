#!/bin/sh
# Codex for herdr tabs and `hc run`, which start programs without a shell, so PATH may omit mise dirs.
# Sets `CODEX_HERDR=1` and delegates to `codex-wrapper` so interactive/exec Herdr tabs keep
# `--disable daemon_auto_start` (per-tab `HC_*` isolation for openai/codex#53547 / herdr-core#335)
# while reading `shell_environment_policy` from `~/.codex/config.toml` (zero `-c` overrides), and
# `app-server` / `remote-control` / utility invocations still run clean without ephemeral proxy vars.
# Usage: herdr-app do tab.new ... --argv '["codex-hc", "task"]'
script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
if [ -x "${script_dir}/codex-wrapper" ]; then
	wrapper="${script_dir}/codex-wrapper"
elif [ -x "${HOME}/.local/bin/codex-wrapper" ]; then
	wrapper="${HOME}/.local/bin/codex-wrapper"
else
	echo "codex-hc: missing codex-wrapper in ~/.local/bin or ${script_dir}" >&2
	exit 127
fi
exec env CODEX_HERDR=1 "${wrapper}" "$@"
