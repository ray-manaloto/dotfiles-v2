#!/usr/bin/env bash
# Subcommand-aware Codex launcher.
# - Bypasses ephemeral `fnox proxy run`, `-c` overrides, and `--disable daemon_auto_start`
#   for daemon/utility subcommands and bare interactive `codex` so CLI sessions can attach
#   cleanly to Codex 0.172.0 `app-server-daemon` and `codex remote-control`.
# - Preserves `--disable daemon_auto_start` (without `-c shell_environment_policy.*`
#   overrides, letting ~/.codex/config.toml own the policy) when launched via `codex-hc`
#   (`CODEX_HERDR=1`) so Herdr tabs keep isolated per-tab `HC_*` variables (`#53547`).
set -euo pipefail

strip_ephemeral_proxy_env() {
	unset \
		HTTP_PROXY HTTPS_PROXY ALL_PROXY \
		http_proxy https_proxy all_proxy \
		SSL_CERT_FILE NODE_EXTRA_CA_CERTS REQUESTS_CA_BUNDLE \
		CURL_CA_BUNDLE GIT_SSL_CAINFO CARGO_HTTP_CAINFO \
		DENO_CERT RUST_LOG
}

canon_file() {
	local p="$1" link="" dir="" depth=0
	while [[ -L ${p} && ${depth} -lt 40 ]]; do
		dir="$(cd "$(dirname "${p}")" 2>/dev/null && pwd -P)" || break
		link="$(readlink "${p}")" || break
		case "${link}" in
		/*) p="${link}" ;;
		*) p="${dir}/${link}" ;;
		esac
		depth=$((depth + 1))
	done
	dir="$(cd "$(dirname "${p}")" 2>/dev/null && pwd -P)" || return 1
	printf '%s/%s\n' "${dir}" "$(basename "${p}")"
}

resolve_real_codex() {
	local self_path self_real candidate cand_real dir IFS
	self_path="$0"
	self_real="$(canon_file "${self_path}")"
	candidate="${HOME}/.local/bin/codex"
	if [[ -x ${candidate} ]]; then
		cand_real="$(canon_file "${candidate}")"
		if [[ ${cand_real} != "${self_real}" ]]; then
			printf '%s\n' "${candidate}"
			return 0
		fi
	fi

	IFS=':'
	for dir in ${PATH:-}; do
		dir="${dir%/}"
		[[ -n ${dir} ]] || continue
		case "${dir}" in
		*/command-wrappers/bin | */mise/shims) continue ;;
		esac
		candidate="${dir}/codex"
		[[ -x ${candidate} ]] || continue
		cand_real="$(canon_file "${candidate}")"
		case "$(basename "${cand_real}")" in
		codex-wrapper | codex-hc) continue ;;
		esac
		if [[ ${cand_real} != "${self_real}" ]]; then
			printf '%s\n' "${candidate}"
			return 0
		fi
	done

	echo "codex-wrapper: unable to locate real codex binary" >&2
	return 127
}

resolve_fnox_bin() {
	local candidate
	if candidate="$(command -v fnox 2>/dev/null)" && [[ -x ${candidate} ]]; then
		printf '%s\n' "${candidate}"
		return 0
	fi
	for candidate in \
		"${HOME}/.local/share/mise/shims/fnox" \
		"/opt/mise/shims/fnox" \
		"/usr/local/bin/fnox"; do
		if [[ -x ${candidate} ]]; then
			printf '%s\n' "${candidate}"
			return 0
		fi
	done
	return 1
}

# Inspect arguments without mutating "$@"
subcommand=""
has_meta_flag=0
has_disable_daemon=0
expect_val=0
prev_disable=0
end_opts=0

for arg in "$@"; do
	if [[ ${expect_val} -eq 1 ]]; then
		if [[ ${prev_disable} -eq 1 && ${arg} == "daemon_auto_start" ]]; then
			has_disable_daemon=1
		fi
		expect_val=0
		prev_disable=0
		continue
	fi
	if [[ ${end_opts} -eq 1 ]]; then
		[[ -z ${subcommand} ]] && subcommand="${arg}"
		break
	fi
	case "${arg}" in
	--)
		end_opts=1
		;;
	-h | --help | -V | --version)
		has_meta_flag=1
		;;
	--no-daemon)
		has_disable_daemon=1
		;;
	--disable)
		expect_val=1
		prev_disable=1
		;;
	--disable=daemon_auto_start)
		has_disable_daemon=1
		;;
	-c | --config | -m | --model | -p | --profile | -s | --sandbox | -a | --ask-for-approval | -C | --cd | -i | --image | --add-dir | --enable | --remote | --remote-auth-token-env | --local-provider | --provider)
		expect_val=1
		;;
	-*)
		;;
	*)
		if [[ -z ${subcommand} ]]; then
			subcommand="${arg}"
		fi
		;;
	esac
done

real_codex="$(resolve_real_codex)"

is_bypass=0
if [[ ${has_meta_flag} -eq 1 ]]; then
	is_bypass=1
else
	case "${subcommand}" in
	app-server | remote-control | update | login | logout | doctor | features | help | completion | debug | cloud | exec-server | mcp | plugin | app | sandbox)
		is_bypass=1
		;;
	esac
fi

if [[ ${is_bypass} -eq 1 || ${CODEX_HERDR:-0} != "1" ]]; then
	strip_ephemeral_proxy_env
	exec "${real_codex}" "$@"
fi

# Herdr tab session (`codex-hc`): preserve per-tab HC_* isolation (`--disable daemon_auto_start`)
# while letting ~/.codex/config.toml own [shell_environment_policy] (zero -c overrides).
extra_flags=()
if [[ ${has_disable_daemon} -eq 0 ]]; then
	extra_flags+=(--disable daemon_auto_start)
fi

strip_ephemeral_proxy_env
fnox_cfg="${FNOX_CONFIG:-${HOME}/.config/fnox/config.toml}"
if fnox_bin="$(resolve_fnox_bin)" && [[ -r ${fnox_cfg} ]]; then
	export RUST_LOG="fnox::commands::proxy=error"
	exec "${fnox_bin}" --non-interactive --config "${fnox_cfg}" proxy run -- \
		env -u RUST_LOG "${real_codex}" ${extra_flags[@]+"${extra_flags[@]}"} "$@"
fi

exec "${real_codex}" ${extra_flags[@]+"${extra_flags[@]}"} "$@"
