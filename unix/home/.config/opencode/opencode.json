{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "share": "disabled",
  "update": "disable",
  "instructions": ["~/.agents/AGENTS.md", "~/.config/opencode/AGENTS.md"],
  "compaction": {
    "background": false
  },
  "plugins": ["graphify-opencode@1.1.1"],
  "mcp": {
    "servers": {
      "repowise": {
        "type": "local",
        "command": ["repowise", "mcp"],
        "environment": {
          "DO_NOT_TRACK": "1",
          "REPOWISE_TELEMETRY_DISABLED": "1"
        }
      }
    }
  }
}
