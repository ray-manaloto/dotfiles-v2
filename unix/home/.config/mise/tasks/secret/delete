#!/usr/bin/env bash
#MISE description="Delete Doppler secrets from dotfiles/dev_personal (the owner's yes on the exact names first)"
#USAGE arg "<names>" var=#true help="Secret names"
set -euo pipefail

read -r -a names <<<"${usage_names:-}"
if [[ ${#names[@]} -eq 0 ]]; then
	echo 'secret:delete: at least one secret name is required' >&2
	exit 1
fi
for name in "${names[@]}"; do
	if ! printf '%s' "${name}" | grep -qxE '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'; then
		echo 'secret:delete: every name must be UPPER_SNAKE' >&2
		exit 1
	fi
done

doppler secrets delete "${names[@]}" -p dotfiles -c dev_personal --no-check-version --yes --silent >/dev/null
echo "secret:delete: deleted ${names[*]}"
