#!/usr/bin/env bash
#MISE description="Verify fnox providers, fnox secret resolution, and Doppler CLI keyring health (never prints values)"
set -euo pipefail

fnox --non-interactive provider test --all
fnox --non-interactive check --all
doppler secrets --only-names --project dotfiles --config dev_personal --no-check-version >/dev/null

if [[ -e "${HOME}/.doppler/.doppler.yaml" ]]; then
	count="$(grep -cE 'dp\.[a-z_]+\.' "${HOME}/.doppler/.doppler.yaml" || true)"
	if [[ ${count} -ne 0 ]]; then
		echo "secret:doctor: plaintext token found in ${HOME}/.doppler/.doppler.yaml; re-store in Keychain" >&2
		exit 1
	fi
fi

echo "secret:doctor: ok"
