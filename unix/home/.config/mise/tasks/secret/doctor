#!/usr/bin/env bash
#MISE description="Verify fnox providers, strict per-profile secret resolution, and Doppler CLI keyring health (never prints values)"
set -euo pipefail

fnox_cfg="${FNOX_CONFIG_FILE:-${HOME}/.config/fnox/config.toml}"

fnox --non-interactive --config "${fnox_cfg}" doctor
fnox --non-interactive --config "${fnox_cfg}" provider test --all

profiles_out="$(fnox --non-interactive --no-color --config "${fnox_cfg}" profiles)"
profiles="$(
	printf '%s\n' "${profiles_out}" | sed -n 's/^[[:space:]]\{1,\}\([A-Za-z0-9_.-][A-Za-z0-9_.-]*\)[[:space:]]*(.*$/\1/p'
)"
if [[ -z ${profiles} ]]; then
	profiles="default"
fi

while IFS= read -r profile; do
	[[ -n ${profile} ]] || continue
	fnox --non-interactive --config "${fnox_cfg}" check -P "${profile}" --all --strict
done <<<"${profiles}"

doppler secrets --only-names --project dotfiles --config dev_personal --no-check-version >/dev/null

if [[ -e "${HOME}/.doppler/.doppler.yaml" ]]; then
	count="$(grep -cE 'dp\.[a-z_]+\.' "${HOME}/.doppler/.doppler.yaml" || true)"
	if [[ ${count} -ne 0 ]]; then
		echo "secret:doctor: plaintext token found in ${HOME}/.doppler/.doppler.yaml; re-store in Keychain" >&2
		exit 1
	fi
fi

echo "secret:doctor: ok"
