#!/usr/bin/env bash
#MISE description="Add a Doppler secret to dotfiles/dev_personal from stdin; --replace changes an existing one"
#USAGE arg "<name>" help="UPPER_SNAKE secret name"
#USAGE flag "--replace" help="Change a secret Doppler already has"
set -euo pipefail

name="${usage_name:-}"
replace="${usage_replace:-false}"

printf '%s' "${name}" | grep -qxE '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*' || {
	echo 'secret:set: the name is not UPPER_SNAKE' >&2
	exit 1
}

if [[ ${replace} != "true" ]]; then
	names="$(doppler secrets --only-names --json -p dotfiles -c dev_personal --no-check-version)" || {
		echo 'secret:set: cannot list the Doppler names' >&2
		exit 1
	}
	if printf '%s' "${names}" | jq -e --arg n "${name}" 'has($n)' >/dev/null; then
		echo "secret:set: ${name} exists; pass --replace to change it" >&2
		exit 1
	fi
fi

doppler secrets set "${name}" -p dotfiles -c dev_personal --no-check-version --no-interactive --silent >/dev/null
fnox_cfg="${FNOX_CONFIG_FILE:-${HOME}/.config/fnox/config.toml}"
if command -v fnox >/dev/null 2>&1 && [[ -f ${fnox_cfg} ]]; then
	fnox --non-interactive --config "${fnox_cfg}" daemon clear >/dev/null
fi
echo "secret:set: stored ${name}"
