#!/usr/bin/env bash
#MISE description="Install or optionally upgrade native Claude Code CLI idempotently"
#USAGE flag "--upgrade" help="Upgrade Claude Code CLI to latest when already installed"
set -euo pipefail

mkdir -p "${HOME}/.local/bin"
if [[ ! -x "${HOME}/.local/bin/claude" ]]; then
	script="$(mktemp)"
	trap 'rm -f "${script}"' EXIT
	curl -fsSLo "${script}" https://claude.ai/install.sh
	PATH="${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin" bash "${script}" </dev/null
elif [[ ${usage_upgrade:-false} == "true" ]]; then
	"${HOME}/.local/bin/claude" update </dev/null || echo "WARN: claude update failed; keeping installed version" >&2
fi
"${HOME}/.local/bin/claude" --version </dev/null
