#!/usr/bin/env bash
#MISE description="Sync mise/jdx tool skills, install agentsview skills, mirror ~/.agents/skills into ~/.claude/skills, retire ~/.zcode/skills mirrors, wire ray-manaloto/skills marketplaces, and configure Hermes external_dirs"
set -euo pipefail

# Never bake temporary Docker Phase 1b paths into image layers.
if [[ ${MISE_CONFIG_DIR:-} == "/tmp/phase1b" ]]; then
	exit 0
fi

agents_dir="${HOME}/.agents/skills"
claude_dir="${HOME}/.claude/skills"
zcode_dir="${HOME}/.zcode/skills"

# Ensure ~/.claude/skills is a real directory, never a symlink to ~/.agents/skills.
if [[ -L ${claude_dir} ]]; then
	rm -f "${claude_dir}"
fi

mkdir -p "${agents_dir}" "${claude_dir}"

# Clear any self-referential ../../.agents/skills/ loops left by prior symlinked dirs,
# and unlink legacy pre-manifest ~/.agents/skills/<name> symlinks pointing into mise installs
# so `mise skills sync --global --prune` cleanly adopts them and writes .mise-skills.json.
python3 - "${agents_dir}" "${MISE_DATA_DIR:-${HOME}/.local/share/mise}/installs" <<'PY'
import json
import os
import subprocess
import sys
from pathlib import Path

agents_dir = Path(sys.argv[1])
installs_dir = Path(sys.argv[2])

for entry in sorted(agents_dir.iterdir()):
    if entry.is_symlink() and os.readlink(entry).startswith("../../.agents/skills/"):
        entry.unlink()

manifest_path = agents_dir / ".mise-skills.json"
recorded: set[str] = set()
if manifest_path.is_file():
    try:
        manifest_data = json.loads(manifest_path.read_text(encoding="utf-8"))
        if isinstance(manifest_data, dict) and isinstance(manifest_data.get("links"), dict):
            recorded = set(manifest_data["links"].keys())
    except (OSError, json.JSONDecodeError):
        recorded = set()

try:
    ls_out = subprocess.check_output(
        ["mise", "-C", str(Path.home()), "skills", "ls", "--json"],
        text=True,
    )
    managed_names = {
        str(row["name"])
        for row in json.loads(ls_out)
        if isinstance(row, dict) and row.get("name")
    }
except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
    managed_names = set()

installs_markers = (
    str(installs_dir).rstrip("/") + "/",
    str(installs_dir.resolve(strict=False)).rstrip("/") + "/",
    "/.local/share/mise/installs/",
)

for name in sorted(managed_names):
    if name in recorded:
        continue
    link = agents_dir / name
    if not link.is_symlink():
        continue
    raw_target = os.readlink(link)
    resolved_target = str(link.resolve(strict=False))
    if any(m in raw_target or m in resolved_target for m in installs_markers):
        link.unlink()
PY

mise skills sync --global --prune

# Install the official agentsview skill for the cross-harness ~/.agents/skills root only.
# Never pass `--harness claude`: that generates the MCP-only agentsview-search-conversations skill.
# [wrappers.agentsview] makes `command -v` succeed even when its ~/.local/bin target is not
# applied yet (e.g. CI `mise install` without dotfiles), so probe that it actually executes.
av_ok=false
if command -v agentsview >/dev/null 2>&1; then
	if agentsview --version </dev/null >/dev/null 2>&1; then
		av_ok=true
	else
		echo "WARN: agentsview is on PATH but does not run (wrapper target missing?); skipping agentsview skill install" >&2
	fi
fi
if [[ ${av_ok} == "true" ]]; then
	av_skill="${agents_dir}/agentsview-finding-history"
	if [[ -L ${av_skill} ]]; then
		av_raw="$(readlink "${av_skill}" 2>/dev/null || true)"
		av_res="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${av_skill}" 2>/dev/null || true)"
		if [[ ${av_raw} == *"/.agents/skills/agentsview-finding-history"* || ${av_res} == *"/unix/home/.agents/skills/agentsview-finding-history"* || (! -e ${av_skill} && ${av_raw} == *"dotfiles-v2"*) ]]; then
			rm -f "${av_skill}"
		else
			echo "ERROR: ${av_skill} is a custom symlink (${av_raw}); refusing to overwrite" >&2
			exit 1
		fi
	elif [[ -d ${av_skill} && -f "${av_skill}/SKILL.md" ]] && ! grep -q "generated-by: agentsview" "${av_skill}/SKILL.md"; then
		echo "ERROR: ${av_skill}/SKILL.md is not agentsview-generated; refusing to overwrite with --force" >&2
		exit 1
	fi
	av_args=(skills install --harness agents --force)
	if [[ -n ${AGENTSVIEW_SKILLS_SERVER:-} ]]; then
		av_args+=(--server "${AGENTSVIEW_SKILLS_SERVER}")
		if [[ -n ${AGENTSVIEW_SKILLS_SERVER_TOKEN_FILE:-} ]]; then
			av_args+=(--server-token-file "${AGENTSVIEW_SKILLS_SERVER_TOKEN_FILE}")
		fi
	fi
	if ! av_out="$(agentsview "${av_args[@]}" </dev/null 2>&1)"; then
		printf '%s\n' "${av_out}" >&2
		echo "ERROR: agentsview skills install --harness agents failed" >&2
		exit 1
	fi
	if [[ ! -f "${av_skill}/SKILL.md" ]]; then
		echo "ERROR: agentsview did not install ${av_skill}/SKILL.md" >&2
		exit 1
	fi
fi

python3 - "${agents_dir}" "${claude_dir}" "${zcode_dir}" <<'PY'
import errno
import os
import sys
from pathlib import Path

agents_dir = Path(sys.argv[1])
claude_dir = Path(sys.argv[2])
zcode_dir = Path(sys.argv[3])

def is_skill_dir(entry: Path) -> bool:
    return (entry.is_dir() or entry.is_symlink()) and (entry / "SKILL.md").is_file()

def mirror_skills_dir(source_dir: Path, target_dir: Path) -> None:
    if target_dir.resolve() == source_dir.resolve():
        return
    # Prune dangling relative links we own when a global tool skill is removed.
    for dst in sorted(target_dir.iterdir()):
        if dst.is_symlink() and not dst.exists():
            if os.readlink(dst) == f"../../.agents/skills/{dst.name}":
                dst.unlink()
    for entry in sorted(source_dir.iterdir()):
        if not is_skill_dir(entry):
            continue
        dst = target_dir / entry.name
        desired = f"../../.agents/skills/{entry.name}"
        if dst.is_symlink():
            if os.readlink(dst) == desired:
                continue
            if dst.exists() or not os.readlink(dst).startswith("../../.agents/skills/"):
                continue
            dst.unlink()
        elif dst.exists():
            # Leave real directories (for example local plugin skills) untouched.
            continue
        os.symlink(desired, dst)

def retire_zcode_mirrors(source_dir: Path, target_dir: Path) -> None:
    # zcode-runtime discovers ~/.agents/skills natively via setting.json skills.roots;
    # remove only the legacy root symlink or same-name ../../.agents/skills/<name> links.
    if target_dir.is_symlink():
        if target_dir.resolve(strict=False) == source_dir.resolve(strict=False):
            target_dir.unlink()
        return
    if not target_dir.is_dir():
        return
    for dst in sorted(target_dir.iterdir()):
        if dst.is_symlink() and os.readlink(dst) == f"../../.agents/skills/{dst.name}":
            dst.unlink()
    try:
        target_dir.rmdir()
    except OSError as exc:
        if exc.errno not in {errno.ENOTEMPTY, errno.EEXIST}:
            raise

mirror_skills_dir(agents_dir, claude_dir)
retire_zcode_mirrors(agents_dir, zcode_dir)
PY

# Wire ray-manaloto/skills plugin marketplace for Claude, Codex, and Antigravity when online.
if [[ ${MISE_OFFLINE:-0} != "1" && ${MISE_OFFLINE:-false} != "true" && ${CI:-false} != "true" ]]; then
	if command -v claude >/dev/null 2>&1; then
		km_file="${HOME}/.claude/plugins/known_marketplaces.json"
		has_claude_mp=0
		if [[ -s ${km_file} ]] && grep -q '"ray-manaloto-skills"' "${km_file}" 2>/dev/null; then
			has_claude_mp=1
		fi
		if [[ ${has_claude_mp} -eq 0 ]]; then
			claude plugin marketplace add ray-manaloto/skills </dev/null >/dev/null 2>&1 || echo "WARN: claude plugin marketplace add ray-manaloto/skills skipped/failed" >&2
		fi
		claude_plugins_json="$(claude plugin list --json </dev/null 2>/dev/null || echo '[]')"
		for cp in "skills@ray-manaloto-skills" "fleet-agents@ray-manaloto-skills"; do
			if ! python3 - "${claude_plugins_json}" "${cp}" <<'PY'
import json
import sys

raw, want = sys.argv[1], sys.argv[2]
try:
    rows = json.loads(raw)
except json.JSONDecodeError:
    rows = []
found = any(
    isinstance(row, dict)
    and (row.get("id") == want or row.get("name") == want)
    and row.get("scope") in {None, "user"}
    and row.get("enabled") is not False
    for row in (rows if isinstance(rows, list) else [])
)
sys.exit(0 if found else 1)
PY
			then
				claude plugin install "${cp}" </dev/null >/dev/null 2>&1 || echo "WARN: claude plugin install ${cp} skipped/failed" >&2
			fi
		done
	fi

	if command -v codex >/dev/null 2>&1; then
		codex_mp_json="$(codex plugin marketplace list --json </dev/null 2>/dev/null || echo '{}')"
		if ! python3 - "${codex_mp_json}" <<'PY'
import json
import sys

try:
    data = json.loads(sys.argv[1])
except json.JSONDecodeError:
    data = {}
mps = data.get("marketplaces", []) if isinstance(data, dict) else []
found = any(
    isinstance(m, dict) and (m.get("name") == "ray-manaloto-skills" or "ray-manaloto/skills" in str(m.get("marketplaceSource", "")))
    for m in mps
)
sys.exit(0 if found else 1)
PY
		then
			codex plugin marketplace add ray-manaloto/skills </dev/null >/dev/null 2>&1 || echo "WARN: codex plugin marketplace add ray-manaloto/skills skipped/failed" >&2
		fi
		codex_plugins_json="$(codex plugin list -m ray-manaloto-skills --json </dev/null 2>/dev/null || echo '{}')"
		if ! python3 - "${codex_plugins_json}" <<'PY'
import json
import sys

try:
    data = json.loads(sys.argv[1])
except json.JSONDecodeError:
    data = {}
installed = data.get("installed") if isinstance(data, dict) else []
found = any(
    isinstance(p, dict)
    and (
        p.get("pluginId") == "skills@ray-manaloto-skills"
        or (
            p.get("marketplaceName") == "ray-manaloto-skills"
            and p.get("name") == "skills"
            and p.get("installed") is True
        )
    )
    for p in (installed if isinstance(installed, list) else [])
)
sys.exit(0 if found else 1)
PY
		then
			codex plugin add skills@ray-manaloto-skills </dev/null >/dev/null 2>&1 || echo "WARN: codex plugin add skills@ray-manaloto-skills skipped/failed" >&2
		fi
	fi

	if command -v agy >/dev/null 2>&1; then
		agy_plugins_json="$(agy plugin list --json </dev/null 2>/dev/null || echo '[]')"
		if ! python3 - "${agy_plugins_json}" <<'PY'
import json
import sys

try:
    rows = json.loads(sys.argv[1])
except json.JSONDecodeError:
    rows = []
found = any(
    isinstance(row, dict) and (row.get("name") == "skills" or "ray-manaloto/skills" in str(row.get("source", "")))
    for row in (rows if isinstance(rows, list) else [])
)
sys.exit(0 if found else 1)
PY
		then
			agy plugin install https://github.com/ray-manaloto/skills </dev/null >/dev/null 2>&1 || echo "WARN: agy plugin install ray-manaloto/skills skipped/failed" >&2
		fi
	fi
fi

hermes_sync="$(cd "$(dirname "$0")/.." && pwd)/hermes/skills-sync"
if [[ -x ${hermes_sync} ]]; then
	"${hermes_sync}"
fi
