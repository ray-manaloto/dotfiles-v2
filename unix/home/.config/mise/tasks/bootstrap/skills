#!/usr/bin/env bash
#MISE description="Sync mise/jdx tool skills and mirror ~/.agents/skills into ~/.claude/skills"
set -euo pipefail

# Never bake temporary Docker Phase 1b paths into image layers.
if [[ ${MISE_CONFIG_DIR:-} == "/tmp/phase1b" ]]; then
	exit 0
fi

agents_dir="${HOME}/.agents/skills"
claude_dir="${HOME}/.claude/skills"

mkdir -p "${agents_dir}" "${claude_dir}"
mise skills sync --global --prune

python3 - "${agents_dir}" "${claude_dir}" <<'PY'
import os
import sys
from pathlib import Path

agents_dir = Path(sys.argv[1])
claude_dir = Path(sys.argv[2])

def is_skill_dir(entry: Path) -> bool:
    return (entry.is_dir() or entry.is_symlink()) and (entry / "SKILL.md").is_file()

# Prune dangling relative links we own in ~/.claude/skills when a global tool skill is removed.
for dst in sorted(claude_dir.iterdir()):
    if dst.is_symlink() and not dst.exists():
        if os.readlink(dst).startswith("../../.agents/skills/"):
            dst.unlink()

for entry in sorted(agents_dir.iterdir()):
    if not is_skill_dir(entry):
        continue
    dst = claude_dir / entry.name
    desired = f"../../.agents/skills/{entry.name}"
    if dst.is_symlink():
        if os.readlink(dst) == desired:
            continue
        if dst.exists() or not os.readlink(dst).startswith("../../.agents/skills/"):
            continue
        dst.unlink()
    elif dst.exists():
        # Leave real directories (for example local plugin skills) untouched.
        continue
    os.symlink(desired, dst)
PY
