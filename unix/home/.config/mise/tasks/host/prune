#!/usr/bin/env bash
#MISE description="Prune stale mise tools, shims, plugins, wrappers, retired pitchfork daemons, dead symlinks, and unmanaged host leftovers"
#USAGE flag "--apply" help="Execute host prune and cleanup (default: dry-run preview)"
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
lib_dir="$(cd "${script_dir}/../../lib" && pwd -P)"
apply="${usage_apply:-false}"
home_dir="${HOME}"
data_dir="${MISE_DATA_DIR:-${home_dir}/.local/share/mise}"
installs_dir="${data_dir}/installs"
wrappers_dir="${data_dir}/command-wrappers/bin"
plugins_dir="${data_dir}/plugins"
fnox_cfg="${home_dir}/.config/fnox/config.toml"

if [[ ${apply} == "true" ]]; then
	echo "MODE: APPLY (executing host prune and cleanup)"
else
	echo "MODE: DRY-RUN (preview only; pass --apply to execute)"
fi

if [[ -L "${home_dir}/.agents/skills/antigravity-session-history" || -e "${home_dir}/.agents/skills/antigravity-session-history" ]]; then
	echo "KEEP  ~/.agents/skills/antigravity-session-history (explicitly preserved)"
fi

# 0. Untrack tracked-configs symlinks pointing under miserc.toml ignored_config_paths
#    before running `mise prune` so retired/offline repos stop pinning legacy tools.
python3 - "${apply}" "${home_dir}" <<'PY'
import os
import sys
import tomllib
from pathlib import Path

apply = sys.argv[1] == "true"
home = Path(sys.argv[2])
miserc = home / ".config" / "mise" / "miserc.toml"
state_dir = Path(os.environ.get("MISE_STATE_DIR", str(home / ".local" / "state" / "mise")))
tracked_dir = state_dir / "tracked-configs"

if not miserc.is_file() or not tracked_dir.is_dir():
    sys.exit(0)

try:
    data = tomllib.loads(miserc.read_text(encoding="utf-8"))
except (OSError, tomllib.TOMLDecodeError):
    sys.exit(0)

raw = data.get("ignored_config_paths")
if not isinstance(raw, list):
    sys.exit(0)

ignored = tuple(
    Path(entry).expanduser().resolve(strict=False)
    for entry in raw
    if isinstance(entry, str) and entry.strip()
)
if not ignored:
    sys.exit(0)

for link in sorted(tracked_dir.iterdir()):
    try:
        target = link.resolve(strict=True)
    except OSError:
        continue
    if any(target == prefix or prefix in target.parents for prefix in ignored):
        if apply:
            link.unlink()
            print(f"UNTRACKED ignored config: {link.name} -> {target}")
        else:
            print(f"WOULD UNTRACK ignored config: {link.name} -> {target}")
PY

# 1. mise prune --configs, mise prune, and mise reshim --force
if [[ ${apply} == "true" ]]; then
	mise -C "${home_dir}" prune --configs --yes
	mise -C "${home_dir}" prune --yes
	mise -C "${home_dir}" reshim --force
else
	mise -C "${home_dir}" prune --configs --dry-run
	mise -C "${home_dir}" prune --dry-run
	echo "DRY-RUN: would run \`mise -C \"${home_dir}\" reshim --force\`"
fi

# 2. Orphaned command-wrappers/bin/* not declared in [wrappers.*]
# 3. Stale unconfigured mise plugins and orphaned dirs in ~/.local/share/mise/plugins/
# 3c. Inactive orphaned <tool>-<8-char> mise staging/install dirs
# 4. Retired stopped pitchfork entries
# 5. Stale standalone binaries in ~/.local/bin/{uv,uvx,hermes,hermes-acp,hermes-agent}
# 6. Dead symlinks in ~/.config/opencode/skills/ and ~/.claude/debug/latest
# 7. Unmanaged ~/.config/opencode/opencode.jsonc (backup before removal)
# 8. Untracked unix/home/.config/mise/config.local.toml (only when migrated-env-only + fnox check --all --strict passes with CLOUDFLARE_ACCOUNT_ID)
python3 - "${apply}" "${home_dir}" "${wrappers_dir}" "${plugins_dir}" "${fnox_cfg}" "${installs_dir}" "${lib_dir}" <<'PY'
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

apply = sys.argv[1] == "true"
home = Path(sys.argv[2])
wrappers_dir = Path(sys.argv[3])
plugins_dir = Path(sys.argv[4])
fnox_cfg = Path(sys.argv[5])
installs_dir = Path(sys.argv[6])
lib_dir = sys.argv[7]
if lib_dir not in sys.path:
    sys.path.insert(0, lib_dir)

from mise_staging_prune import find_orphaned_mise_staging_dirs

mise_dir = home / ".config" / "mise"
state_dir = Path(os.environ.get("MISE_STATE_DIR", str(home / ".local" / "state" / "mise")))
resolved_mise_dir = mise_dir.resolve(strict=False)
ts_tag = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())


def _load_ignored_prefixes() -> tuple[Path, ...]:
    miserc = mise_dir / "miserc.toml"
    if not miserc.is_file():
        return ()
    try:
        data = tomllib.loads(miserc.read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError:
        return ()
    raw = data.get("ignored_config_paths")
    if not isinstance(raw, list):
        return ()
    out: list[Path] = []
    for entry in raw:
        if isinstance(entry, str) and entry.strip():
            out.append(Path(entry).expanduser().resolve(strict=False))
    return tuple(out)


def _is_ignored(path: Path, ignored_prefixes: tuple[Path, ...]) -> bool:
    resolved = path.resolve(strict=False)
    return any(resolved == prefix or prefix in resolved.parents for prefix in ignored_prefixes)


def _collect_tools_from_toml(cfg_path: Path, used_tools: set[str], declared_wrappers: set[str] | None = None) -> None:
    if not cfg_path.is_file():
        return
    try:
        data = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError):
        return
    if declared_wrappers is not None:
        wrappers = data.get("wrappers")
        if isinstance(wrappers, dict):
            declared_wrappers.update(str(k) for k in wrappers.keys())
    tools = data.get("tools")
    if isinstance(tools, dict):
        for tool_name in tools.keys():
            used_tools.add(str(tool_name))


def load_declared_wrappers_and_plugins() -> tuple[set[str], set[str]]:
    declared_wrappers: set[str] = set()
    used_tools: set[str] = set()
    for cfg_name in (
        "config.toml",
        "config.macos.toml",
        "config.linux.toml",
        "config.vm.toml",
        "config.container.toml",
    ):
        _collect_tools_from_toml(mise_dir / cfg_name, used_tools, declared_wrappers)
    conf_d = mise_dir / "conf.d"
    if conf_d.is_dir():
        for fragment in sorted(conf_d.rglob("*.toml")):
            _collect_tools_from_toml(fragment, used_tools, declared_wrappers)

    ignored_prefixes = _load_ignored_prefixes()
    tracked_dir = state_dir / "tracked-configs"
    if tracked_dir.is_dir():
        for link in sorted(tracked_dir.iterdir()):
            try:
                target = link.resolve(strict=True)
            except OSError:
                continue
            if not target.is_file() or _is_ignored(target, ignored_prefixes):
                continue
            _collect_tools_from_toml(target, used_tools)
    return declared_wrappers, used_tools


declared_wrappers, used_tools = load_declared_wrappers_and_plugins()

# 2. Orphaned command-wrappers/bin/*
if wrappers_dir.is_dir():
    for entry in sorted(wrappers_dir.iterdir()):
        if entry.name in declared_wrappers:
            continue
        if apply:
            entry.unlink()
            print(f"REMOVED orphan wrapper: {entry}")
        else:
            print(f"WOULD REMOVE orphan wrapper: {entry}")

# 3. Stale unconfigured mise plugins + orphaned plugin dirs
configured_plugin_tokens: set[str] = set()
for tool in used_tools:
    configured_plugin_tokens.add(tool)
    if ":" in tool:
        backend, rest = tool.split(":", 1)
        configured_plugin_tokens.add(rest.replace("/", "-"))
        configured_plugin_tokens.add(f"{backend}-{rest}".replace("/", "-"))
        configured_plugin_tokens.add(rest.split("/")[-1])

try:
    registered_plugins = [
        line.strip()
        for line in subprocess.check_output(
            ["mise", "-C", str(home), "plugins", "ls"],
            text=True,
        ).splitlines()
        if line.strip()
    ]
except (OSError, subprocess.SubprocessError):
    registered_plugins = []

for plugin in registered_plugins:
    if plugin in configured_plugin_tokens:
        continue
    if apply:
        subprocess.run(["mise", "-C", str(home), "plugins", "uninstall", plugin], check=False)
        print(f"UNINSTALLED stale mise plugin: {plugin}")
    else:
        print(f"WOULD UNINSTALL stale mise plugin: {plugin}")

if plugins_dir.is_dir():
    for pdir in sorted(plugins_dir.iterdir()):
        if pdir.name in configured_plugin_tokens:
            continue
        if apply:
            if pdir.is_symlink() or pdir.is_file():
                pdir.unlink()
            else:
                shutil.rmtree(pdir)
            print(f"REMOVED orphan plugin dir: {pdir}")
        else:
            print(f"WOULD REMOVE orphan plugin dir: {pdir}")

# 3b. Unused mismatched-backend tools flagged by `mise doctor --json` (e.g. legacy vfox:jdx/vfox-1password)
_MISMATCH_WARN_RE = re.compile(
    r"tool '([^']+)' installed with explicit backend '([^']+)'\s+differs from registry recommendation"
)
try:
    doc_proc = subprocess.run(
        ["mise", "-C", str(home), "doctor", "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    doc_data = json.loads(doc_proc.stdout) if doc_proc.stdout.strip() else {}
except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
    doc_data = {}

doc_warnings = doc_data.get("warnings") if isinstance(doc_data, dict) else []
uninstalled_mismatch = False
if isinstance(doc_warnings, list):
    seen_mismatch: set[str] = set()
    for warning in doc_warnings:
        if not isinstance(warning, str):
            continue
        m = _MISMATCH_WARN_RE.search(warning)
        if not m:
            continue
        tool_name, backend = m.group(1), m.group(2)
        if tool_name in seen_mismatch or not tool_name or tool_name.startswith("-"):
            continue
        seen_mismatch.add(tool_name)
        if tool_name in used_tools or backend in used_tools:
            continue
        try:
            ls_rows = json.loads(
                subprocess.check_output(["mise", "-C", str(home), "ls", "--json", tool_name], text=True)
            )
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            continue
        if not isinstance(ls_rows, list) or not ls_rows:
            continue
        if any(isinstance(r, dict) and r.get("active") is True for r in ls_rows):
            continue
        if apply:
            res = subprocess.run(
                ["mise", "-C", str(home), "uninstall", "--all", "--yes", tool_name],
                check=False,
            )
            if res.returncode == 0:
                uninstalled_mismatch = True
                print(f"UNINSTALLED unused mismatched-backend tool: {tool_name} ({backend})")
        else:
            print(f"WOULD UNINSTALL unused mismatched-backend tool: {tool_name} ({backend})")

if apply and uninstalled_mismatch:
    subprocess.run(["mise", "-C", str(home), "reshim", "--force"], check=False)

# 3c. Inactive orphaned <tool>-<8-char> mise staging/install dirs
orphaned_staging_dirs, staging_errs = find_orphaned_mise_staging_dirs(installs_dir, home)
if staging_errs:
    for staging_err in staging_errs:
        print(f"SKIP  staging-dir prune: {staging_err}")
else:
    for staging_dir in orphaned_staging_dirs:
        if apply:
            shutil.rmtree(staging_dir)
            print(f"REMOVED orphaned staging dir: {staging_dir}")
        else:
            print(f"WOULD REMOVE orphaned staging dir: {staging_dir}")

# 4. Retired stopped pitchfork entries
if shutil.which("pitchfork"):
    try:
        pf_list = json.loads(
            subprocess.check_output(["pitchfork", "list", "--json"], text=True)
        )
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pf_list = []
    if isinstance(pf_list, list):
        for row in pf_list:
            if not isinstance(row, dict):
                continue
            daemon_id = str(row.get("id") or "")
            ns = str(row.get("namespace") or "")
            name = str(row.get("name") or "")
            status = str(row.get("status") or "")
            is_retired = daemon_id in {"dotfiles-v2/vercel-board", "legacy/pitchfork"} or ns.startswith("test.results.")
            if status == "stopped" and is_retired and ns and name:
                if apply:
                    subprocess.run(["pitchfork", "clean", "--daemon", daemon_id], check=False)
                    print(f"CLEANED retired stopped pitchfork entry: {daemon_id}")
                else:
                    print(f"WOULD CLEAN retired stopped pitchfork entry: {daemon_id}")

# 5. Stale standalone binaries in ~/.local/bin/{uv,uvx,hermes,hermes-acp,hermes-agent}
local_bin = home / ".local" / "bin"
for tool_bin in ("uv", "uvx"):
    candidate = local_bin / tool_bin
    if not (candidate.exists() or candidate.is_symlink()):
        continue
    try:
        managed_bin = subprocess.check_output(
            ["mise", "-C", str(home), "which", tool_bin],
            text=True,
        ).strip()
    except (OSError, subprocess.SubprocessError):
        managed_bin = ""
    if managed_bin and Path(managed_bin).is_file() and Path(managed_bin).resolve() != candidate.resolve(strict=False):
        if apply:
            candidate.unlink()
            print(f"REMOVED stale standalone binary: {candidate} (managed: {managed_bin})")
        else:
            print(f"WOULD REMOVE stale standalone binary: {candidate} (managed: {managed_bin})")

managed_hermes = home / ".local" / "share" / "hermes-cli.noindex" / "bin" / "hermes"
legacy_hermes_marker = "/.hermes/hermes-agent/"
if managed_hermes.is_file():
    for hermes_bin in ("hermes", "hermes-acp", "hermes-agent"):
        candidate = local_bin / hermes_bin
        if not (candidate.exists() or candidate.is_symlink()):
            continue
        is_legacy_hermes = False
        if candidate.is_symlink():
            raw_link = os.readlink(candidate)
            resolved_link = str(candidate.resolve(strict=False))
            is_legacy_hermes = legacy_hermes_marker in raw_link or legacy_hermes_marker in resolved_link
        elif candidate.is_file() and candidate.stat().st_size <= 4096:
            try:
                is_legacy_hermes = legacy_hermes_marker in candidate.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                is_legacy_hermes = False
        if not is_legacy_hermes:
            continue
        if apply:
            candidate.unlink()
            print(f"REMOVED stale legacy hermes shim: {candidate} (managed: {managed_hermes})")
        else:
            print(f"WOULD REMOVE stale legacy hermes shim: {candidate} (managed: {managed_hermes})")

# 6. Dead symlinks in ~/.config/opencode/skills/ and ~/.claude/debug/latest
dead_candidates: list[Path] = []
oc_skills = home / ".config" / "opencode" / "skills"
if oc_skills.is_dir():
    for entry in sorted(oc_skills.iterdir()):
        if entry.is_symlink() and not entry.exists():
            dead_candidates.append(entry)
claude_debug_latest = home / ".claude" / "debug" / "latest"
if claude_debug_latest.is_symlink() and not claude_debug_latest.exists():
    dead_candidates.append(claude_debug_latest)

for dead in dead_candidates:
    if apply:
        dead.unlink()
        print(f"REMOVED dead symlink: {dead}")
    else:
        print(f"WOULD REMOVE dead symlink: {dead}")

# 7. Unmanaged ~/.config/opencode/opencode.jsonc (backup before removing; never overwrite existing backup)
oc_dir = home / ".config" / "opencode"
oc_json = oc_dir / "opencode.json"
oc_jsonc = oc_dir / "opencode.jsonc"
if oc_jsonc.is_file() and not oc_jsonc.is_symlink() and oc_json.exists():
    oc_bak = oc_dir / "opencode.jsonc.bak.pre-cleanup"
    if oc_bak.exists():
        mtime_tag = int(oc_jsonc.stat().st_mtime)
        oc_bak = oc_dir / f"opencode.jsonc.bak.{mtime_tag}"
        if oc_bak.exists():
            oc_bak = oc_dir / f"opencode.jsonc.bak.{mtime_tag}.{ts_tag}"
    if apply:
        shutil.copy2(oc_jsonc, oc_bak)
        oc_jsonc.unlink()
        print(f"BACKED UP & REMOVED unmanaged {oc_jsonc} -> {oc_bak}")
    else:
        print(f"WOULD BACK UP & REMOVE unmanaged {oc_jsonc} -> {oc_bak}")

# 8. Untracked unix/home/.config/mise/config.local.toml (only if inside git worktree, untracked, migrated-env-only, and fnox strict passes)
config_local = resolved_mise_dir / "config.local.toml"
if config_local.is_file():
    in_worktree = (
        subprocess.run(
            ["git", "-C", str(resolved_mise_dir), "rev-parse", "--is-inside-work-tree"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        == 0
    )
    is_tracked = (
        in_worktree
        and subprocess.run(
            ["git", "-C", str(resolved_mise_dir), "ls-files", "--error-unmatch", "config.local.toml"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        == 0
    )
    only_migrated_env = False
    try:
        local_data = tomllib.loads(config_local.read_text(encoding="utf-8"))
        local_env = local_data.get("env")
        only_migrated_env = (
            set(local_data.keys()) <= {"env"}
            and isinstance(local_env, dict)
            and set(local_env.keys()) <= {"CLOUDFLARE_ACCOUNT_ID", "CF_ACCOUNT_ID"}
        )
    except (OSError, tomllib.TOMLDecodeError):
        only_migrated_env = False

    has_cf_id = False
    if fnox_cfg.is_file():
        try:
            fnox_data = tomllib.loads(fnox_cfg.read_text(encoding="utf-8"))
            secrets = fnox_data.get("secrets")
            has_cf_id = isinstance(secrets, dict) and "CLOUDFLARE_ACCOUNT_ID" in secrets
        except tomllib.TOMLDecodeError:
            has_cf_id = False
    fnox_ok = False
    if has_cf_id and fnox_cfg.is_file():
        fnox_ok = (
            subprocess.run(
                ["fnox", "--non-interactive", "--config", str(fnox_cfg), "check", "--all", "--strict"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            ).returncode
            == 0
        )
    backup_dir = home / ".local" / "state" / "dotfiles-v2"
    backup_path = backup_dir / f"config.local.toml.bak.{ts_tag}"
    if in_worktree and not is_tracked and only_migrated_env and has_cf_id and fnox_ok:
        if apply:
            backup_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(config_local, backup_path)
            os.chmod(backup_path, 0o600)
            config_local.unlink()
            print(f"BACKED UP & REMOVED untracked {config_local} -> {backup_path}")
        else:
            print(f"WOULD BACK UP & REMOVE untracked {config_local} -> {backup_path}")
    elif in_worktree and not is_tracked:
        print(f"SKIP  {config_local}: migrated-env-only={only_migrated_env}, has_cf_id={has_cf_id}, fnox_ok={fnox_ok}")
PY
