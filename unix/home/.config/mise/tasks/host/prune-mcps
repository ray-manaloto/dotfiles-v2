#!/usr/bin/env bash
#MISE description="Audit or prune legacy global MCP server entries across ~/.gemini, ~/.claude.json, and ~/.codex (preserving repo-local openwiki)"
#USAGE flag "--check" help="Report legacy global MCP entries without modifying files (default)"
#USAGE flag "--apply" help="Back up and remove legacy global MCP entries cleanly"
set -euo pipefail

apply="${usage_apply:-false}"
if [[ ${usage_check:-false} == "true" ]]; then
	apply="false"
fi

py_bin=""
if command -v python3 >/dev/null 2>&1; then
	py_bin="$(command -v python3)"
elif [[ -x /usr/bin/python3 ]]; then
	py_bin="/usr/bin/python3"
fi

if [[ -z ${py_bin} ]]; then
	echo "host:prune-mcps: python3 unavailable" >&2
	exit 1
fi

exec "${py_bin}" -I -B - "${apply}" <<'PY'
import json
import os
import re
import shutil
import sys
import time
from pathlib import Path

apply = sys.argv[1] == "true"
home = Path.home()
ts_tag = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
backup_dir = home / ".local" / "state" / "dotfiles-v2" / "backups"

LEGACY_MCP_NAMES = frozenset({
    "mcp-jdx",
    "mise",
    "hk",
    "pitchfork",
    "usage-mise",
    "firecrawl",
    "exa",
    "exa-web",
    "context7",
    "apify",
    "agentsview",
    "codebase-memory-mcp",
    "graphify",
    "clion",
})

LEGACY_AGY_PLUGINS = frozenset({
    "apify",
    "context7",
    "exa-web",
    "firecrawl",
    "chrome-devtools-plugin",
})

LEGACY_CODEX_PLUGINS = (
    "context7@context7-marketplace",
    "apify@apify",
    "apify@apify-plugins",
    "firecrawl@firecrawl",
)


def _backup(path: Path) -> Path:
    backup_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(backup_dir, 0o700)
    dst = backup_dir / f"{path.name}.{ts_tag}.bak"
    idx = 1
    while dst.exists():
        dst = backup_dir / f"{path.name}.{ts_tag}.{idx}.bak"
        idx += 1
    shutil.copy2(path, dst)
    os.chmod(dst, 0o600)
    return dst


found: list[str] = []


def _prune_json_dict_keys(path: Path, container_keys: tuple[str, ...], names: frozenset[str], label: str) -> None:
    if not path.is_file():
        return
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    if not isinstance(data, dict):
        return
    changed = False
    for ckey in container_keys:
        sub = data.get(ckey)
        if not isinstance(sub, dict):
            continue
        for k in sorted(list(sub.keys())):
            if k in names or (ckey == "enabledPlugins" and any(k == p or k.startswith(f"{p}@") for p in LEGACY_AGY_PLUGINS)):
                found.append(f"{label} {path}: {ckey}.{k}")
                if apply:
                    del sub[k]
                    changed = True
    if apply and changed:
        bak = _backup(path)
        path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        os.chmod(path, 0o600)
        print(f"PRUNED {label} ({path}, backup={bak})")


_prune_json_dict_keys(home / ".gemini" / "config" / "mcp_config.json", ("mcpServers",), LEGACY_MCP_NAMES, "gemini-mcp")
_prune_json_dict_keys(home / ".gemini" / "config" / "config.json", ("plugins", "enabledPlugins"), LEGACY_AGY_PLUGINS, "gemini-plugin")

claude_candidates = [home / ".claude.json"]
claude_cfg_dir = os.environ.get("CLAUDE_CONFIG_DIR", "").strip()
if claude_cfg_dir:
    claude_candidates.append(Path(claude_cfg_dir).expanduser() / ".claude.json")
claude_candidates.append(home / ".claude" / ".claude.json")

seen_claude_paths: set[Path] = set()
for claude_path in claude_candidates:
    resolved_claude = claude_path.resolve(strict=False)
    if resolved_claude in seen_claude_paths:
        continue
    seen_claude_paths.add(resolved_claude)
    _prune_json_dict_keys(claude_path, ("mcpServers",), LEGACY_MCP_NAMES, "claude-mcp")

codex_cfg = home / ".codex" / "config.toml"
if codex_cfg.is_file():
    raw_lines = codex_cfg.read_text(encoding="utf-8").splitlines(keepends=True)
    kept_lines: list[str] = []
    skip_section = False
    codex_changed = False
    sec_re = re.compile(r'^\s*\[\[?([^\]]+?)\]\]?\s*(?:#.*)?$')
    for line in raw_lines:
        m = sec_re.match(line)
        if m:
            sec_name = m.group(1).strip()
            skip_section = False
            for srv in LEGACY_MCP_NAMES:
                if sec_name in {f"mcp_servers.{srv}", f'mcp_servers."{srv}"'} or sec_name.startswith((f"mcp_servers.{srv}.", f'mcp_servers."{srv}".')):
                    skip_section = True
                    found.append(f"codex-mcp {codex_cfg}: [{sec_name}]")
                    codex_changed = True
                    break
            if not skip_section:
                for plug in LEGACY_CODEX_PLUGINS:
                    if sec_name in {f'plugins."{plug}"', f"plugins.{plug}"}:
                        skip_section = True
                        found.append(f"codex-plugin {codex_cfg}: [{sec_name}]")
                        codex_changed = True
                        break
        if not skip_section:
            kept_lines.append(line)
    if apply and codex_changed:
        bak = _backup(codex_cfg)
        codex_cfg.write_text("".join(kept_lines), encoding="utf-8")
        os.chmod(codex_cfg, 0o600)
        print(f"PRUNED codex legacy MCP/plugin sections ({codex_cfg}, backup={bak})")

if not found:
    print("OK  host:prune-mcps: zero legacy global MCP entries found")
elif not apply:
    for item in found:
        print(f"FOUND {item}")
    print(f"host:prune-mcps: {len(found)} legacy global MCP entry(ies) found (pass --apply to remove)")
PY
