#!/usr/bin/env bash
#MISE description="Safely stop targeted Herdr sessions to bare shells for shutdown/reboot (dry-run unless --apply)"
#USAGE flag "--tabs <tabs>" help="Comma-separated tab names, space/tab selectors, or terminal IDs"
#USAGE flag "--spaces <spaces>" help="Comma-separated space names"
#USAGE flag "--harnesses <harnesses>" help="Comma-separated harnesses (agy,codex,claude,opencode,hermes,zcode)"
#USAGE flag "--all" help="Target all non-excluded live agent tabs"
#USAGE flag "--exclude <exclude>" help="Comma-separated spaces, tabs, or terminal IDs to leave untouched"
#USAGE flag "--wait <seconds>" help="Handshake response timeout in seconds" default="180"
#USAGE flag "--settle <seconds>" help="Exit timeout in seconds" default="45"
#USAGE flag "--handshake" help="Send opt-in READY-TO-RESTART handshake before exit"
#USAGE flag "--apply" help="Execute stops (default: read-only dry-run plan)"
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
lib_dir="$(cd "${script_dir}/../../lib" && pwd -P)"
repo_root="$(cd "${lib_dir}/../../../.." && pwd -P)"
venv_py="${repo_root}/.venv/bin/python"

args=(stop --wait "${usage_wait:-180}" --settle "${usage_settle:-45}")
[[ -n ${usage_tabs:-} ]] && args+=(--tabs "${usage_tabs}")
[[ -n ${usage_spaces:-} ]] && args+=(--spaces "${usage_spaces}")
[[ -n ${usage_harnesses:-} ]] && args+=(--harnesses "${usage_harnesses}")
[[ ${usage_all:-false} == "true" ]] && args+=(--all)
[[ -n ${usage_exclude:-} ]] && args+=(--exclude "${usage_exclude}")
[[ ${usage_handshake:-false} == "true" ]] && args+=(--handshake)
[[ ${usage_apply:-false} == "true" ]] && args+=(--apply)

if [[ -x ${venv_py} ]]; then
	exec "${venv_py}" -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from herdr_roll.cli import main; raise SystemExit(main(sys.argv[2:]))' "${lib_dir}" "${args[@]}"
fi
exec uv run --project "${repo_root}" --offline --locked python -I -B -c 'import sys; sys.path.insert(0, sys.argv[1]); from herdr_roll.cli import main; raise SystemExit(main(sys.argv[2:]))' "${lib_dir}" "${args[@]}"
