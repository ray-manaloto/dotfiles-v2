#!/bin/sh
# NZXT H1 AIO pump is on nct6798 fan2/pwm2 (identified 2026-11-09: 3,426 RPM at 70%, 4,166 RPM at 100%).
# NZXT says the pump should run at full speed; the BIOS curve had it at ~70%. Pin it to 100%.
set -e
for h in /sys/class/hwmon/hwmon*; do [ "$(cat $h/name)" = nct6798 ] && H=$h; done
[ -n "$H" ] || { echo "nct6798 not found" >&2; exit 1; }
echo 1 > $H/pwm2_enable
echo 255 > $H/pwm2
echo "pump pinned: $H/pwm2=$(cat $H/pwm2) fan2=$(cat $H/fan2_input) RPM"
