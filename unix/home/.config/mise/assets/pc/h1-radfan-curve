#!/bin/sh
# NZXT H1 radiator fan (Aer P 140) is on nct6798 fan5/pwm5 (identified 2026-11-09). The BIOS left it at a flat
# 100% curve (~1,770 RPM even at idle). Writing a curve into the chip's own SmartFan IV registers did not take
# (pwm5 stayed 255 for every temperature source, 2026-11-09 23:55), but manual control works (50% -> ~1,080 RPM).
# So this small daemon runs the curve: it reads CPU Tctl (k10temp), averages the last few readings so Zen's short
# spikes don't rev the fan, interpolates the curve and writes pwm5. On stop or failure it puts the fan back to
# 100% (`h1-radfan-curve full`, also run by the service's ExecStopPost), so a dead daemon fails loud, not hot.
# Installed at /usr/local/sbin/h1-radfan-curve; source of truth: windows-desktop/omarchy/h1-radfan-curve.
# Tuning (env, set in the service): CURVE="tempC:percent ..." rising, INTERVAL seconds, SAMPLES to average.
CURVE="${CURVE:-50:40 70:70 80:100}"
INTERVAL="${INTERVAL:-2}"
SAMPLES="${SAMPLES:-5}"

find_hwmon() { for h in /sys/class/hwmon/hwmon*; do [ "$(cat "$h/name")" = "$1" ] && { echo "$h"; return; }; done; return 1; }
N=$(find_hwmon nct6798) || { echo "nct6798 not found" >&2; exit 1; }
K=$(find_hwmon k10temp) || { echo "k10temp not found" >&2; exit 1; }
P=$N/pwm5

full() { echo 1 > "${P}_enable" 2>/dev/null; echo 255 > "$P"; }
[ "${1:-}" = full ] && { full; echo "radiator fan back to 100%"; exit 0; }

# percent for a temperature (milli-C), linear between curve points, clamped at both ends
duty() {
  echo "$CURVE" | awk -v t="$1" '{
    n = split($0, pts, " ")
    for (i = 1; i <= n; i++) { split(pts[i], a, ":"); T[i] = a[1] * 1000; D[i] = a[2] }
    if (t <= T[1]) { print D[1]; exit }
    if (t >= T[n]) { print D[n]; exit }
    for (i = 1; i < n; i++) if (t < T[i+1]) { printf "%d\n", D[i] + (D[i+1] - D[i]) * (t - T[i]) / (T[i+1] - T[i]); exit }
  }'
}

trap 'full; exit 0' INT TERM
echo 1 > "${P}_enable"
hist=""; last=""
echo "radiator curve: $CURVE (Tctl avg of $SAMPLES x ${INTERVAL}s)"
while :; do
  t=$(cat "$K/temp1_input") || { full; exit 1; }
  hist=$(echo "$hist $t" | awk -v n="$SAMPLES" '{ s = ""; for (i = (NF > n ? NF - n + 1 : 1); i <= NF; i++) s = s " " $i; print s }')
  avg=$(echo "$hist" | awk '{ s = 0; for (i = 1; i <= NF; i++) s += $i; printf "%d\n", s / NF }')
  pwm=$(( $(duty "$avg") * 255 / 100 ))
  if [ "$pwm" != "$last" ]; then echo "$pwm" > "$P" || { full; exit 1; }; last=$pwm; fi
  sleep "$INTERVAL"
done
