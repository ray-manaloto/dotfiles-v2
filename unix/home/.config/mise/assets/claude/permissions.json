{
  "deniedMcpServers": [
    {
      "serverCommand": ["npx", "-y", "@modelcontextprotocol/server-pdf", "--stdio"]
    },
    {
      "serverUrl": "https://mcp.apify.com/*"
    }
  ],
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Bash(hc read *)",
      "Bash(hc ls *)",
      "Bash(hc get *)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "Bash(env -u GH_TOKEN git -c credential.https://github.com.helper= -c credential.https://github.com.helper='!mise run -q agent:token' push -u origin *)"
    ],
    "ask": [
      "Bash(claude plugin install *)",
      "Bash(claude plugin i *)",
      "Bash(claude plugin uninstall *)",
      "Bash(claude plugin remove *)",
      "Bash(claude plugin update *)",
      "Bash(claude plugin enable *)",
      "Bash(claude plugin disable *)",
      "Bash(claude plugins install *)",
      "Bash(claude plugins uninstall *)",
      "Bash(claude plugins update *)",
      "Bash(claude plugins enable *)",
      "Bash(claude plugins disable *)",
      "Bash(claude plugin marketplace *)",
      "Bash(claude plugins marketplace *)",
      "Bash(claude mcp add *)",
      "Bash(gh pr merge *)",
      "Bash(gh api * -X *)",
      "Edit(~/.claude/plugins/**)"
    ],
    "defaultMode": "auto",
    "deny": [
      "mcp__clion__*",
      "Read(~/.config/agentsview/server-token)",
      "Read(~/.config/fnox/**/*.age)",
      "Read(~/.config/fnox/age.txt)",
      "Bash(fnox exec *)",
      "Bash(fnox get *)",
      "Bash(fnox export *)",
      "Bash(fnox list --values*)",
      "Bash(doppler secrets get *)",
      "Bash(doppler secrets download *)",
      "Bash(doppler run *)"
    ]
  }
}
