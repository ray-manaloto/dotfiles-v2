{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>ray-manaloto/renovate-config#v1.1.0"],
  customManagers: [
    {
      customType: "regex",
      description: "Updates MISE_VER in Tart VM and pc provisioning tasks",
      managerFilePatterns: ["/^tasks\\/(?:vm|pc)\\/up$/"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v(?<version>.+)$",
      matchStrings: ['MISE_VER="(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"'],
    },
    {
      customType: "regex",
      description: "Updates PACKSLIP_VER and PACKSLIP_SHA256_MACOS_ARM64 in Tart VM provisioning task",
      managerFilePatterns: ["/^tasks\\/vm\\/up$/"],
      datasourceTemplate: "github-release-attachments",
      depNameTemplate: "packslip",
      packageNameTemplate: "jdx/packslip",
      matchStrings: [
        'PACKSLIP_VER="(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"\\nPACKSLIP_SHA256_MACOS_ARM64="(?<currentDigest>[a-f0-9]{64})"',
      ],
    },
    {
      customType: "regex",
      description: "Updates PACKSLIP_VER and PACKSLIP_SHA256_LINUX_X64 in pc provisioning task",
      managerFilePatterns: ["/^tasks\\/pc\\/up$/"],
      datasourceTemplate: "github-release-attachments",
      depNameTemplate: "packslip",
      packageNameTemplate: "jdx/packslip",
      matchStrings: [
        'PACKSLIP_VER="(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"\\nPACKSLIP_SHA256_LINUX_X64="(?<currentDigest>[a-f0-9]{64})"',
      ],
    },
    {
      customType: "regex",
      description: "Updates the mise version pinned in jdx/mise-action steps",
      managerFilePatterns: ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v(?<version>.+)$",
      matchStrings: [
        "uses: jdx/mise-action@[^\\n]+\\n\\s+with:\\n\\s+version: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)",
      ],
    },
    {
      customType: "regex",
      description: "Updates mise min_version pins checked by mise-version-parity",
      managerFilePatterns: [
        "/^mise\\.toml$/",
        "/^unix\\/home\\/\\.config\\/mise\\/config\\.toml$/",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v(?<version>.+)$",
      matchStrings: ['min_version = "(?<currentValue>[0-9]{4}\\.[0-9]+\\.[0-9]+)"'],
    },
    {
      customType: "regex",
      description: "Updates the mise version floor in env:doctor (every quoted YYYY.N.N there is the mise floor)",
      managerFilePatterns: ["/^tasks\\/env\\/doctor$/"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v(?<version>.+)$",
      matchStrings: ['"(?<currentValue>[0-9]{4}\\.[0-9]+\\.[0-9]+)"'],
    },
    {
      customType: "regex",
      description: "Updates prose `mise YYYY.N.N` mentions in AGENTS.md (the image reference has its own manager below)",
      managerFilePatterns: ["/^AGENTS\\.md$/"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v(?<version>.+)$",
      matchStrings: ["mise (?<currentValue>[0-9]{4}\\.[0-9]+\\.[0-9]+)"],
    },
    {
      customType: "regex",
      description: "Updates the digest-pinned ghcr.io/jdx/mise image reference in AGENTS.md (version and digest together)",
      managerFilePatterns: ["/^AGENTS\\.md$/"],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/jdx/mise",
      matchStrings: [
        "ghcr\\.io/jdx/mise:(?<currentValue>[0-9]{4}\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
    },
  ],
  packageRules: [
    {
      description: "Group every mise pin that mise-version-parity checks (Dockerfile, CI, vm:up, pc:up, min_version, env:doctor, AGENTS.md) into one PR",
      matchPackageNames: ["jdx/mise", "ghcr.io/jdx/mise"],
      groupName: "mise",
      prBodyNotes: [
        "Before merging: confirm `PACKSLIP_MISE_PIN` in `tasks/vm/up` and `tasks/pc/up` is still valid for the new mise release (Renovate cannot update it), then run `mise doctor project`.",
      ],
    },
  ],
}
