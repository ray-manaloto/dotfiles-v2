{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>ray-manaloto/renovate-config#v1.1.0"],
  customManagers: [
    {
      customType: "regex",
      description: "Updates MISE_VER in Dockerfiles and Tart VM provisioning task",
      managerFilePatterns: ["/^docker\\/.*Dockerfile$/", "/^tasks\\/vm\\/up$/"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v(?<version>.+)$",
      matchStrings: ['(?:ARG )?MISE_VER="?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"?'],
    },
  ],
}
